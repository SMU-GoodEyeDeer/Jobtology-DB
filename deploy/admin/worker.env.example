# Host service configuration only. Keep this outside Git at mode 0600.
# Existing Hop runtime credentials and provider routing remain in their protected files.
JOBTOLOGY_ADMIN_REPO_ROOT=/srv/Jobtology-DB
JOBTOLOGY_ADMIN_QUEUE_PATH=/var/lib/jobtology-admin/queue.sqlite3
JOBTOLOGY_ADMIN_ACTIONS_FILE=/etc/jobtology-admin/actions.json
# Host-only protected output logs; never include this directory in a web mount.
JOBTOLOGY_ADMIN_WORKER_LOG_DIR=/srv/jobtology-private/admin-operation-logs
