# Coolify runtime secrets; these are a separate dashboard login.
JOBTOLOGY_ADMIN_USERNAME=operator
JOBTOLOGY_ADMIN_PASSWORD=replace-with-a-unique-password-at-least-8-characters
JOBTOLOGY_ADMIN_SECRET=replace-with-an-independent-random-secret-at-least-32-characters
JOBTOLOGY_ADMIN_MODE=live
JOBTOLOGY_ADMIN_COOKIE_SECURE=true
JOBTOLOGY_ADMIN_ALLOWED_ORIGINS=https://jobtology-admin.yeongmin.net
JOBTOLOGY_ADMIN_SESSION_SECONDS=28800

# Replace service names/passwords with private-network, read-only credentials.
# Store actual values in Coolify; never commit them.
JOBTOLOGY_ADMIN_POSTGRES_DSN=postgresql://jobtology_admin_reader:REPLACE@postgres-private:5432/jobtology
JOBTOLOGY_ADMIN_NEO4J_URI=bolt://neo4j-private:7687
JOBTOLOGY_ADMIN_NEO4J_USER=jobtology_admin_reader
JOBTOLOGY_ADMIN_NEO4J_PASSWORD=REPLACE
JOBTOLOGY_ADMIN_NEO4J_DATABASE=neo4j
JOBTOLOGY_ADMIN_QUERY_TIMEOUT_SECONDS=4
JOBTOLOGY_ADMIN_CACHE_SECONDS=30

JOBTOLOGY_ADMIN_QUEUE_PATH=/var/lib/jobtology-admin/queue.sqlite3
# Mount only the approved profiles read-only; no runtime.env or dataset mount in web.
# JOBTOLOGY_ADMIN_ACTIONS_FILE=/etc/jobtology-admin/actions.json
JOBTOLOGY_ADMIN_CONTROLS_ENABLED=false
JOBTOLOGY_ADMIN_WORKER_STALE_SECONDS=45
PORT=8000
