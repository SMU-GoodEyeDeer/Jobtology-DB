@prefix jt: <urn:jobtology:vocab:1:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Transport/evidence structure only. Passing this file is not publication approval.
jt:NativeNodeShape a sh:NodeShape ;
  sh:targetSubjectsOf jt:nativeNodeId ; sh:nodeKind sh:IRI ;
  sh:property [ sh:path jt:nativeNodeId ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ] ;
  sh:property [ sh:path jt:nativeLabel ; sh:minCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ] ;
  sh:property [ sh:path jt:nativeContentHash ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:pattern "^[0-9a-f]{64}$" ] ;
  sh:sparql [ sh:message "Native node IRI must hash its exact native identifier." ;
    sh:select """PREFIX jt: <urn:jobtology:vocab:1:>
      SELECT $this WHERE { $this jt:nativeNodeId ?id .
        FILTER (STR($this) != CONCAT("urn:jobtology:node:", SHA256(STR(?id)))) }""" ] .

jt:RelationShape a sh:NodeShape ; sh:targetClass jt:Relation ; sh:nodeKind sh:IRI ;
  sh:property [ sh:path jt:nativeEdgeId ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:pattern "^[0-9a-f]{64}$" ] ;
  sh:property [ sh:path jt:nativeContentHash ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:pattern "^[0-9a-f]{64}$" ] ;
  sh:property [ sh:path jt:nativePredicate ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:pattern "^[A-Z][A-Z_]*$" ] ;
  sh:property [ sh:path jt:nativeSubjectId ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path jt:nativeObjectId ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path rdf:subject ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
  sh:property [ sh:path rdf:predicate ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
  sh:property [ sh:path rdf:object ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
  sh:sparql [ sh:message "A reified relation must have matching in-graph endpoints and a direct triple." ;
    sh:select """PREFIX jt: <urn:jobtology:vocab:1:>
      PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
      SELECT $this WHERE { $this rdf:subject ?s ; rdf:predicate ?p ; rdf:object ?o ;
        jt:nativeSubjectId ?sid ; jt:nativeObjectId ?oid ; jt:nativeEdgeId ?eid .
        FILTER (STR($this) != CONCAT("urn:jobtology:edge:",STR(?eid)) ||
          NOT EXISTS { ?s jt:nativeNodeId ?sid } || NOT EXISTS { ?o jt:nativeNodeId ?oid } ||
          NOT EXISTS { ?s ?p ?o }) }""" ] .

jt:EntityShape a sh:NodeShape ; sh:targetClass jt:Entity ;
  sh:property [ sh:path jt:entityId ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ] ;
  sh:property [ sh:path jt:hasRevision ; sh:minCount 1 ; sh:maxCount 1 ; sh:class jt:EntityRevision ] ;
  sh:sparql [ sh:message "A selected revision must belong to its identity shell." ;
    sh:select """PREFIX jt: <urn:jobtology:vocab:1:>
      SELECT $this WHERE { $this jt:entityId ?id ; jt:hasRevision ?revision .
        FILTER NOT EXISTS { ?revision jt:entityId ?id } }""" ] .

jt:RevisionShape a sh:NodeShape ; sh:targetClass jt:EntityRevision ;
  sh:property [ sh:path jt:revisionId ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:pattern "^[0-9a-f]{64}$" ] ;
  sh:property [ sh:path jt:entityId ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ] ;
  sh:property [ sh:path jt:payloadHash ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:pattern "^[0-9a-f]{64}$" ] .

jt:SourceRecordShape a sh:NodeShape ; sh:targetClass jt:SourceRecordEvidence ;
  sh:property [ sh:path jt:sourceId ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ] ;
  sh:property [ sh:path jt:sourceRecordId ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ] ;
  sh:property [ sh:path jt:rawSha256 ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:pattern "^[0-9a-f]{64}$" ] ;
  sh:property [ sh:path jt:normalizedHash ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:pattern "^[0-9a-f]{64}$" ] ;
  sh:property [ sh:path jt:locator ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ] .

jt:EvidenceShape a sh:NodeShape ; sh:targetClass jt:EvidenceSpan ;
  sh:property [ sh:path jt:evidenceId ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ] ;
  sh:property [ sh:path jt:excerpt ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ] ;
  sh:property [ sh:path jt:excerptSha256 ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:pattern "^[0-9a-f]{64}$" ] ;
  sh:property [ sh:path jt:startOffset ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 0 ; sh:lessThan jt:endOffset ] ;
  sh:property [ sh:path jt:endOffset ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 1 ] ;
  sh:property [ sh:path jt:offsetUnit ; sh:minCount 1 ; sh:maxCount 1 ; sh:hasValue "UNICODE_CODE_POINT" ] ;
  sh:property [ sh:path jt:inArtifact ; sh:minCount 1 ; sh:maxCount 1 ; sh:class jt:TextArtifact ] ;
  sh:sparql [ sh:message "The excerpt hash must match the exact exported Unicode text." ;
    sh:select """PREFIX jt: <urn:jobtology:vocab:1:>
      SELECT $this WHERE { $this jt:excerpt ?text ; jt:excerptSha256 ?hash .
        FILTER(SHA256(STR(?text)) != STR(?hash)) }""" ] .

jt:TextArtifactShape a sh:NodeShape ; sh:targetClass jt:TextArtifact ;
  sh:property [ sh:path jt:artifactId ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path jt:textSha256 ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:pattern "^[0-9a-f]{64}$" ] ;
  sh:property [ sh:path jt:sourceField ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ] ;
  sh:property [ sh:path jt:derivedFrom ; sh:minCount 1 ; sh:nodeKind sh:IRI ] .

jt:ReviewedClaimShape a sh:NodeShape ; sh:targetClass jt:DutyClaim, jt:RequirementClaim ;
  sh:property [ sh:path jt:claimId ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path jt:postingRevisionId ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:pattern "^[0-9a-f]{64}$" ] ;
  sh:property [ sh:path jt:evidencedBy ; sh:minCount 1 ; sh:class jt:EvidenceSpan ] ;
  sh:property [ sh:path jt:reviewedBy ; sh:minCount 1 ; sh:maxCount 1 ; sh:class jt:PostingReviewSelection ] .

jt:ConditionExpressionShape a sh:NodeShape ; sh:targetClass jt:ConditionExpression ;
  sh:property [ sh:path jt:operator ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ("atom" "all_of" "any_of" "if_then" "except") ] ;
  sh:or (
    [ sh:property [ sh:path jt:operator ; sh:hasValue "atom" ] ; sh:property [ sh:path jt:hasChild ; sh:maxCount 0 ] ]
    [ sh:property [ sh:path jt:operator ; sh:in ("all_of" "any_of") ] ; sh:property [ sh:path jt:hasChild ; sh:minCount 2 ; sh:class jt:ConditionExpression ] ]
    [ sh:property [ sh:path jt:operator ; sh:in ("if_then" "except") ] ; sh:property [ sh:path jt:hasChild ; sh:minCount 2 ; sh:maxCount 2 ; sh:class jt:ConditionExpression ] ]
  ) .

jt:ReleaseStructureShape a sh:NodeShape ; sh:targetClass jt:CorpusRelease ;
  sh:property [ sh:path jt:selectedReleaseId ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ] ;
  sh:property [ sh:path jt:nativeGraphManifestHash ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:pattern "^[0-9a-f]{64}$" ] ;
  sh:property [ sh:path jt:exportContractVersion ; sh:minCount 1 ; sh:maxCount 1 ; sh:hasValue "hop-ontology-interchange-v1" ] ;
  sh:property [ sh:path jt:exportContractHash ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:pattern "^[0-9a-f]{64}$" ] ;
  sh:property [ sh:path jt:exportReadMode ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ("PREVIEW" "PUBLISHED") ] .
