# Copy this learning kit outside the repository, then copy this file to .env.
# Use the same released Hop version for the editor and runner.
HOP_VERSION=2.19.0
POSTGRES_PASSWORD=change-this-local-password
NEO4J_PASSWORD=change-this-graph-password

# These are unnecessary for the offline lessons.
# Use the decoded/raw data.go.kr key: REST Client encodes query values once.
DATA_GO_KR_SERVICE_KEY=
LLM_API_KEY=
