<?xml version='1.0' encoding='UTF-8'?>
<pipeline>
  <info>
    <name>verify_references</name>
    <description>Batch-free source graph; immutable membership remains in PostgreSQL.</description>
    <pipeline_type>Normal</pipeline_type>
    <size_rowset>1000</size_rowset>
    <parameters />
  </info>
  <notepads />
  <order>
    <hop>
      <from>Snapshot</from>
      <to>Read entity names</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Read entity names</from>
      <to>Set entity names</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Set entity names</from>
      <to>Check result</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Check result</from>
      <to>Complete</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Check result</from>
      <to>Check failed</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <type>GetVariable</type>
    <name>Snapshot</name>
    <fields>
      <field>
        <name>run_id</name>
        <variable>${RUN_ID}</variable>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
      </field>
    </fields>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>100</xloc>
      <yloc>100</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
  </transform>
  <transform>
    <type>DBJoin</type>
    <name>Read entity names</name>
    <cache>N</cache>
    <cache_size>0</cache_size>
    <sql>SELECT * FROM ingestion.graph_source_edges(?)</sql>
    <rowlimit>0</rowlimit>
    <outer_join>N</outer_join>
    <parameter>
      <field>
        <name>run_id</name>
        <type>String</type>
      </field>
    </parameter>
    <replace_vars>N</replace_vars>
    <connection>jobtology-postgres</connection>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>330</xloc>
      <yloc>100</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
  </transform>
  <transform>
    <type>Neo4jCypherOutput</type>
    <name>Set entity names</name>
    <connection>${NEO4J_CONNECTION}</connection>
    <cypher>MATCH (a:entity {id:$from_id})-[i]-&gt;(b:entity {id:$to_id})
WHERE type(i)=$edge_kind AND i.edge_key=$edge_key AND i.source_graph=true AND i.owner_id=$owner_id AND i.source_id=$source_id AND i.source_run_id=$source_run_id AND i.source_record_id=$source_record_id AND i.facts_json=$edge_facts_json
RETURN count(i)=1 AS entity_matches</cypher>
    <batch_size>1</batch_size>
    <read_only>Y</read_only>
    <retry>N</retry>
    <nr_retries_on_error>0</nr_retries_on_error>
    <cypher_from_field>N</cypher_from_field>
    <unwind>N</unwind>
    <returning_graph>N</returning_graph>
    <mappings>
      <mapping>
        <parameter>owner_id</parameter>
        <field>owner_id</field>
        <type>String</type>
      </mapping>
      <mapping>
        <parameter>source_id</parameter>
        <field>source_id</field>
        <type>String</type>
      </mapping>
      <mapping>
        <parameter>source_run_id</parameter>
        <field>source_run_id</field>
        <type>String</type>
      </mapping>
      <mapping>
        <parameter>source_record_id</parameter>
        <field>source_record_id</field>
        <type>String</type>
      </mapping>
      <mapping>
        <parameter>from_id</parameter>
        <field>from_id</field>
        <type>String</type>
      </mapping>
      <mapping>
        <parameter>to_id</parameter>
        <field>to_id</field>
        <type>String</type>
      </mapping>
      <mapping>
        <parameter>edge_kind</parameter>
        <field>edge_kind</field>
        <type>String</type>
      </mapping>
      <mapping>
        <parameter>edge_key</parameter>
        <field>edge_key</field>
        <type>String</type>
      </mapping>
      <mapping>
        <parameter>edge_facts_json</parameter>
        <field>edge_facts_json</field>
        <type>String</type>
      </mapping>
    </mappings>
    <returns>
      <return>
        <name>entity_matches</name>
        <type>Boolean</type>
        <source_type>Boolean</source_type>
      </return>
    </returns>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>560</xloc>
      <yloc>100</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
  </transform>
  <transform>
    <type>FilterRows</type>
    <name>Check result</name>
    <compare>
      <condition>
        <negated>N</negated>
        <operator>-</operator>
        <leftvalue>entity_matches</leftvalue>
        <function>=</function>
        <value>
          <name>constant</name>
          <type>Boolean</type>
          <text>Y</text>
          <length>-1</length>
          <precision>-1</precision>
          <isnull>N</isnull>
        </value>
      </condition>
    </compare>
    <send_true_to>Complete</send_true_to>
    <send_false_to>Check failed</send_false_to>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>790</xloc>
      <yloc>100</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
  </transform>
  <transform>
    <type>Dummy</type>
    <name>Complete</name>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>1020</xloc>
      <yloc>100</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
  </transform>
  <transform>
    <type>Abort</type>
    <name>Check failed</name>
    <row_threshold>0</row_threshold>
    <message>Source business projection differs from accepted PostgreSQL evidence; replay exact RUN_ID.</message>
    <always_log_rows>N</always_log_rows>
    <abort_option>ABORT_WITH_ERROR</abort_option>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>100</xloc>
      <yloc>270</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
  </transform>
  <transform_error_handling />
  <attributes />
</pipeline>