<?xml version='1.0' encoding='UTF-8'?>
<pipeline>
  <info>
    <name>verify_references</name>
    <description>Compare exact identity references and identity properties.</description>
    <pipeline_type>Normal</pipeline_type>
    <size_rowset>1000</size_rowset>
    <parameters />
  </info>
  <notepads />
  <order>
    <hop>
      <from>Snapshot</from>
      <to>Read PostgreSQL references</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Read PostgreSQL references</from>
      <to>Verify graph reference</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Verify graph reference</from>
      <to>Check result</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Check result</from>
      <to>Complete</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Check result</from>
      <to>Check failed</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <type>GetVariable</type>
    <name>Snapshot</name>
    <fields>
      <field>
        <name>run_id</name>
        <variable>${RUN_ID}</variable>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
      </field>
    </fields>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>100</xloc>
      <yloc>100</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
  </transform>
  <transform>
    <type>DBJoin</type>
    <name>Read PostgreSQL references</name>
    <cache>N</cache>
    <cache_size>0</cache_size>
    <sql>SELECT record_id,identity_id,kind,code,field FROM ingestion.graph_reference WHERE run_id=? ORDER BY record_id,field,identity_id</sql>
    <rowlimit>0</rowlimit>
    <outer_join>N</outer_join>
    <parameter>
      <field>
        <name>run_id</name>
        <type>String</type>
      </field>
    </parameter>
    <replace_vars>N</replace_vars>
    <connection>jobtology-postgres</connection>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>330</xloc>
      <yloc>100</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
  </transform>
  <transform>
    <type>Neo4jCypherOutput</type>
    <name>Verify graph reference</name>
    <connection>${NEO4J_CONNECTION}</connection>
    <cypher>MATCH (:ingestionBatch {id:$run_id})-[:HAS_RECORD]-&gt;(:ingestionRecord {id:$record_id})
-[ref:REFERS_TO {field:$field}]-&gt;(i:entity {id:$identity_id})
WHERE i.kind=$kind AND i.code=$code AND ((i.kind='Organization' AND 'organization' IN labels(i)) OR (i.kind='JobPosting' AND 'jobPosting' IN labels(i)) OR (i.kind='Occupation' AND 'occupation' IN labels(i)) OR (i.kind='Competency' AND 'ncsCompetency' IN labels(i)) OR (i.kind='Qualification' AND 'qualification' IN labels(i))) RETURN count(i)=1 AS reference_matches</cypher>
    <batch_size>1</batch_size>
    <read_only>Y</read_only>
    <retry>N</retry>
    <nr_retries_on_error>0</nr_retries_on_error>
    <cypher_from_field>N</cypher_from_field>
    <unwind>N</unwind>
    <returning_graph>N</returning_graph>
    <mappings>
      <mapping>
        <parameter>run_id</parameter>
        <field>run_id</field>
        <type>String</type>
      </mapping>
      <mapping>
        <parameter>record_id</parameter>
        <field>record_id</field>
        <type>String</type>
      </mapping>
      <mapping>
        <parameter>identity_id</parameter>
        <field>identity_id</field>
        <type>String</type>
      </mapping>
      <mapping>
        <parameter>kind</parameter>
        <field>kind</field>
        <type>String</type>
      </mapping>
      <mapping>
        <parameter>code</parameter>
        <field>code</field>
        <type>String</type>
      </mapping>
      <mapping>
        <parameter>field</parameter>
        <field>field</field>
        <type>String</type>
      </mapping>
    </mappings>
    <returns>
      <return>
        <name>reference_matches</name>
        <type>Boolean</type>
        <source_type>Boolean</source_type>
      </return>
    </returns>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>560</xloc>
      <yloc>100</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
  </transform>
  <transform>
    <type>FilterRows</type>
    <name>Check result</name>
    <compare>
      <condition>
        <negated>N</negated>
        <operator>-</operator>
        <leftvalue>reference_matches</leftvalue>
        <function>=</function>
        <value>
          <name>constant</name>
          <type>Boolean</type>
          <text>Y</text>
          <length>-1</length>
          <precision>-1</precision>
          <isnull>N</isnull>
        </value>
      </condition>
    </compare>
    <send_true_to>Complete</send_true_to>
    <send_false_to>Check failed</send_false_to>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>790</xloc>
      <yloc>100</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
  </transform>
  <transform>
    <type>Dummy</type>
    <name>Complete</name>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>1020</xloc>
      <yloc>100</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
  </transform>
  <transform>
    <type>Abort</type>
    <name>Check failed</name>
    <row_threshold>0</row_threshold>
    <message>A graph reference is missing, duplicated or has conflicting identity properties.</message>
    <always_log_rows>N</always_log_rows>
    <abort_option>ABORT_WITH_ERROR</abort_option>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>100</xloc>
      <yloc>270</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
  </transform>
  <transform_error_handling />
  <attributes />
</pipeline>