<?xml version='1.0' encoding='UTF-8'?>
<workflow>
  <name>Update posting identity dates from accepted ingestion events</name>
  <description>Set and verify only posting date properties. Preserve business entities, facts, names and enrichment.</description>
  <workflow_version>1</workflow_version>
  <workflow_status>0</workflow_status>
  <parameters>
    <parameter>
      <name>RUN_ID</name>
      <default_value />
      <description>RUN_ID</description>
    </parameter>
    <parameter>
      <name>NEO4J_CONNECTION</name>
      <default_value>jobtology-neo4j</default_value>
      <description>NEO4J_CONNECTION</description>
    </parameter>
  </parameters>
  <actions>
    <action>
      <attributes />
      <repeat>N</repeat>
      <schedulerType>0</schedulerType>
      <intervalSeconds>0</intervalSeconds>
      <intervalMinutes>60</intervalMinutes>
      <DayOfMonth>1</DayOfMonth>
      <weekDay>1</weekDay>
      <minutes>0</minutes>
      <hour>12</hour>
      <doNotWaitOnFirstExecution>N</doNotWaitOnFirstExecution>
      <description />
      <attributes />
      <name>Start</name>
      <type>SPECIAL</type>
      <xloc>100</xloc>
      <yloc>80</yloc>
      <draw>Y</draw>
      <parallel>N</parallel>
      <start>Y</start>
    </action>
    <action>
      <attributes />
      <name>Success</name>
      <description />
      <attributes />
      <type>SUCCESS</type>
      <xloc>100</xloc>
      <yloc>740</yloc>
      <draw>Y</draw>
      <parallel>N</parallel>
    </action>
    <action>
      <attributes />
      <loglevel>Error</loglevel>
      <name>Abort</name>
      <description />
      <attributes />
      <type>ABORT</type>
      <xloc>680</xloc>
      <yloc>740</yloc>
      <draw>Y</draw>
      <parallel>N</parallel>
      <message>Posting identity date update failed. Partial date changes can be replayed from the same immutable ingestion events.</message>
    </action>
    <action>
      <attributes />
      <params_from_previous>N</params_from_previous>
      <exec_per_row>N</exec_per_row>
      <clear_rows>N</clear_rows>
      <clear_files>N</clear_files>
      <create_parent_folder>N</create_parent_folder>
      <set_logfile>N</set_logfile>
      <set_append_logfile>N</set_append_logfile>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <loglevel>Basic</loglevel>
      <wait_until_finished>Y</wait_until_finished>
      <parameters>
        <pass_all_parameters>Y</pass_all_parameters>
      </parameters>
      <attributes />
      <name>Enter retention writer guard</name>
      <type>PIPELINE</type>
      <xloc>100</xloc>
      <yloc>650</yloc>
      <draw>Y</draw>
      <parallel>N</parallel>
      <filename>${PROJECT_HOME}/retention/enter_graph_writer.hpl</filename>
      <run_configuration>retention-local</run_configuration>
    </action>
    <action>
      <attributes />
      <params_from_previous>N</params_from_previous>
      <exec_per_row>N</exec_per_row>
      <clear_rows>N</clear_rows>
      <clear_files>N</clear_files>
      <create_parent_folder>N</create_parent_folder>
      <set_logfile>N</set_logfile>
      <set_append_logfile>N</set_append_logfile>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <loglevel>Basic</loglevel>
      <wait_until_finished>Y</wait_until_finished>
      <parameters>
        <pass_all_parameters>Y</pass_all_parameters>
      </parameters>
      <attributes />
      <name>Leave retention writer guard</name>
      <type>PIPELINE</type>
      <xloc>100</xloc>
      <yloc>650</yloc>
      <draw>Y</draw>
      <parallel>N</parallel>
      <filename>${PROJECT_HOME}/retention/leave_graph_writer.hpl</filename>
      <run_configuration>retention-local</run_configuration>
    </action>
    <action>
      <attributes />
      <params_from_previous>N</params_from_previous>
      <exec_per_row>N</exec_per_row>
      <clear_rows>N</clear_rows>
      <clear_files>N</clear_files>
      <create_parent_folder>N</create_parent_folder>
      <set_logfile>N</set_logfile>
      <set_append_logfile>N</set_append_logfile>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <loglevel>Basic</loglevel>
      <wait_until_finished>Y</wait_until_finished>
      <parameters>
        <pass_all_parameters>Y</pass_all_parameters>
      </parameters>
      <attributes />
      <name>Release failed graph writer</name>
      <type>PIPELINE</type>
      <xloc>100</xloc>
      <yloc>650</yloc>
      <draw>Y</draw>
      <parallel>N</parallel>
      <filename>${PROJECT_HOME}/retention/leave_graph_writer.hpl</filename>
      <run_configuration>retention-local</run_configuration>
    </action>
    <action>
      <attributes />
      <params_from_previous>N</params_from_previous>
      <exec_per_row>N</exec_per_row>
      <clear_rows>N</clear_rows>
      <clear_files>N</clear_files>
      <create_parent_folder>N</create_parent_folder>
      <set_logfile>N</set_logfile>
      <set_append_logfile>N</set_append_logfile>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <loglevel>Basic</loglevel>
      <wait_until_finished>Y</wait_until_finished>
      <parameters>
        <pass_all_parameters>Y</pass_all_parameters>
      </parameters>
      <attributes />
      <name>Set posting ingestion dates</name>
      <type>PIPELINE</type>
      <xloc>680</xloc>
      <yloc>400</yloc>
      <draw>Y</draw>
      <parallel>N</parallel>
      <filename>${PROJECT_HOME}/graph/load_posting_dates.hpl</filename>
      <run_configuration>graph-local</run_configuration>
    </action>
    <action>
      <attributes />
      <params_from_previous>N</params_from_previous>
      <exec_per_row>N</exec_per_row>
      <clear_rows>N</clear_rows>
      <clear_files>N</clear_files>
      <create_parent_folder>N</create_parent_folder>
      <set_logfile>N</set_logfile>
      <set_append_logfile>N</set_append_logfile>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <loglevel>Basic</loglevel>
      <wait_until_finished>Y</wait_until_finished>
      <parameters>
        <pass_all_parameters>Y</pass_all_parameters>
      </parameters>
      <attributes />
      <name>Verify posting ingestion dates</name>
      <type>PIPELINE</type>
      <xloc>680</xloc>
      <yloc>400</yloc>
      <draw>Y</draw>
      <parallel>N</parallel>
      <filename>${PROJECT_HOME}/graph/verify_posting_dates.hpl</filename>
      <run_configuration>graph-local</run_configuration>
    </action>
  </actions>
  <hops>
    <hop>
      <from>Start</from>
      <to>Enter retention writer guard</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>Y</unconditional>
    </hop>
    <hop>
      <from>Enter retention writer guard</from>
      <to>Set posting ingestion dates</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Enter retention writer guard</from>
      <to>Release failed graph writer</to>
      <enabled>Y</enabled>
      <evaluation>N</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Set posting ingestion dates</from>
      <to>Verify posting ingestion dates</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Set posting ingestion dates</from>
      <to>Release failed graph writer</to>
      <enabled>Y</enabled>
      <evaluation>N</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Verify posting ingestion dates</from>
      <to>Leave retention writer guard</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Verify posting ingestion dates</from>
      <to>Release failed graph writer</to>
      <enabled>Y</enabled>
      <evaluation>N</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Leave retention writer guard</from>
      <to>Success</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Leave retention writer guard</from>
      <to>Release failed graph writer</to>
      <enabled>Y</enabled>
      <evaluation>N</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Release failed graph writer</from>
      <to>Abort</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Release failed graph writer</from>
      <to>Abort</to>
      <enabled>Y</enabled>
      <evaluation>N</evaluation>
      <unconditional>N</unconditional>
