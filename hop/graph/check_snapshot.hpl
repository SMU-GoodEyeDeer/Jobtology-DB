<?xml version='1.0' encoding='UTF-8'?>
<pipeline>
  <info>
    <name>check_snapshot</name>
    <description>Require an accepted PostgreSQL snapshot before any graph writes. PostgreSQL remains read-only.</description>
    <pipeline_type>Normal</pipeline_type>
    <size_rowset>1000</size_rowset>
    <parameters />
  </info>
  <notepads />
  <order>
    <hop>
      <from>Snapshot</from>
      <to>Read accepted snapshot</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Read accepted snapshot</from>
      <to>Check PostgreSQL state</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Check PostgreSQL state</from>
      <to>Snapshot summary</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Snapshot summary</from>
      <to>Check result</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Check result</from>
      <to>Complete</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Check result</from>
      <to>Check failed</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <type>GetVariable</type>
    <name>Snapshot</name>
    <fields>
      <field>
        <name>run_id</name>
        <variable>${RUN_ID}</variable>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
      </field>
    </fields>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>100</xloc>
      <yloc>100</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
  </transform>
  <transform>
    <type>DBJoin</type>
    <name>Read accepted snapshot</name>
    <cache>N</cache>
    <cache_size>0</cache_size>
    <sql>WITH input AS (SELECT ?::text AS run_id)
SELECT to_char(u.created_at AT TIME ZONE 'UTC','YYYY-MM-DD"T"HH24:MI:SS.US"Z"') AS source_created_at,
to_char(u.created_at AT TIME ZONE 'Asia/Seoul','YYYY-MM-DD') AS batch_date,
to_char(u.created_at AT TIME ZONE 'Asia/Seoul','YYYY-MM-DD HH24:MI') || ' KST · ' || u.source_id AS batch_name,
u.source_id,coalesce(u.state='READY' AND u.mode&lt;&gt;'SMOKE',false) AS snapshot_ready,
(SELECT count(*) FROM ingestion.graph_record r WHERE r.run_id=i.run_id) AS expected_records,
(SELECT count(*) FROM ingestion.graph_reference r WHERE r.run_id=i.run_id) AS expected_references,
(SELECT count(*) FROM ingestion.validation_issue v WHERE v.run_id=i.run_id) AS validation_issues
FROM input i LEFT JOIN ingestion.run u USING(run_id)</sql>
    <rowlimit>0</rowlimit>
    <outer_join>N</outer_join>
    <parameter>
      <field>
        <name>run_id</name>
        <type>String</type>
      </field>
    </parameter>
    <replace_vars>N</replace_vars>
    <connection>jobtology-postgres</connection>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>330</xloc>
      <yloc>100</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
  </transform>
  <transform>
    <type>DBJoin</type>
    <name>Check PostgreSQL state</name>
    <cache>N</cache>
    <cache_size>0</cache_size>
    <sql>SELECT ?::boolean AND ?::bigint=0 AS snapshot_valid</sql>
    <rowlimit>0</rowlimit>
    <outer_join>N</outer_join>
    <parameter>
      <field>
        <name>snapshot_ready</name>
        <type>Boolean</type>
      </field>
      <field>
        <name>validation_issues</name>
        <type>Integer</type>
      </field>
    </parameter>
    <replace_vars>N</replace_vars>
    <connection>jobtology-postgres</connection>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>560</xloc>
      <yloc>100</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
  </transform>
  <transform>
    <type>WriteToLog</type>
    <name>Snapshot summary</name>
    <displayHeader>Y</displayHeader>
    <limitRows>N</limitRows>
    <limitRowsNumber>0</limitRowsNumber>
    <logmessage>PostgreSQL graph source</logmessage>
    <loglevel>Basic</loglevel>
    <fields>
      <field>
        <name>run_id</name>
      </field>
      <field>
        <name>source_id</name>
      </field>
      <field>
        <name>expected_records</name>
      </field>
      <field>
        <name>expected_references</name>
      </field>
      <field>
        <name>validation_issues</name>
      </field>
    </fields>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>790</xloc>
      <yloc>100</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
  </transform>
  <transform>
    <type>FilterRows</type>
    <name>Check result</name>
    <compare>
      <condition>
        <negated>N</negated>
        <operator>-</operator>
        <leftvalue>snapshot_valid</leftvalue>
        <function>=</function>
        <value>
          <name>constant</name>
          <type>Boolean</type>
          <text>Y</text>
          <length>-1</length>
          <precision>-1</precision>
          <isnull>N</isnull>
        </value>
      </condition>
    </compare>
    <send_true_to>Complete</send_true_to>
    <send_false_to>Check failed</send_false_to>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>1020</xloc>
      <yloc>100</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
  </transform>
  <transform>
    <type>Dummy</type>
    <name>Complete</name>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>100</xloc>
      <yloc>270</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
  </transform>
  <transform>
    <type>Abort</type>
    <name>Check failed</name>
    <row_threshold>0</row_threshold>
    <message>RUN_ID must identify a READY, non-SMOKE PostgreSQL run with no validation issues.</message>
    <always_log_rows>N</always_log_rows>
    <abort_option>ABORT_WITH_ERROR</abort_option>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>330</xloc>
      <yloc>270</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
  </transform>
  <transform_error_handling />
  <attributes />
</pipeline>