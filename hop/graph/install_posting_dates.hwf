<?xml version='1.0' encoding='UTF-8'?>
<workflow>
  <name>Install posting identity date projection</name>
  <description>Add immutable posting ingestion and supplemental collection-time ledgers; execute no source or model requests.</description>
  <workflow_version>1</workflow_version>
  <workflow_status>0</workflow_status>
  <parameters />
  <actions>
