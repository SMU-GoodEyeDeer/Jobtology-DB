<?xml version='1.0' encoding='UTF-8'?>
<pipeline>
  <info>
    <name>load_records</name>
    <description>Batch-free source graph; immutable membership remains in PostgreSQL.</description>
    <pipeline_type>Normal</pipeline_type>
    <size_rowset>1000</size_rowset>
    <parameters />
  </info>
  <notepads />
  <order>
    <hop>
      <from>Snapshot</from>
      <to>Read entity names</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Read entity names</from>
      <to>Set entity names</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Set entity names</from>
      <to>Check result</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Check result</from>
      <to>Complete</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Check result</from>
      <to>Check failed</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <type>GetVariable</type>
    <name>Snapshot</name>
    <fields>
      <field>
        <name>run_id</name>
        <variable>${RUN_ID}</variable>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
      </field>
    </fields>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>100</xloc>
      <yloc>100</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
  </transform>
  <transform>
    <type>DBJoin</type>
    <name>Read entity names</name>
    <cache>N</cache>
    <cache_size>0</cache_size>
    <sql>SELECT * FROM ingestion.graph_source_entities(?)</sql>
    <rowlimit>0</rowlimit>
    <outer_join>N</outer_join>
    <parameter>
      <field>
        <name>run_id</name>
        <type>String</type>
      </field>
    </parameter>
    <replace_vars>N</replace_vars>
    <connection>jobtology-postgres</connection>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>330</xloc>
      <yloc>100</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
  </transform>
  <transform>
    <type>Neo4jCypherOutput</type>
    <name>Set entity names</name>
    <connection>${NEO4J_CONNECTION}</connection>
    <cypher>UNWIND $rows AS row
MERGE (i:entity {id:row.identity_id}) ON CREATE SET i.kind=row.kind,i.code=row.code
WITH row,i WHERE i.kind=row.kind AND i.code=row.code
FOREACH (_ IN CASE WHEN i.kind='Organization' THEN [1] ELSE [] END | SET i:organization)
FOREACH (_ IN CASE WHEN i.kind='JobPosting' THEN [1] ELSE [] END | SET i:jobPosting)
FOREACH (_ IN CASE WHEN i.kind='Occupation' THEN [1] ELSE [] END | SET i:occupation)
FOREACH (_ IN CASE WHEN i.kind='Competency' THEN [1] ELSE [] END | SET i:ncsCompetency)
FOREACH (_ IN CASE WHEN i.kind='Qualification' THEN [1] ELSE [] END | SET i:qualification)
FOREACH (_ IN CASE WHEN i.kind='ExamSession' THEN [1] ELSE [] END | SET i:examSession)
SET i.name=row.entity_name,i.title=row.entity_title,i.name_source_run_id=row.name_source_run_id,i.name_source_record_id=row.name_source_record_id,
i.source_id=row.source_id,i.source_run_id=row.source_run_id,i.source_record_id=row.source_record_id,
i.source_created_at=datetime(row.source_created_at),i.source_facts_json=row.source_facts_json,i.source_facts_sha256=row.source_facts_sha256
RETURN count(i)=size($rows) AS entity_matches</cypher>
    <batch_size>500</batch_size>
    <read_only>N</read_only>
    <retry>N</retry>
    <nr_retries_on_error>0</nr_retries_on_error>
    <cypher_from_field>N</cypher_from_field>
    <unwind>Y</unwind>
    <returning_graph>N</returning_graph>
    <mappings>
      <mapping>
        <parameter>identity_id</parameter>
        <field>identity_id</field>
        <type>String</type>
      </mapping>
      <mapping>
        <parameter>kind</parameter>
        <field>kind</field>
        <type>String</type>
      </mapping>
      <mapping>
        <parameter>code</parameter>
        <field>code</field>
        <type>String</type>
      </mapping>
      <mapping>
        <parameter>entity_name</parameter>
        <field>entity_name</field>
        <type>String</type>
      </mapping>
      <mapping>
        <parameter>entity_title</parameter>
        <field>entity_title</field>
        <type>String</type>
      </mapping>
      <mapping>
        <parameter>name_source_run_id</parameter>
        <field>name_source_run_id</field>
        <type>String</type>
      </mapping>
      <mapping>
        <parameter>name_source_record_id</parameter>
        <field>name_source_record_id</field>
        <type>String</type>
      </mapping>
      <mapping>
        <parameter>source_id</parameter>
        <field>source_id</field>
        <type>String</type>
      </mapping>
      <mapping>
        <parameter>source_run_id</parameter>
        <field>source_run_id</field>
        <type>String</type>
      </mapping>
      <mapping>
        <parameter>source_record_id</parameter>
        <field>source_record_id</field>
        <type>String</type>
      </mapping>
      <mapping>
        <parameter>source_created_at</parameter>
        <field>source_created_at</field>
        <type>String</type>
      </mapping>
      <mapping>
        <parameter>source_facts_json</parameter>
        <field>source_facts_json</field>
        <type>String</type>
      </mapping>
      <mapping>
        <parameter>source_facts_sha256</parameter>
        <field>source_facts_sha256</field>
        <type>String</type>
      </mapping>
    </mappings>
    <returns>
      <return>
        <name>entity_matches</name>
        <type>Boolean</type>
        <source_type>Boolean</source_type>
      </return>
    </returns>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>560</xloc>
      <yloc>100</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
    <unwind_map>rows</unwind_map>
  </transform>
  <transform>
    <type>FilterRows</type>
    <name>Check result</name>
    <compare>
      <condition>
        <negated>N</negated>
        <operator>-</operator>
        <leftvalue>entity_matches</leftvalue>
        <function>=</function>
        <value>
          <name>constant</name>
          <type>Boolean</type>
          <text>Y</text>
          <length>-1</length>
          <precision>-1</precision>
          <isnull>N</isnull>
        </value>
      </condition>
    </compare>
    <send_true_to>Complete</send_true_to>
    <send_false_to>Check failed</send_false_to>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>790</xloc>
      <yloc>100</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
  </transform>
  <transform>
    <type>Dummy</type>
    <name>Complete</name>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>1020</xloc>
      <yloc>100</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
  </transform>
  <transform>
    <type>Abort</type>
    <name>Check failed</name>
    <row_threshold>0</row_threshold>
    <message>Source business projection differs from accepted PostgreSQL evidence; replay exact RUN_ID.</message>
    <always_log_rows>N</always_log_rows>
    <abort_option>ABORT_WITH_ERROR</abort_option>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>100</xloc>
      <yloc>270</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
  </transform>
  <transform_error_handling />
  <attributes />
</pipeline>