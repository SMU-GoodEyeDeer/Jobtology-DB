<?xml version='1.0' encoding='UTF-8'?>
<pipeline>
  <info>
    <name>mark_failed</name>
    <description>Mark this incomplete graph batch FAILED when the graph service is reachable. PostgreSQL stays READY.</description>
    <pipeline_type>Normal</pipeline_type>
    <size_rowset>1000</size_rowset>
    <parameters />
  </info>
  <notepads />
  <order>
    <hop>
      <from>Snapshot</from>
      <to>Mark graph failure</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <type>GetVariable</type>
    <name>Snapshot</name>
    <fields>
      <field>
        <name>run_id</name>
        <variable>${RUN_ID}</variable>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
      </field>
    </fields>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>100</xloc>
      <yloc>100</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
  </transform>
  <transform>
    <type>Neo4jCypherOutput</type>
    <name>Mark graph failure</name>
    <connection>${NEO4J_CONNECTION}</connection>
    <cypher>MATCH (b:ingestionBatch {id:$run_id}) WHERE b.state='LOADING' SET b.state='FAILED',b.failed_at=datetime()</cypher>
    <batch_size>1</batch_size>
    <read_only>N</read_only>
    <retry>N</retry>
    <nr_retries_on_error>0</nr_retries_on_error>
    <cypher_from_field>N</cypher_from_field>
    <unwind>N</unwind>
    <returning_graph>N</returning_graph>
    <mappings>
      <mapping>
        <parameter>run_id</parameter>
        <field>run_id</field>
        <type>String</type>
      </mapping>
    </mappings>
    <returns />
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>330</xloc>
      <yloc>100</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
  </transform>
  <transform_error_handling />
  <attributes />
</pipeline>