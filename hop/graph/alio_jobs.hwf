<?xml version='1.0' encoding='UTF-8'?>
<workflow>
  <name>Load ALIO organizations and JOB-ALIO postings into Neo4j</name>
  <description>Load ALIO organizations and JOB-ALIO postings into Neo4j</description>
  <workflow_version>1</workflow_version>
  <workflow_status>0</workflow_status>
  <parameters>
    <parameter>
      <name>JOB_RUN_ID</name>
      <default_value>LATEST</default_value>
      <description>JOB_RUN_ID</description>
    </parameter>
    <parameter>
      <name>NEO4J_CONNECTION</name>
      <default_value>jobtology-neo4j</default_value>
      <description>NEO4J_CONNECTION</description>
    </parameter>
  </parameters>
  <actions>
    <action>
      <attributes />
      <repeat>N</repeat>
      <schedulerType>0</schedulerType>
      <intervalSeconds>0</intervalSeconds>
      <intervalMinutes>60</intervalMinutes>
      <DayOfMonth>1</DayOfMonth>
      <weekDay>1</weekDay>
      <minutes>0</minutes>
      <hour>12</hour>
      <doNotWaitOnFirstExecution>N</doNotWaitOnFirstExecution>
      <description />
      <attributes />
      <name>Start</name>
      <type>SPECIAL</type>
      <xloc>100</xloc>
      <yloc>80</yloc>
      <draw>Y</draw>
      <parallel>N</parallel>
      <start>Y</start>
    </action>
    <action>
      <attributes />
      <params_from_previous>N</params_from_previous>
      <exec_per_row>N</exec_per_row>
      <clear_rows>N</clear_rows>
      <clear_files>N</clear_files>
      <create_parent_folder>N</create_parent_folder>
      <set_logfile>N</set_logfile>
      <set_append_logfile>N</set_append_logfile>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <loglevel>Basic</loglevel>
      <wait_until_finished>Y</wait_until_finished>
      <parameters>
        <pass_all_parameters>Y</pass_all_parameters>
      </parameters>
      <attributes />
      <name>Pin jobs and employer snapshots</name>
      <type>PIPELINE</type>
      <xloc>100</xloc>
      <yloc>230</yloc>
      <draw>Y</draw>
      <parallel>N</parallel>
      <filename>${PROJECT_HOME}/graph/select_alio_jobs.hpl</filename>
      <run_configuration>graph-local</run_configuration>
    </action>
    <action>
      <attributes />
      <params_from_previous>N</params_from_previous>
      <exec_per_row>N</exec_per_row>
      <clear_rows>N</clear_rows>
      <clear_files>N</clear_files>
      <create_parent_folder>N</create_parent_folder>
      <set_logfile>N</set_logfile>
      <set_append_logfile>N</set_append_logfile>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <loglevel>Basic</loglevel>
      <wait_until_finished>Y</wait_until_finished>
      <parameters>
        <pass_all_parameters>Y</pass_all_parameters>
        <parameter>
          <name>RUN_ID</name>
          <value>${GRAPH_ORGANIZATION_RUN_ID}</value>
          <stream_name />
        </parameter>
      </parameters>
      <attributes />
      <name>Load pinned organizations</name>
      <type>WORKFLOW</type>
      <xloc>390</xloc>
      <yloc>230</yloc>
      <draw>Y</draw>
      <parallel>N</parallel>
      <filename>${PROJECT_HOME}/graph/load_snapshot.hwf</filename>
      <run_configuration>graph-local</run_configuration>
    </action>
    <action>
      <attributes />
      <params_from_previous>N</params_from_previous>
      <exec_per_row>N</exec_per_row>
      <clear_rows>N</clear_rows>
      <clear_files>N</clear_files>
      <create_parent_folder>N</create_parent_folder>
      <set_logfile>N</set_logfile>
      <set_append_logfile>N</set_append_logfile>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <loglevel>Basic</loglevel>
      <wait_until_finished>Y</wait_until_finished>
      <parameters>
        <pass_all_parameters>Y</pass_all_parameters>
        <parameter>
          <name>RUN_ID</name>
          <value>${GRAPH_JOB_RUN_ID}</value>
          <stream_name />
        </parameter>
      </parameters>
      <attributes />
      <name>Load selected postings</name>
      <type>WORKFLOW</type>
      <xloc>680</xloc>
      <yloc>230</yloc>
      <draw>Y</draw>
      <parallel>N</parallel>
      <filename>${PROJECT_HOME}/graph/load_snapshot.hwf</filename>
      <run_configuration>graph-local</run_configuration>
    </action>
    <action>
      <attributes />
      <name>Success</name>
      <description />
      <attributes />
      <type>SUCCESS</type>
      <xloc>100</xloc>
      <yloc>400</yloc>
      <draw>Y</draw>
      <parallel>N</parallel>
    </action>
    <action>
      <attributes />
      <loglevel>Error</loglevel>
      <name>Abort</name>
      <description />
      <attributes />
      <type>ABORT</type>
      <xloc>680</xloc>
      <yloc>400</yloc>
      <draw>Y</draw>
      <parallel>N</parallel>
      <message>Graph load failed. Inspect the graph batch; PostgreSQL snapshots are unchanged.</message>
    </action>
  </actions>
  <hops>
    <hop>
      <from>Start</from>
      <to>Pin jobs and employer snapshots</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>Y</unconditional>
    </hop>
    <hop>
      <from>Pin jobs and employer snapshots</from>
      <to>Abort</to>
      <enabled>Y</enabled>
      <evaluation>N</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Pin jobs and employer snapshots</from>
      <to>Load pinned organizations</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Load pinned organizations</from>
      <to>Abort</to>
      <enabled>Y</enabled>
      <evaluation>N</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Load pinned organizations</from>
      <to>Load selected postings</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Load selected postings</from>
      <to>Abort</to>
      <enabled>Y</enabled>
      <evaluation>N</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Load selected postings</from>
      <to>Success</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
  </hops>
  <notepads />
  <attributes />
</workflow>