<?xml version='1.0' encoding='UTF-8'?>
<pipeline>
  <info>
    <name>prepare_link_publication</name>
    <description>Freeze independently accepted current extraction and link decisions.</description>
    <pipeline_type>Normal</pipeline_type>
    <size_rowset>100</size_rowset>
    <parameters />
  </info>
  <notepads />
  <order>
    <hop>
      <from>Publication choice</from>
      <to>Freeze publication and acquire writer</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Freeze publication and acquire writer</from>
      <to>Remember batch ID</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <type>GetVariable</type>
    <name>Publication choice</name>
    <fields>
      <field>
        <name>publication_id</name>
        <variable>${PUBLICATION_ID}</variable>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
      </field>
    </fields>
    <copies>1</copies>
    <distribute>Y</distribute>
    <GUI>
      <xloc>80</xloc>
      <yloc>80</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
  </transform>
  <transform>
    <type>DBJoin</type>
    <name>Freeze publication and acquire writer</name>
    <connection>jobtology-postgres</connection>
    <sql>SELECT enrichment.prepare_link_publication(?) AS prepared_id</sql>
    <cache>N</cache>
    <cache_size>0</cache_size>
    <rowlimit>0</rowlimit>
    <outer_join>N</outer_join>
    <replace_vars>N</replace_vars>
    <parameter>
      <field>
        <name>publication_id</name>
        <type>String</type>
      </field>
    </parameter>
    <copies>1</copies>
    <distribute>Y</distribute>
    <GUI>
      <xloc>320</xloc>
      <yloc>80</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
  </transform>
  <transform>
    <type>SetVariable</type>
    <name>Remember batch ID</name>
    <use_formatting>Y</use_formatting>
    <fields>
      <field>
        <field_name>prepared_id</field_name>
        <variable_name>LINK_PUBLICATION_ID</variable_name>
        <variable_type>PARENT_WORKFLOW</variable_type>
        <default_value />
      </field>
    </fields>
    <copies>1</copies>
    <distribute>Y</distribute>
    <GUI>
      <xloc>560</xloc>
      <yloc>80</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
  </transform>
  <transform_error_handling />
  <attributes />
</pipeline>