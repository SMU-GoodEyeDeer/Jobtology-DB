<?xml version='1.0' encoding='UTF-8'?>
<pipeline>
  <info>
    <name>import_rule_interpretation</name>
    <description>Append source-grounded conditional meaning separately from the provider response.</description>
    <pipeline_type>Normal</pipeline_type>
    <size_rowset>100</size_rowset>
    <parameters />
  </info>
  <notepads />
  <order>
    <hop>
      <from>Interpretation file</from>
      <to>Read rule interpretation</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Read rule interpretation</from>
      <to>Append source interpretation</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Append source interpretation</from>
      <to>Interpretation saved</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <type>GetVariable</type>
    <name>Interpretation file</name>
    <fields>
      <field>
        <name>interpretation_filename</name>
        <variable>${INTERPRETATION_FILE}</variable>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
      </field>
    </fields>
    <copies>1</copies>
    <distribute>Y</distribute>
    <GUI>
      <xloc>80</xloc>
      <yloc>80</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
  </transform>
  <transform>
    <type>JsonInput</type>
    <name>Read rule interpretation</name>
    <IsInFields>Y</IsInFields>
    <IsAFile>Y</IsAFile>
    <valueField>interpretation_filename</valueField>
    <removeSourceField>N</removeSourceField>
    <ignoreMissingPath>N</ignoreMissingPath>
    <defaultPathLeafToNull>Y</defaultPathLeafToNull>
    <doNotFailIfNoFile>N</doNotFailIfNoFile>
    <fields>
      <field>
        <name>interpretation_json</name>
        <path>$</path>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
        <repeat>N</repeat>
      </field>
    </fields>
    <copies>1</copies>
    <distribute>Y</distribute>
    <GUI>
      <xloc>320</xloc>
      <yloc>80</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
  </transform>
  <transform>
    <type>DBJoin</type>
    <name>Append source interpretation</name>
    <connection>jobtology-postgres</connection>
    <sql>SELECT enrichment.capture_rule_interpretation(v-&gt;&gt;'revision_id',(v-&gt;&gt;'requirement_index')::integer,
 v-&gt;&gt;'actor',v-&gt;&gt;'reason',v-&gt;'document',v-&gt;&gt;'parent_id') AS interpretation_id FROM (SELECT ?::jsonb v) input</sql>
    <cache>N</cache>
    <cache_size>0</cache_size>
    <rowlimit>0</rowlimit>
    <outer_join>N</outer_join>
    <replace_vars>N</replace_vars>
    <parameter>
      <field>
        <name>interpretation_json</name>
        <type>String</type>
      </field>
    </parameter>
    <copies>1</copies>
    <distribute>Y</distribute>
    <GUI>
      <xloc>560</xloc>
      <yloc>80</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
  </transform>
  <transform>
    <type>WriteToLog</type>
    <name>Interpretation saved</name>
    <loglevel>Basic</loglevel>
    <displayHeader>Y</displayHeader>
    <logmessage>Conditional interpretation remains pending independent review.</logmessage>
    <fields>
      <field>
        <name>interpretation_id</name>
      </field>
    </fields>
    <copies>1</copies>
    <distribute>Y</distribute>
    <GUI>
      <xloc>800</xloc>
      <yloc>80</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
  </transform>
  <transform_error_handling />
  <attributes />
</pipeline>