<?xml version='1.0' encoding='UTF-8'?>
<pipeline>
  <info>
    <name>review_item</name>
    <description>Record a named human review. EVAL results cannot be accepted for publication.</description>
    <pipeline_type>Normal</pipeline_type>
    <size_rowset>100</size_rowset>
    <parameters />
  </info>
  <notepads />
  <order>
    <hop>
      <from>Review</from>
      <to>Save review</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Save review</from>
      <to>Review recorded</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <type>GetVariable</type>
    <name>Review</name>
    <fields>
      <field>
        <name>item_id</name>
        <variable>${ITEM_ID}</variable>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
      </field>
      <field>
        <name>decision</name>
        <variable>${DECISION}</variable>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
      </field>
      <field>
        <name>reviewer</name>
        <variable>${REVIEWER}</variable>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
      </field>
      <field>
        <name>notes</name>
        <variable>${NOTES}</variable>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
      </field>
    </fields>
    <copies>1</copies>
    <distribute>Y</distribute>
    <GUI>
      <xloc>80</xloc>
      <yloc>80</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
  </transform>
  <transform>
    <type>ExecSql</type>
    <name>Save review</name>
    <connection>jobtology-postgres</connection>
    <sql>SELECT enrichment.review_item(?,?,?,?)</sql>
    <execute_each_row>Y</execute_each_row>
    <single_statement>Y</single_statement>
    <set_params>Y</set_params>
    <replace_variables>N</replace_variables>
    <quoteString>N</quoteString>
    <arguments>
      <argument>
        <name>item_id</name>
      </argument>
      <argument>
        <name>decision</name>
      </argument>
      <argument>
        <name>reviewer</name>
      </argument>
      <argument>
        <name>notes</name>
      </argument>
    </arguments>
    <copies>1</copies>
    <distribute>Y</distribute>
    <GUI>
      <xloc>320</xloc>
      <yloc>80</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
  </transform>
  <transform>
    <type>WriteToLog</type>
    <name>Review recorded</name>
    <loglevel>Basic</loglevel>
    <displayHeader>Y</displayHeader>
    <logmessage>Review recorded. Run publish_reviewed.hwf to synchronize Neo4j.</logmessage>
    <fields>
      <field>
        <name>item_id</name>
      </field>
      <field>
        <name>decision</name>
      </field>
      <field>
        <name>reviewer</name>
      </field>
    </fields>
    <copies>1</copies>
    <distribute>Y</distribute>
    <GUI>
      <xloc>560</xloc>
      <yloc>80</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
  </transform>
  <transform_error_handling />
  <attributes />
</pipeline>