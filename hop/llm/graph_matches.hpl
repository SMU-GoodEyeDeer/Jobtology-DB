<?xml version='1.0' encoding='UTF-8'?>
<pipeline>
  <info>
    <name>graph_matches</name>
    <description>Publish evidence-backed duty alignments; these are LLM inferences, not official required competencies.</description>
    <pipeline_type>Normal</pipeline_type>
    <size_rowset>100</size_rowset>
    <parameters />
  </info>
  <notepads />
  <order>
    <hop>
      <from>Batch</from>
      <to>Accepted matches</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Accepted matches</from>
      <to>Merge alignment</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Merge alignment</from>
      <to>Check graph result</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Check graph result</from>
      <to>Verified</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Check graph result</from>
      <to>Graph mismatch</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <type>GetVariable</type>
    <name>Batch</name>
    <fields>
      <field>
        <name>batch_id</name>
        <variable>${BATCH_ID}</variable>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
      </field>
    </fields>
    <copies>1</copies>
    <distribute>Y</distribute>
    <GUI>
      <xloc>80</xloc>
      <yloc>80</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
  </transform>
  <transform>
    <type>DBJoin</type>
    <name>Accepted matches</name>
    <connection>jobtology-postgres</connection>
    <sql>SELECT * FROM enrichment.graph_match WHERE batch_id=? ORDER BY item_id,duty_index,competency_code</sql>
    <cache>N</cache>
    <cache_size>0</cache_size>
    <rowlimit>0</rowlimit>
    <outer_join>N</outer_join>
    <replace_vars>N</replace_vars>
    <parameter>
      <field>
        <name>batch_id</name>
        <type>String</type>
      </field>
    </parameter>
    <copies>1</copies>
    <distribute>Y</distribute>
    <GUI>
      <xloc>320</xloc>
      <yloc>80</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
  </transform>
  <transform>
    <type>Neo4jCypherOutput</type>
    <name>Merge alignment</name>
    <connection>${NEO4J_CONNECTION}</connection>
    <cypher>MATCH (e:jobEnrichment {id:$item_id,state:'LOADING',decision:'ACCEPT',review_id:$review_id})
MATCH (c:ncsCompetency {id:$competency_identity})
MERGE (e)-[r:ALIGNS_WITH_NCS {duty_index:$duty_index}]-&gt;(c)
SET r.competency_code=$competency_code,r.reason=$reason,r.duty=$duty,r.evidence_field=$evidence_field,
 r.evidence_quote=$evidence_quote,r.accepted=true,r.origin='LLM_INFERENCE',r.review_id=$review_id
RETURN count(r)=1 AS verified</cypher>
    <batch_size>1</batch_size>
    <read_only>N</read_only>
    <retry>N</retry>
    <nr_retries_on_error>0</nr_retries_on_error>
    <cypher_from_field>N</cypher_from_field>
    <unwind>N</unwind>
    <returning_graph>N</returning_graph>
    <mappings>
      <mapping>
        <parameter>item_id</parameter>
        <field>item_id</field>
        <type>String</type>
      </mapping>
      <mapping>
        <parameter>competency_identity</parameter>
        <field>competency_identity</field>
        <type>String</type>
      </mapping>
      <mapping>
        <parameter>competency_code</parameter>
        <field>competency_code</field>
        <type>String</type>
      </mapping>
      <mapping>
        <parameter>reason</parameter>
        <field>reason</field>
        <type>String</type>
      </mapping>
      <mapping>
        <parameter>duty</parameter>
        <field>duty</field>
        <type>String</type>
      </mapping>
      <mapping>
        <parameter>evidence_field</parameter>
        <field>evidence_field</field>
        <type>String</type>
      </mapping>
      <mapping>
        <parameter>evidence_quote</parameter>
        <field>evidence_quote</field>
        <type>String</type>
      </mapping>
      <mapping>
        <parameter>review_id</parameter>
        <field>review_id</field>
        <type>Integer</type>
      </mapping>
      <mapping>
        <parameter>duty_index</parameter>
        <field>duty_index</field>
        <type>Integer</type>
      </mapping>
    </mappings>
    <returns>
      <return>
        <name>verified</name>
        <type>Boolean</type>
        <source_type>Boolean</source_type>
      </return>
    </returns>
    <copies>1</copies>
    <distribute>Y</distribute>
    <GUI>
      <xloc>560</xloc>
      <yloc>80</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
  </transform>
  <transform>
    <type>FilterRows</type>
    <name>Check graph result</name>
    <send_true_to>Verified</send_true_to>
    <send_false_to>Graph mismatch</send_false_to>
    <compare>
      <condition>
        <negated>N</negated>
        <operator>-</operator>
        <leftvalue>verified</leftvalue>
        <function>=</function>
        <value>
          <name>constant</name>
          <type>Boolean</type>
          <text>Y</text>
          <length>-1</length>
          <precision>-1</precision>
          <isnull>N</isnull>
        </value>
      </condition>
    </compare>
    <copies>1</copies>
    <distribute>Y</distribute>
    <GUI>
      <xloc>800</xloc>
      <yloc>80</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
  </transform>
  <transform>
    <type>Dummy</type>
    <name>Verified</name>
    <copies>1</copies>
    <distribute>Y</distribute>
    <GUI>
      <xloc>1040</xloc>
      <yloc>80</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
  </transform>
  <transform>
    <type>Abort</type>
    <name>Graph mismatch</name>
    <message>Enrichment graph is missing, conflicting, or the human review changed. Re-run the same BATCH_ID after correction.</message>
    <always_log_rows>N</always_log_rows>
    <abort_option>ABORT_WITH_ERROR</abort_option>
    <row_threshold>0</row_threshold>
    <copies>1</copies>
    <distribute>Y</distribute>
    <GUI>
      <xloc>80</xloc>
      <yloc>240</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
  </transform>
  <transform_error_handling />
  <attributes />
</pipeline>