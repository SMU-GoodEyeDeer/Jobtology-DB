<?xml version='1.0' encoding='UTF-8'?>
<workflow>
  <name>Export frozen cases for human quality review</name>
  <description>Export frozen cases for human quality review</description>
  <workflow_version>1</workflow_version>
  <workflow_status>0</workflow_status>
  <parameters>
    <parameter>
      <name>DATASET_ID</name>
      <default_value>korean-jd-v1</default_value>
      <description>Prepared dataset.</description>
    </parameter>
    <parameter>
      <name>REVIEW_FILE</name>
      <default_value>${PROJECT_HOME}/data/llm/korean-jd-v1-review.json</default_value>
      <description>New UTF-8 JSON output file; existing files are not overwritten.</description>
    </parameter>
  </parameters>
  <actions>
    <action>
      <name>Start</name>
      <type>SPECIAL</type>
      <xloc>80</xloc>
      <yloc>80</yloc>
      <draw>Y</draw>
      <parallel>N</parallel>
      <attributes />
      <start>Y</start>
      <repeat>N</repeat>
      <schedulerType>0</schedulerType>
      <intervalSeconds>0</intervalSeconds>
      <intervalMinutes>60</intervalMinutes>
      <DayOfMonth>1</DayOfMonth>
      <weekDay>1</weekDay>
      <minutes>0</minutes>
      <hour>12</hour>
    </action>
    <action>
      <name>Export source text and label template</name>
      <type>PIPELINE</type>
      <xloc>320</xloc>
      <yloc>80</yloc>
      <draw>Y</draw>
      <parallel>N</parallel>
      <attributes />
      <filename>${PROJECT_HOME}/llm/export_review_file.hpl</filename>
      <params_from_previous>N</params_from_previous>
      <exec_per_row>N</exec_per_row>
      <clear_rows>N</clear_rows>
      <clear_files>N</clear_files>
      <set_logfile>N</set_logfile>
      <loglevel>Basic</loglevel>
      <wait_until_finished>Y</wait_until_finished>
      <run_configuration>llm-local</run_configuration>
      <parameters>
        <pass_all_parameters>Y</pass_all_parameters>
      </parameters>
    </action>
    <action>
      <name>Success</name>
      <type>SUCCESS</type>
      <xloc>560</xloc>
      <yloc>80</yloc>
      <draw>Y</draw>
      <parallel>N</parallel>
      <attributes />
    </action>
    <action>
      <name>Abort</name>
      <type>ABORT</type>
      <xloc>1040</xloc>
      <yloc>80</yloc>
      <draw>Y</draw>
      <parallel>N</parallel>
      <attributes />
      <message>LLM workflow failed. Inspect enrichment.batch_report and enrichment.attempt.</message>
    </action>
  </actions>
  <hops>
    <hop>
      <from>Start</from>
      <to>Export source text and label template</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>Y</unconditional>
    </hop>
    <hop>
      <from>Export source text and label template</from>
      <to>Abort</to>
      <enabled>Y</enabled>
      <evaluation>N</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Export source text and label template</from>
      <to>Success</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
  </hops>
  <notepads />
  <attributes />
</workflow>