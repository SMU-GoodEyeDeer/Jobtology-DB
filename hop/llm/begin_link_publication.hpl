<?xml version='1.0' encoding='UTF-8'?>
<pipeline>
  <info>
    <name>begin_link_publication</name>
    <description>Keep the reviewed NCS projection unavailable until fully verified.</description>
    <pipeline_type>Normal</pipeline_type>
    <size_rowset>100</size_rowset>
    <parameters />
  </info>
  <notepads />
  <order>
    <hop>
      <from>Publication</from>
      <to>Check frozen review state</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Check frozen review state</from>
      <to>Begin projection</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Begin projection</from>
      <to>Verified</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Verified</from>
      <to>Done</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Verified</from>
      <to>Mismatch</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <type>GetVariable</type>
    <name>Publication</name>
    <fields>
      <field>
        <name>publication_id</name>
        <variable>${LINK_PUBLICATION_ID}</variable>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
      </field>
    </fields>
    <copies>1</copies>
    <distribute>Y</distribute>
    <GUI>
      <xloc>80</xloc>
      <yloc>80</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
  </transform>
  <transform>
    <type>ExecSql</type>
    <name>Check frozen review state</name>
    <connection>jobtology-postgres</connection>
    <sql>SELECT enrichment.check_link_publication(?)</sql>
    <execute_each_row>Y</execute_each_row>
    <single_statement>Y</single_statement>
    <set_params>Y</set_params>
    <replace_variables>N</replace_variables>
    <quoteString>N</quoteString>
    <arguments>
      <argument>
        <name>publication_id</name>
      </argument>
    </arguments>
    <copies>1</copies>
    <distribute>Y</distribute>
    <GUI>
      <xloc>320</xloc>
      <yloc>80</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
  </transform>
  <transform>
    <type>Neo4jCypherOutput</type>
    <name>Begin projection</name>
    <connection>${NEO4J_CONNECTION}</connection>
    <cypher>MERGE (m:reviewedNcsPublication {id:'jobtology-reviewed-ncs'})
SET m.state='LOADING',m.publication_id=$publication_id
WITH m OPTIONAL MATCH (e:reviewedNcsEnrichment {managed_by:'jobtology-reviewed-ncs'})
SET e.current=false
WITH m OPTIONAL MATCH (:reviewedNcsEnrichment {managed_by:'jobtology-reviewed-ncs'})-[r:ALIGNS_WITH_NCS]-&gt;()
SET r.accepted=false
RETURN count(DISTINCT m)=1 AS verified</cypher>
    <batch_size>1</batch_size>
    <read_only>N</read_only>
    <retry>N</retry>
    <nr_retries_on_error>0</nr_retries_on_error>
    <cypher_from_field>N</cypher_from_field>
    <unwind>N</unwind>
    <returning_graph>N</returning_graph>
    <mappings>
      <mapping>
        <parameter>publication_id</parameter>
        <field>publication_id</field>
        <type>String</type>
      </mapping>
    </mappings>
    <returns>
      <return>
        <name>verified</name>
        <type>Boolean</type>
        <source_type>Boolean</source_type>
      </return>
    </returns>
    <copies>1</copies>
    <distribute>Y</distribute>
    <GUI>
      <xloc>560</xloc>
      <yloc>80</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
  </transform>
  <transform>
    <type>FilterRows</type>
    <name>Verified</name>
    <send_true_to>Done</send_true_to>
    <send_false_to>Mismatch</send_false_to>
    <compare>
      <condition>
        <negated>N</negated>
        <operator>-</operator>
        <leftvalue>verified</leftvalue>
        <function>=</function>
        <value>
          <name>constant</name>
          <type>Boolean</type>
          <text>Y</text>
          <length>-1</length>
          <precision>-1</precision>
          <isnull>N</isnull>
        </value>
      </condition>
    </compare>
    <copies>1</copies>
    <distribute>Y</distribute>
    <GUI>
      <xloc>800</xloc>
      <yloc>80</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
  </transform>
  <transform>
    <type>Dummy</type>
    <name>Done</name>
    <copies>1</copies>
    <distribute>Y</distribute>
    <GUI>
      <xloc>1040</xloc>
      <yloc>80</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
  </transform>
  <transform>
    <type>Abort</type>
    <name>Mismatch</name>
    <message>Reviewed-link projection differs from PostgreSQL. It has not been activated.</message>
    <always_log_rows>N</always_log_rows>
    <abort_option>ABORT_WITH_ERROR</abort_option>
    <row_threshold>0</row_threshold>
    <copies>1</copies>
    <distribute>Y</distribute>
    <GUI>
      <xloc>80</xloc>
      <yloc>240</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
  </transform>
  <transform_error_handling />
  <attributes />
</pipeline>