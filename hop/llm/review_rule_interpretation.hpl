<?xml version='1.0' encoding='UTF-8'?>
<pipeline>
  <info>
    <name>review_rule_interpretation</name>
    <description>Append a separate decision about the interpretation of a requirement.</description>
    <pipeline_type>Normal</pipeline_type>
    <size_rowset>100</size_rowset>
    <parameters />
  </info>
  <notepads />
  <order>
    <hop>
      <from>Interpretation decision</from>
      <to>Append interpretation decision</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Append interpretation decision</from>
      <to>Interpretation reviewed</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <type>GetVariable</type>
    <name>Interpretation decision</name>
    <fields>
      <field>
        <name>interpretation_id</name>
        <variable>${INTERPRETATION_ID}</variable>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
      </field>
      <field>
        <name>decision</name>
        <variable>${DECISION}</variable>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
      </field>
      <field>
        <name>reviewer</name>
        <variable>${REVIEWER}</variable>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
      </field>
      <field>
        <name>reviewer_kind</name>
        <variable>${REVIEWER_KIND}</variable>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
      </field>
      <field>
        <name>notes</name>
        <variable>${NOTES}</variable>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
      </field>
    </fields>
    <copies>1</copies>
    <distribute>Y</distribute>
    <GUI>
      <xloc>80</xloc>
      <yloc>80</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
  </transform>
  <transform>
    <type>ExecSql</type>
    <name>Append interpretation decision</name>
    <connection>jobtology-postgres</connection>
    <sql>SELECT enrichment.decide_rule_interpretation(?,?,?,?,?)</sql>
    <execute_each_row>Y</execute_each_row>
    <single_statement>Y</single_statement>
    <set_params>Y</set_params>
    <replace_variables>N</replace_variables>
    <quoteString>N</quoteString>
    <arguments>
      <argument>
        <name>interpretation_id</name>
      </argument>
      <argument>
        <name>decision</name>
      </argument>
      <argument>
        <name>reviewer</name>
      </argument>
      <argument>
        <name>reviewer_kind</name>
      </argument>
      <argument>
        <name>notes</name>
      </argument>
    </arguments>
    <copies>1</copies>
    <distribute>Y</distribute>
    <GUI>
      <xloc>320</xloc>
      <yloc>80</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
  </transform>
  <transform>
    <type>WriteToLog</type>
    <name>Interpretation reviewed</name>
    <loglevel>Basic</loglevel>
    <displayHeader>Y</displayHeader>
    <logmessage>Source extraction and individual NCS decisions remain separate.</logmessage>
    <fields>
      <field>
        <name>interpretation_id</name>
      </field>
      <field>
        <name>decision</name>
      </field>
      <field>
        <name>reviewer_kind</name>
      </field>
    </fields>
    <copies>1</copies>
    <distribute>Y</distribute>
    <GUI>
      <xloc>560</xloc>
      <yloc>80</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
  </transform>
  <transform_error_handling />
  <attributes />
</pipeline>