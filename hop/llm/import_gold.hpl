<?xml version='1.0' encoding='UTF-8'?>
<pipeline>
  <info>
    <name>import_gold</name>
    <description>Import human labels from one JSON document; gold labels never enter model prompts.</description>
    <pipeline_type>Normal</pipeline_type>
    <size_rowset>100</size_rowset>
    <parameters />
  </info>
  <notepads />
  <order>
    <hop>
      <from>Gold file</from>
      <to>Read gold JSON</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Read gold JSON</from>
      <to>Save gold revision</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <type>GetVariable</type>
    <name>Gold file</name>
    <fields>
      <field>
        <name>gold_filename</name>
        <variable>${GOLD_FILE}</variable>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
      </field>
    </fields>
    <copies>1</copies>
    <distribute>Y</distribute>
    <GUI>
      <xloc>80</xloc>
      <yloc>80</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
  </transform>
  <transform>
    <type>JsonInput</type>
    <name>Read gold JSON</name>
    <IsInFields>Y</IsInFields>
    <IsAFile>Y</IsAFile>
    <valueField>gold_filename</valueField>
    <removeSourceField>N</removeSourceField>
    <ignoreMissingPath>N</ignoreMissingPath>
    <defaultPathLeafToNull>Y</defaultPathLeafToNull>
    <doNotFailIfNoFile>N</doNotFailIfNoFile>
    <fields>
      <field>
        <name>gold_json</name>
        <path>$</path>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
        <repeat>N</repeat>
      </field>
    </fields>
    <copies>1</copies>
    <distribute>Y</distribute>
    <GUI>
      <xloc>320</xloc>
      <yloc>80</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
  </transform>
  <transform>
    <type>ExecSql</type>
    <name>Save gold revision</name>
    <connection>jobtology-postgres</connection>
    <sql>SELECT enrichment.import_gold(?::jsonb)</sql>
    <execute_each_row>Y</execute_each_row>
    <single_statement>Y</single_statement>
    <set_params>Y</set_params>
    <replace_variables>N</replace_variables>
    <quoteString>N</quoteString>
    <arguments>
      <argument>
        <name>gold_json</name>
      </argument>
    </arguments>
    <copies>1</copies>
    <distribute>Y</distribute>
    <GUI>
      <xloc>560</xloc>
      <yloc>80</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
  </transform>
  <transform_error_handling />
  <attributes />
</pipeline>