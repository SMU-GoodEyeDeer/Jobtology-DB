<?xml version='1.0' encoding='UTF-8'?>
<pipeline>
  <info>
    <name>verify_reviewed_links</name>
    <description>Read back every accepted NCS endpoint and evidence property.</description>
    <pipeline_type>Normal</pipeline_type>
    <size_rowset>100</size_rowset>
    <parameters />
  </info>
  <notepads />
  <order>
    <hop>
      <from>Publication</from>
      <to>Expected links</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Expected links</from>
      <to>Read back NCS evidence</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Read back NCS evidence</from>
      <to>Verified</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Verified</from>
      <to>Done</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Verified</from>
      <to>Mismatch</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <type>GetVariable</type>
    <name>Publication</name>
    <fields>
      <field>
        <name>publication_id</name>
        <variable>${LINK_PUBLICATION_ID}</variable>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
      </field>
    </fields>
    <copies>1</copies>
    <distribute>Y</distribute>
    <GUI>
      <xloc>80</xloc>
      <yloc>80</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
  </transform>
  <transform>
    <type>DBJoin</type>
    <name>Expected links</name>
    <connection>jobtology-postgres</connection>
    <sql>SELECT p.publication_id,p.enrichment_id,l-&gt;&gt;'candidate_id' AS candidate_id,
'ncs:unit:'||(l-&gt;&gt;'competency_code') AS competency_identity,l::text AS evidence_json,
l-&gt;&gt;'reason' AS reason,l#&gt;&gt;'{duty,text}' AS duty,l-&gt;&gt;'reviewer' AS reviewer,l-&gt;&gt;'reviewer_kind' AS reviewer_kind,
(l-&gt;&gt;'decision_id')::bigint AS decision_id FROM enrichment.link_publication_item p
CROSS JOIN LATERAL jsonb_array_elements(p.payload-&gt;'links') l WHERE p.publication_id=? ORDER BY p.posting_id,l-&gt;&gt;'candidate_id'</sql>
    <cache>N</cache>
    <cache_size>0</cache_size>
    <rowlimit>0</rowlimit>
    <outer_join>N</outer_join>
    <replace_vars>N</replace_vars>
    <parameter>
      <field>
        <name>publication_id</name>
        <type>String</type>
      </field>
    </parameter>
    <copies>1</copies>
    <distribute>Y</distribute>
    <GUI>
      <xloc>320</xloc>
      <yloc>80</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
  </transform>
  <transform>
    <type>Neo4jCypherOutput</type>
    <name>Read back NCS evidence</name>
    <connection>${NEO4J_CONNECTION}</connection>
    <cypher>MATCH (e:reviewedNcsEnrichment {id:$enrichment_id,publication_id:$publication_id})
-[r:ALIGNS_WITH_NCS {candidate_id:$candidate_id,accepted:true}]-&gt;(c:ncsCompetency {id:$competency_identity})
WHERE r.evidence_json=$evidence_json AND r.reason=$reason AND r.duty=$duty AND r.reviewer=$reviewer
AND r.reviewer_kind=$reviewer_kind AND r.decision_id=$decision_id AND r.origin='LLM_INFERENCE' AND r.publication_id=$publication_id
RETURN count(r)=1 AS verified</cypher>
    <batch_size>1</batch_size>
    <read_only>Y</read_only>
    <retry>N</retry>
    <nr_retries_on_error>0</nr_retries_on_error>
    <cypher_from_field>N</cypher_from_field>
    <unwind>N</unwind>
    <returning_graph>N</returning_graph>
    <mappings>
      <mapping>
        <parameter>publication_id</parameter>
        <field>publication_id</field>
        <type>String</type>
      </mapping>
      <mapping>
        <parameter>enrichment_id</parameter>
        <field>enrichment_id</field>
        <type>String</type>
      </mapping>
      <mapping>
        <parameter>candidate_id</parameter>
        <field>candidate_id</field>
        <type>String</type>
      </mapping>
      <mapping>
        <parameter>competency_identity</parameter>
        <field>competency_identity</field>
        <type>String</type>
      </mapping>
      <mapping>
        <parameter>evidence_json</parameter>
        <field>evidence_json</field>
        <type>String</type>
      </mapping>
      <mapping>
        <parameter>reason</parameter>
        <field>reason</field>
        <type>String</type>
      </mapping>
      <mapping>
        <parameter>duty</parameter>
        <field>duty</field>
        <type>String</type>
      </mapping>
      <mapping>
        <parameter>reviewer</parameter>
        <field>reviewer</field>
        <type>String</type>
      </mapping>
      <mapping>
        <parameter>reviewer_kind</parameter>
        <field>reviewer_kind</field>
        <type>String</type>
      </mapping>
      <mapping>
        <parameter>decision_id</parameter>
        <field>decision_id</field>
        <type>Integer</type>
      </mapping>
    </mappings>
    <returns>
      <return>
        <name>verified</name>
        <type>Boolean</type>
        <source_type>Boolean</source_type>
      </return>
    </returns>
    <copies>1</copies>
    <distribute>Y</distribute>
    <GUI>
      <xloc>560</xloc>
      <yloc>80</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
  </transform>
  <transform>
    <type>FilterRows</type>
    <name>Verified</name>
    <send_true_to>Done</send_true_to>
    <send_false_to>Mismatch</send_false_to>
    <compare>
      <condition>
        <negated>N</negated>
        <operator>-</operator>
        <leftvalue>verified</leftvalue>
        <function>=</function>
        <value>
          <name>constant</name>
          <type>Boolean</type>
          <text>Y</text>
          <length>-1</length>
          <precision>-1</precision>
          <isnull>N</isnull>
        </value>
      </condition>
    </compare>
    <copies>1</copies>
    <distribute>Y</distribute>
    <GUI>
      <xloc>800</xloc>
      <yloc>80</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
  </transform>
  <transform>
    <type>Dummy</type>
    <name>Done</name>
    <copies>1</copies>
    <distribute>Y</distribute>
    <GUI>
      <xloc>1040</xloc>
      <yloc>80</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
  </transform>
  <transform>
    <type>Abort</type>
    <name>Mismatch</name>
    <message>Reviewed-link projection differs from PostgreSQL. It has not been activated.</message>
    <always_log_rows>N</always_log_rows>
    <abort_option>ABORT_WITH_ERROR</abort_option>
    <row_threshold>0</row_threshold>
    <copies>1</copies>
    <distribute>Y</distribute>
    <GUI>
      <xloc>80</xloc>
      <yloc>240</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
  </transform>
  <transform_error_handling />
  <attributes />
</pipeline>