{
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "guarded-rules-v1"
      ]
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "action": {
            "type": "string",
            "enum": [
              "REQUIRE",
              "PERMIT",
              "FORBID",
              "PREFER",
              "UNRESTRICT",
              "LIMIT",
              "DISABLE"
            ]
          },
          "statement_parts": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8000
            },
            "minItems": 1,
            "maxItems": 40
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "minItems": 1,
            "maxItems": 100
          },
          "guard": {
            "anyOf": [
              {
                "$ref": "#/$defs/predicate"
              },
              {
                "type": "null"
              }
            ]
          },
          "target_rule_id": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "maxLength": 40
          }
        },
        "required": [
          "id",
          "action",
          "statement_parts",
          "evidence_ids",
          "guard",
          "target_rule_id"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 100
    }
  },
  "required": [
    "schema_version",
    "rules"
  ],
  "additionalProperties": false,
  "$defs": {
    "predicate": {
      "type": "object",
      "properties": {
        "op": {
          "type": "string",
          "enum": [
            "atom",
            "all_of",
            "any_of",
            "not"
          ]
        },
        "parts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8000
          },
          "minItems": 0,
          "maxItems": 20
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/predicate"
          },
          "minItems": 0,
          "maxItems": 60
        }
      },
      "required": [
        "op",
        "parts",
        "children"
      ],
      "additionalProperties": false
    }
  },
  "description": "Explicit normative rules, not a complete applicant-eligibility decision. REQUIRE states a necessary condition. PERMIT allows the stated action when its guard holds and never waives unrelated requirements. FORBID prohibits the stated action or condition. PREFER grants the stated preference. UNRESTRICT states lack of a restriction. LIMIT qualifies its referenced PREFER rule. DISABLE makes its referenced rule nonoperative when active. Every rule is active only when its guard is true and no active DISABLE rule targets it; missing observations retain UNKNOWN. A null guard is unconditional within the original requirement position scope. Predicate atoms are source-text propositions, not model-assigned truth values."
}
