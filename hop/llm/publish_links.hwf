<?xml version='1.0' encoding='UTF-8'?>
<workflow>
  <name>Publish independently reviewed current NCS links</name>
  <description>Publish independently reviewed current NCS links</description>
  <workflow_version>1</workflow_version>
  <workflow_status>0</workflow_status>
  <parameters>
    <parameter>
      <name>PUBLICATION_ID</name>
      <default_value />
      <description>Blank creates a fresh publication; replays require unchanged sources and decisions.</description>
    </parameter>
    <parameter>
      <name>NEO4J_CONNECTION</name>
      <default_value>jobtology-neo4j</default_value>
      <description>Existing private graph connection.</description>
    </parameter>
  </parameters>
