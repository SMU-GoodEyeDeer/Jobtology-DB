<?xml version='1.0' encoding='UTF-8'?>
<pipeline>
  <info>
    <name>write_edges</name>
    <description>Verify exact indexed endpoints and complete typed properties in bounded 500-row batches.</description>
    <pipeline_type>Normal</pipeline_type>
    <size_rowset>1000</size_rowset>
    <parameters />
  </info>
  <notepads />
  <order>
    <hop>
      <from>Exact O*NET operation options</from>
      <to>Check frozen graph plan once</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Check frozen graph plan once</from>
      <to>Read frozen graph plan</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Read frozen graph plan</from>
      <to>Apply bounded O*NET graph operation</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Apply bounded O*NET graph operation</from>
      <to>Require exact graph result</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Require exact graph result</from>
      <to>Require exact graph result accepted</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Require exact graph result</from>
      <to>Require exact graph result rejected</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <type>GetVariable</type>
    <name>Exact O*NET operation options</name>
    <fields>
      <field>
        <name>publication_id</name>
        <variable>${ONET_PUBLICATION_ID}</variable>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
      </field>
    </fields>
    <GUI>
      <xloc>80</xloc>
      <yloc>100</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
    <copies>1</copies>
    <distribute>Y</distribute>
  </transform>
  <transform>
    <type>ExecSql</type>
    <name>Check frozen graph plan once</name>
    <connection>jobtology-postgres</connection>
    <sql>SELECT onet_matching.check_graph(?)</sql>
    <execute_each_row>Y</execute_each_row>
    <single_statement>Y</single_statement>
    <set_params>Y</set_params>
    <replace_variables>N</replace_variables>
    <quoteString>N</quoteString>
    <arguments>
      <argument>
        <name>publication_id</name>
      </argument>
    </arguments>
    <GUI>
      <xloc>310</xloc>
      <yloc>100</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
    <copies>1</copies>
    <distribute>Y</distribute>
  </transform>
  <transform>
    <type>DBJoin</type>
    <name>Read frozen graph plan</name>
    <connection>jobtology-postgres</connection>
    <sql>SELECT g.database_id,e.edge_id,e.posting_identity,e.occupation_identity,e.properties-&gt;&gt;'source_facts_sha256' AS source_facts_sha256,e.properties-&gt;&gt;'release_id' AS release_id,e.properties-&gt;&gt;'occupation_content_hash' AS occupation_content_hash,(SELECT string_agg(replace(replace(coalesce(key,''),'%','%25'),'|','%7C')||'|'||(CASE jsonb_typeof(value) WHEN 'string' THEN 'string' WHEN 'boolean' THEN 'boolean' WHEN 'number' THEN CASE WHEN value::text ~ '^-?[0-9]+$' THEN 'integer' ELSE 'number' END ELSE 'invalid' END)||'|'||replace(replace(coalesce(value#&gt;&gt;'{}',''),'%','%25'),'|','%7C'),'|' ORDER BY key COLLATE "C") FROM jsonb_each(e.properties)) AS property_data,(SELECT count(*) FROM jsonb_object_keys(e.properties))::bigint AS property_count FROM onet_matching.graph_edge e JOIN onet_matching.graph_guard g USING(publication_id) WHERE e.publication_id=? ORDER BY edge_id</sql>
    <cache>N</cache>
    <cache_size>0</cache_size>
    <rowlimit>0</rowlimit>
    <outer_join>N</outer_join>
    <replace_vars>N</replace_vars>
    <parameter>
      <field>
        <name>publication_id</name>
        <type>String</type>
      </field>
    </parameter>
    <GUI>
      <xloc>540</xloc>
      <yloc>100</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
    <copies>1</copies>
    <distribute>Y</distribute>
  </transform>
  <transform>
    <type>Neo4jCypherOutput</type>
    <name>Apply bounded O*NET graph operation</name>
    <connection>${NEO4J_CONNECTION}</connection>
    <cypher>CALL db.info() YIELD id AS actual_database_id
UNWIND $rows AS row
WITH row,actual_database_id WHERE row.database_id=actual_database_id
WITH row,split(row.property_data,'|') AS fields
WHERE size(fields)=row.property_count*3
WITH row,[i IN range(0,size(fields)-1,3) | {key:replace(replace(fields[i],'%7C','|'),'%25','%'),
type:fields[i+1],text:replace(replace(fields[i+2],'%7C','|'),'%25','%')}] AS fields
WITH row,[p IN fields | {key:p.key,valid:p.type IN ['string','integer','number','boolean'],
value:CASE p.type WHEN 'string' THEN p.text WHEN 'integer' THEN toInteger(p.text)
WHEN 'number' THEN toFloat(p.text) WHEN 'boolean' THEN toBoolean(p.text) END}] AS expected_properties
WHERE all(p IN expected_properties WHERE p.valid AND p.value IS NOT NULL)
MATCH (posting:entity:jobPosting {id:row.posting_identity,kind:'JobPosting'})
WITH row,expected_properties,posting
MATCH (occupation:entity:onetCatalogObject:occupation {id:row.occupation_identity})
WHERE posting.source_facts_sha256=row.source_facts_sha256
AND occupation.managed_by='jobtology-onet-catalog-v1' AND occupation.scheme_id='ONET'
AND occupation.release_id=row.release_id AND occupation.current=true
AND occupation.content_hash=row.occupation_content_hash
MERGE (posting)-[object:INFERRED_ONET_OCCUPATION {id:row.edge_id}]-&gt;(occupation)
ON CREATE SET object.managed_by='jobtology-onet-matching-v1'
WITH row,expected_properties,object WHERE object.managed_by='jobtology-onet-matching-v1'
FOREACH (key IN [key IN keys(object) WHERE NOT key IN [p IN expected_properties | p.key]] | SET object[key]=null)
FOREACH (property IN expected_properties | SET object[property.key]=property.value)
RETURN count(object)=size($rows) AND count(DISTINCT row.edge_id)=size($rows) AS verified</cypher>
    <batch_size>500</batch_size>
    <read_only>N</read_only>
    <retry>N</retry>
    <nr_retries_on_error>0</nr_retries_on_error>
    <cypher_from_field>N</cypher_from_field>
    <unwind>Y</unwind>
    <returning_graph>N</returning_graph>
    <unwind_map>rows</unwind_map>
    <mappings>
      <mapping>
        <parameter>database_id</parameter>
        <field>database_id</field>
        <type>String</type>
      </mapping>
      <mapping>
        <parameter>edge_id</parameter>
        <field>edge_id</field>
        <type>String</type>
      </mapping>
      <mapping>
        <parameter>posting_identity</parameter>
        <field>posting_identity</field>
        <type>String</type>
      </mapping>
      <mapping>
        <parameter>occupation_identity</parameter>
        <field>occupation_identity</field>
        <type>String</type>
      </mapping>
      <mapping>
        <parameter>source_facts_sha256</parameter>
        <field>source_facts_sha256</field>
        <type>String</type>
      </mapping>
      <mapping>
        <parameter>release_id</parameter>
        <field>release_id</field>
        <type>String</type>
      </mapping>
      <mapping>
        <parameter>occupation_content_hash</parameter>
        <field>occupation_content_hash</field>
        <type>String</type>
      </mapping>
      <mapping>
        <parameter>property_data</parameter>
        <field>property_data</field>
        <type>String</type>
      </mapping>
      <mapping>
        <parameter>property_count</parameter>
        <field>property_count</field>
        <type>Integer</type>
      </mapping>
    </mappings>
    <returns>
      <return>
        <name>verified</name>
        <type>Boolean</type>
        <source_type>Boolean</source_type>
      </return>
    </returns>
    <GUI>
      <xloc>770</xloc>
      <yloc>100</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
    <copies>1</copies>
    <distribute>Y</distribute>
  </transform>
  <transform>
    <type>FilterRows</type>
    <name>Require exact graph result</name>
    <send_true_to>Require exact graph result accepted</send_true_to>
    <send_false_to>Require exact graph result rejected</send_false_to>
    <compare>
      <condition>
        <negated>N</negated>
        <operator>-</operator>
        <leftvalue>verified</leftvalue>
        <function>=</function>
        <value>
          <name>constant</name>
          <type>Boolean</type>
          <text>Y</text>
          <length>-1</length>
          <precision>-1</precision>
          <isnull>N</isnull>
        </value>
      </condition>
    </compare>
    <GUI>
      <xloc>1000</xloc>
      <yloc>100</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
    <copies>1</copies>
    <distribute>Y</distribute>
  </transform>
  <transform>
    <type>Dummy</type>
    <name>Require exact graph result accepted</name>
    <GUI>
      <xloc>1230</xloc>
      <yloc>100</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
    <copies>1</copies>
    <distribute>Y</distribute>
  </transform>
  <transform>
    <type>Abort</type>
    <name>Require exact graph result rejected</name>
    <message>O*NET catalogue graph differs from its exact owned PostgreSQL inventory.</message>
    <always_log_rows>N</always_log_rows>
    <abort_option>ABORT_WITH_ERROR</abort_option>
    <row_threshold>0</row_threshold>
    <GUI>
      <xloc>1460</xloc>
      <yloc>100</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
    <copies>1</copies>
    <distribute>Y</distribute>
  </transform>
  <transform_error_handling />
  <attributes />
</pipeline>