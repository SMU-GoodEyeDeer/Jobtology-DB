<?xml version='1.0' encoding='UTF-8'?>
<workflow>
  <name>execute_matches</name>
  <description>Separate O*NET inferred occupation operation; frozen local evidence, bounded accounting and explicit review.</description>
  <workflow_version>1</workflow_version>
  <workflow_status>0</workflow_status>
  <parameters>
    <parameter>
      <name>ONET_BATCH_ID</name>
      <default_value />
      <description>ONET_BATCH_ID</description>
    </parameter>
    <parameter>
      <name>ONET_RESUME</name>
      <default_value>N</default_value>
      <description>ONET_RESUME</description>
    </parameter>
    <parameter>
      <name>REQUEST_WORKERS</name>
      <default_value>1</default_value>
      <description>REQUEST_WORKERS</description>
    </parameter>
    <parameter>
      <name>API_KEY_FILE</name>
      <default_value>${HOP_CONFIG_FOLDER}/secrets/openrouter.csv</default_value>
      <description>API_KEY_FILE</description>
    </parameter>
    <parameter>
      <name>ONET_EXECUTION_TOKEN</name>
      <default_value />
      <description>ONET_EXECUTION_TOKEN</description>
    </parameter>
  </parameters>
  <actions>
    <action>
      <name>Start</name>
      <type>SPECIAL</type>
      <xloc>80</xloc>
      <yloc>80</yloc>
      <draw>Y</draw>
      <parallel>N</parallel>
      <attributes />
      <start>Y</start>
      <repeat>N</repeat>
      <schedulerType>0</schedulerType>
      <intervalSeconds>0</intervalSeconds>
      <intervalMinutes>60</intervalMinutes>
      <DayOfMonth>1</DayOfMonth>
      <weekDay>1</weekDay>
      <minutes>0</minutes>
      <hour>12</hour>
    </action>
    <action>
      <name>Success</name>
      <type>SUCCESS</type>
      <xloc>560</xloc>
      <yloc>560</yloc>
      <draw>Y</draw>
      <parallel>N</parallel>
      <attributes />
    </action>
    <action>
      <name>Abort</name>
      <type>ABORT</type>
      <xloc>1040</xloc>
      <yloc>560</yloc>
      <draw>Y</draw>
      <parallel>N</parallel>
      <attributes />
      <message>O*NET catalogue import or graph verification failed. Replay the exact frozen bundle after inspecting its own failed attempt.</message>
    </action>
    <action>
      <name>Own bounded dispatcher</name>
      <type>PIPELINE</type>
      <xloc>100</xloc>
      <yloc>200</yloc>
      <draw>Y</draw>
      <parallel>N</parallel>
      <attributes />
      <filename>${PROJECT_HOME}/llm/onet/start_execution.hpl</filename>
      <params_from_previous>N</params_from_previous>
      <exec_per_row>N</exec_per_row>
      <clear_rows>N</clear_rows>
      <clear_files>N</clear_files>
      <set_logfile>N</set_logfile>
      <loglevel>Basic</loglevel>
      <wait_until_finished>Y</wait_until_finished>
      <run_configuration>onet-local</run_configuration>
      <parameters>
        <pass_all_parameters>Y</pass_all_parameters>
      </parameters>
    </action>
    <action>
      <name>Run bounded requests</name>
      <type>PIPELINE</type>
      <xloc>100</xloc>
      <yloc>200</yloc>
      <draw>Y</draw>
      <parallel>N</parallel>
      <attributes />
      <filename>${PROJECT_HOME}/llm/onet/run_requests.hpl</filename>
      <params_from_previous>N</params_from_previous>
      <exec_per_row>N</exec_per_row>
      <clear_rows>N</clear_rows>
      <clear_files>N</clear_files>
      <set_logfile>N</set_logfile>
      <loglevel>Basic</loglevel>
      <wait_until_finished>Y</wait_until_finished>
      <run_configuration>onet-local</run_configuration>
      <parameters>
        <pass_all_parameters>Y</pass_all_parameters>
      </parameters>
    </action>
    <action>
      <name>Settle dispatcher</name>
      <type>PIPELINE</type>
      <xloc>100</xloc>
      <yloc>200</yloc>
      <draw>Y</draw>
      <parallel>N</parallel>
      <attributes />
      <filename>${PROJECT_HOME}/llm/onet/end_execution.hpl</filename>
      <params_from_previous>N</params_from_previous>
      <exec_per_row>N</exec_per_row>
      <clear_rows>N</clear_rows>
      <clear_files>N</clear_files>
      <set_logfile>N</set_logfile>
      <loglevel>Basic</loglevel>
      <wait_until_finished>Y</wait_until_finished>
      <run_configuration>onet-local</run_configuration>
      <parameters>
        <pass_all_parameters>Y</pass_all_parameters>
      </parameters>
    </action>
  </actions>
  <hops>
    <hop>
      <from>Start</from>
      <to>Own bounded dispatcher</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>Y</unconditional>
    </hop>
    <hop>
      <from>Own bounded dispatcher</from>
      <to>Abort</to>
      <enabled>Y</enabled>
      <evaluation>N</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Own bounded dispatcher</from>
      <to>Run bounded requests</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Run bounded requests</from>
      <to>Abort</to>
      <enabled>Y</enabled>
      <evaluation>N</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Run bounded requests</from>
      <to>Settle dispatcher</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Settle dispatcher</from>
      <to>Abort</to>
      <enabled>Y</enabled>
      <evaluation>N</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Settle dispatcher</from>
      <to>Success</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
  </hops>
  <notepads />
  <attributes />
</workflow>