<?xml version='1.0' encoding='UTF-8'?>
<pipeline>
  <info>
    <name>start_execution</name>
    <description>Own an initial dispatcher or resume only never-sent requests after process cleanup.</description>
    <pipeline_type>Normal</pipeline_type>
    <size_rowset>1000</size_rowset>
    <parameters />
  </info>
  <notepads />
  <order>
    <hop>
      <from>Exact O*NET operation options</from>
      <to>Own O*NET execution</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Own O*NET execution</from>
      <to>Remember exact catalogue token</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <type>GetVariable</type>
    <name>Exact O*NET operation options</name>
    <fields>
      <field>
        <name>batch_id</name>
        <variable>${ONET_BATCH_ID}</variable>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
      </field>
      <field>
        <name>workers</name>
        <variable>${REQUEST_WORKERS}</variable>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
      </field>
      <field>
        <name>resume</name>
        <variable>${ONET_RESUME}</variable>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
      </field>
    </fields>
    <GUI>
      <xloc>80</xloc>
      <yloc>100</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
    <copies>1</copies>
    <distribute>Y</distribute>
  </transform>
  <transform>
    <type>DBJoin</type>
    <name>Own O*NET execution</name>
    <connection>jobtology-postgres</connection>
    <sql>SELECT started-&gt;&gt;'execution_token' AS execution_token FROM (SELECT onet_matching.start_execution(?,?::integer,?='Y') AS started) s</sql>
    <cache>N</cache>
    <cache_size>0</cache_size>
    <rowlimit>0</rowlimit>
    <outer_join>N</outer_join>
    <replace_vars>N</replace_vars>
    <parameter>
      <field>
        <name>batch_id</name>
        <type>String</type>
      </field>
      <field>
        <name>workers</name>
        <type>String</type>
      </field>
      <field>
        <name>resume</name>
        <type>String</type>
      </field>
    </parameter>
    <GUI>
      <xloc>310</xloc>
      <yloc>100</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
    <copies>1</copies>
    <distribute>Y</distribute>
  </transform>
  <transform>
    <type>SetVariable</type>
    <name>Remember exact catalogue token</name>
    <use_formatting>Y</use_formatting>
    <fields>
      <field>
        <field_name>execution_token</field_name>
        <variable_name>ONET_EXECUTION_TOKEN</variable_name>
        <variable_type>PARENT_WORKFLOW</variable_type>
        <default_value />
      </field>
    </fields>
    <GUI>
      <xloc>540</xloc>
      <yloc>100</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
    <copies>1</copies>
    <distribute>Y</distribute>
  </transform>
  <transform_error_handling />
  <attributes />
</pipeline>