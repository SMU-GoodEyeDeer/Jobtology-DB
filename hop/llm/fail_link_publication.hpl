<?xml version='1.0' encoding='UTF-8'?>
<pipeline>
  <info>
    <name>fail_link_publication</name>
    <description>Mark a failed publication unavailable and release its own writer lease.</description>
    <pipeline_type>Normal</pipeline_type>
    <size_rowset>100</size_rowset>
    <parameters />
  </info>
  <notepads />
  <order>
    <hop>
      <from>Publication</from>
      <to>Hide incomplete projection</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Hide incomplete projection</from>
      <to>Record failed publication</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <type>GetVariable</type>
    <name>Publication</name>
    <fields>
      <field>
        <name>publication_id</name>
        <variable>${LINK_PUBLICATION_ID}</variable>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
      </field>
    </fields>
    <copies>1</copies>
    <distribute>Y</distribute>
    <GUI>
      <xloc>80</xloc>
      <yloc>80</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
  </transform>
  <transform>
    <type>Neo4jCypherOutput</type>
    <name>Hide incomplete projection</name>
    <connection>${NEO4J_CONNECTION}</connection>
    <cypher>MATCH (m:reviewedNcsPublication {id:'jobtology-reviewed-ncs',publication_id:$publication_id}) SET m.state='FAILED'</cypher>
    <batch_size>1</batch_size>
    <read_only>N</read_only>
    <retry>N</retry>
    <nr_retries_on_error>0</nr_retries_on_error>
    <cypher_from_field>N</cypher_from_field>
    <unwind>N</unwind>
    <returning_graph>N</returning_graph>
    <mappings>
      <mapping>
        <parameter>publication_id</parameter>
        <field>publication_id</field>
        <type>String</type>
      </mapping>
    </mappings>
    <returns />
    <copies>1</copies>
    <distribute>Y</distribute>
    <GUI>
      <xloc>320</xloc>
      <yloc>80</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
  </transform>
  <transform>
    <type>ExecSql</type>
    <name>Record failed publication</name>
    <connection>jobtology-postgres</connection>
    <sql>SELECT enrichment.finish_link_publication(?,false)</sql>
    <execute_each_row>Y</execute_each_row>
    <single_statement>Y</single_statement>
    <set_params>Y</set_params>
    <replace_variables>N</replace_variables>
    <quoteString>N</quoteString>
    <arguments>
      <argument>
        <name>publication_id</name>
      </argument>
    </arguments>
    <copies>1</copies>
    <distribute>Y</distribute>
    <GUI>
      <xloc>560</xloc>
      <yloc>80</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
  </transform>
  <transform_error_handling />
  <attributes />
</pipeline>