<?xml version='1.0' encoding='UTF-8'?>
<pipeline>
  <info>
    <name>start_revision_batch</name>
    <description>Pin accepted extraction revisions for NCS-only requests.</description>
    <pipeline_type>Normal</pipeline_type>
    <size_rowset>100</size_rowset>
    <parameters />
  </info>
  <notepads />
  <order>
    <hop>
      <from>Workflow options</from>
      <to>Build immutable settings</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Build immutable settings</from>
      <to>Remember batch ID</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Remember batch ID</from>
      <to>Plan batch</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Plan batch</from>
      <to>Batch created</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <type>GetVariable</type>
    <name>Workflow options</name>
    <fields>
      <field>
        <name>run_mode</name>
        <variable>ENRICH</variable>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
      </field>
      <field>
        <name>job_run_id</name>
        <variable>${JOB_RUN_ID}</variable>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
      </field>
      <field>
        <name>job_source_id</name>
        <variable>${JOB_SOURCE_ID}</variable>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
      </field>
      <field>
        <name>ncs_run_id</name>
        <variable>${NCS_RUN_ID}</variable>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
      </field>
      <field>
        <name>dataset_id</name>
        <variable />
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
      </field>
      <field>
        <name>extract_model</name>
        <variable>unused/reviewed-extraction</variable>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
      </field>
      <field>
        <name>categorize_model</name>
        <variable>${CATEGORIZE_MODEL}</variable>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
      </field>
      <field>
        <name>provider_only</name>
        <variable>${PROVIDER_ONLY}</variable>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
      </field>
      <field>
        <name>prompt_version</name>
        <variable>${PROMPT_VERSION}</variable>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
      </field>
      <field>
        <name>temperature</name>
        <variable>${TEMPERATURE}</variable>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
      </field>
      <field>
        <name>reasoning_effort</name>
        <variable>${REASONING_EFFORT}</variable>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
      </field>
      <field>
        <name>extra_params_json</name>
        <variable>${EXTRA_PARAMS_JSON}</variable>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
      </field>
      <field>
        <name>posting_ids</name>
        <variable />
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
      </field>
      <field>
        <name>input_bundle_ids</name>
        <variable>${INPUT_BUNDLE_IDS}</variable>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
      </field>
      <field>
        <name>repair_batch_id</name>
        <variable />
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
      </field>
      <field>
        <name>posting_limit</name>
        <variable>${POSTING_LIMIT}</variable>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
      </field>
      <field>
        <name>candidate_limit</name>
        <variable>${CANDIDATE_LIMIT}</variable>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
      </field>
      <field>
        <name>max_matches</name>
        <variable>${MAX_MATCHES}</variable>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
      </field>
      <field>
        <name>max_input_chars</name>
        <variable>${MAX_INPUT_CHARS}</variable>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
      </field>
      <field>
        <name>max_output_tokens</name>
        <variable>${MAX_OUTPUT_TOKENS}</variable>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
      </field>
      <field>
        <name>max_requests</name>
        <variable>${MAX_REQUESTS}</variable>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
      </field>
      <field>
        <name>request_reserve_usd</name>
        <variable>${REQUEST_RESERVE_USD}</variable>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
      </field>
      <field>
        <name>max_cost_usd</name>
        <variable>${MAX_COST_USD}</variable>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
      </field>
      <field>
        <name>daily_budget_usd</name>
        <variable>${DAILY_BUDGET_USD}</variable>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
      </field>
      <field>
        <name>execute_requests</name>
        <variable>${EXECUTE_REQUESTS}</variable>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
      </field>
      <field>
        <name>reuse_cache</name>
        <variable>${REUSE_CACHE}</variable>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
      </field>
      <field>
        <name>acceptance_policy</name>
        <variable>${ACCEPTANCE_POLICY}</variable>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
      </field>
      <field>
        <name>endpoint</name>
        <variable>${ENDPOINT}</variable>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
      </field>
      <field>
        <name>api_key_file</name>
        <variable>${API_KEY_FILE}</variable>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
      </field>
      <field>
        <name>request_delay_ms</name>
        <variable>${REQUEST_DELAY_MS}</variable>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
      </field>
      <field>
        <name>read_timeout_ms</name>
        <variable>${READ_TIMEOUT_MS}</variable>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
      </field>
      <field>
        <name>revision_ids</name>
        <variable>${REVISION_IDS}</variable>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
      </field>
      <field>
        <name>actor</name>
        <variable>${ACTOR}</variable>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
      </field>
    </fields>
    <copies>1</copies>
    <distribute>Y</distribute>
    <GUI>
      <xloc>80</xloc>
      <yloc>80</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
  </transform>
  <transform>
    <type>DBJoin</type>
    <name>Build immutable settings</name>
    <connection>jobtology-postgres</connection>
    <sql>SELECT gen_random_uuid()::text AS batch_id,
jsonb_strip_nulls(jsonb_build_object('job_source_id',?::text,'extract_model',?::text,'categorize_model',?::text,'provider_only',nullif(?::text,''),'prompt_version',?::text,
'temperature',nullif(?::text,''),'reasoning_effort',nullif(?::text,''),'extra_params',?::jsonb,
'limit',?::integer,'candidate_limit',?::integer,'max_matches',?::integer,'max_input_chars',?::integer,
'max_output_tokens',?::integer,'max_requests',?::integer,'request_reserve_usd',?::numeric,'max_cost_usd',?::numeric,
'daily_budget_usd',?::numeric,'execute_requests',?::text,'reuse_cache',?::text,'endpoint',?::text,
'request_delay_ms',?::integer,'read_timeout_ms',?::integer,'acceptance_policy',?::text,'posting_ids',nullif(?::text,''),'repair_batch_id',nullif(?::text,''),'input_bundle_ids',nullif(?::text,'')))::text AS settings_json</sql>
    <cache>N</cache>
    <cache_size>0</cache_size>
    <rowlimit>0</rowlimit>
    <outer_join>N</outer_join>
    <replace_vars>N</replace_vars>
    <parameter>
      <field>
        <name>job_source_id</name>
        <type>String</type>
      </field>
      <field>
        <name>extract_model</name>
        <type>String</type>
      </field>
      <field>
        <name>categorize_model</name>
        <type>String</type>
      </field>
      <field>
        <name>provider_only</name>
        <type>String</type>
      </field>
      <field>
        <name>prompt_version</name>
        <type>String</type>
      </field>
      <field>
        <name>temperature</name>
        <type>String</type>
      </field>
      <field>
        <name>reasoning_effort</name>
        <type>String</type>
      </field>
      <field>
        <name>extra_params_json</name>
        <type>String</type>
      </field>
      <field>
        <name>posting_limit</name>
        <type>String</type>
      </field>
      <field>
        <name>candidate_limit</name>
        <type>String</type>
      </field>
      <field>
        <name>max_matches</name>
        <type>String</type>
      </field>
      <field>
        <name>max_input_chars</name>
        <type>String</type>
      </field>
      <field>
        <name>max_output_tokens</name>
        <type>String</type>
      </field>
      <field>
        <name>max_requests</name>
        <type>String</type>
      </field>
      <field>
        <name>request_reserve_usd</name>
        <type>String</type>
      </field>
      <field>
        <name>max_cost_usd</name>
        <type>String</type>
      </field>
      <field>
        <name>daily_budget_usd</name>
        <type>String</type>
      </field>
      <field>
        <name>execute_requests</name>
        <type>String</type>
      </field>
      <field>
        <name>reuse_cache</name>
        <type>String</type>
      </field>
      <field>
        <name>endpoint</name>
        <type>String</type>
      </field>
      <field>
        <name>request_delay_ms</name>
        <type>String</type>
      </field>
      <field>
        <name>read_timeout_ms</name>
        <type>String</type>
      </field>
      <field>
        <name>acceptance_policy</name>
        <type>String</type>
      </field>
      <field>
        <name>posting_ids</name>
        <type>String</type>
      </field>
      <field>
        <name>repair_batch_id</name>
        <type>String</type>
      </field>
      <field>
        <name>input_bundle_ids</name>
        <type>String</type>
      </field>
    </parameter>
    <copies>1</copies>
    <distribute>Y</distribute>
    <GUI>
      <xloc>320</xloc>
      <yloc>80</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
  </transform>
  <transform>
    <type>SetVariable</type>
    <name>Remember batch ID</name>
    <use_formatting>Y</use_formatting>
    <fields>
      <field>
        <field_name>batch_id</field_name>
        <variable_name>LLM_BATCH_ID</variable_name>
        <variable_type>PARENT_WORKFLOW</variable_type>
        <default_value />
      </field>
    </fields>
    <copies>1</copies>
    <distribute>Y</distribute>
    <GUI>
      <xloc>560</xloc>
      <yloc>80</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
  </transform>
  <transform>
    <type>ExecSql</type>
    <name>Plan batch</name>
    <connection>jobtology-postgres</connection>
    <sql>SELECT enrichment.plan_revision_batch(?,?,?,?::jsonb||jsonb_build_object('actor',?::text),?)</sql>
    <execute_each_row>Y</execute_each_row>
    <single_statement>Y</single_statement>
    <set_params>Y</set_params>
    <replace_variables>N</replace_variables>
    <quoteString>N</quoteString>
    <arguments>
      <argument>
        <name>batch_id</name>
      </argument>
      <argument>
        <name>job_run_id</name>
      </argument>
      <argument>
        <name>ncs_run_id</name>
      </argument>
      <argument>
        <name>settings_json</name>
      </argument>
      <argument>
        <name>actor</name>
      </argument>
      <argument>
        <name>revision_ids</name>
      </argument>
    </arguments>
    <copies>1</copies>
    <distribute>Y</distribute>
    <GUI>
      <xloc>800</xloc>
      <yloc>80</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
  </transform>
  <transform>
    <type>WriteToLog</type>
    <name>Batch created</name>
    <loglevel>Basic</loglevel>
    <displayHeader>Y</displayHeader>
    <logmessage>LLM batch created; inspect enrichment.batch_report</logmessage>
    <fields>
      <field>
        <name>batch_id</name>
      </field>
      <field>
        <name>run_mode</name>
      </field>
      <field>
        <name>execute_requests</name>
      </field>
    </fields>
    <copies>1</copies>
    <distribute>Y</distribute>
    <GUI>
      <xloc>1040</xloc>
      <yloc>80</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
  </transform>
  <transform_error_handling />
  <attributes />
</pipeline>