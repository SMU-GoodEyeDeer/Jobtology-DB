<?xml version='1.0' encoding='UTF-8'?>
<workflow>
  <name>Review one extraction</name>
  <description>Review one extraction</description>
  <workflow_version>1</workflow_version>
  <workflow_status>0</workflow_status>
  <parameters>
    <parameter>
      <name>REVISION_ID</name>
      <default_value />
      <description>Exact immutable revision/candidate ID.</description>
    </parameter>
    <parameter>
      <name>DECISION</name>
      <default_value>REJECT</default_value>
      <description>ACCEPT or REJECT.</description>
    </parameter>
    <parameter>
      <name>REVIEWER</name>
      <default_value />
      <description>Stable reviewer identity.</description>
    </parameter>
    <parameter>
      <name>REVIEWER_KIND</name>
      <default_value>human</default_value>
      <description>human, assistant or policy; automation must identify itself accurately.</description>
    </parameter>
    <parameter>
      <name>NOTES</name>
      <default_value />
      <description>Required evidence-based rationale.</description>
    </parameter>
  </parameters>
  <actions>
    <action>
      <name>Start</name>
      <type>SPECIAL</type>
      <xloc>80</xloc>
      <yloc>80</yloc>
      <draw>Y</draw>
      <parallel>N</parallel>
      <attributes />
      <start>Y</start>
      <repeat>N</repeat>
      <schedulerType>0</schedulerType>
      <intervalSeconds>0</intervalSeconds>
      <intervalMinutes>60</intervalMinutes>
      <DayOfMonth>1</DayOfMonth>
      <weekDay>1</weekDay>
      <minutes>0</minutes>
      <hour>12</hour>
    </action>
    <action>
      <name>Record independent review</name>
      <type>PIPELINE</type>
      <xloc>320</xloc>
      <yloc>80</yloc>
      <draw>Y</draw>
      <parallel>N</parallel>
      <attributes />
      <filename>${PROJECT_HOME}/llm/review_extraction.hpl</filename>
      <params_from_previous>N</params_from_previous>
      <exec_per_row>N</exec_per_row>
      <clear_rows>N</clear_rows>
      <clear_files>N</clear_files>
      <set_logfile>N</set_logfile>
      <loglevel>Basic</loglevel>
      <wait_until_finished>Y</wait_until_finished>
      <run_configuration>llm-local</run_configuration>
      <parameters>
        <pass_all_parameters>Y</pass_all_parameters>
      </parameters>
    </action>
    <action>
      <name>Success</name>
      <type>SUCCESS</type>
      <xloc>560</xloc>
      <yloc>80</yloc>
      <draw>Y</draw>
      <parallel>N</parallel>
      <attributes />
    </action>
    <action>
      <name>Abort</name>
      <type>ABORT</type>
      <xloc>1040</xloc>
      <yloc>80</yloc>
      <draw>Y</draw>
      <parallel>N</parallel>
      <attributes />
      <message>LLM workflow failed. Inspect enrichment.batch_report and enrichment.attempt.</message>
    </action>
  </actions>
  <hops>
    <hop>
      <from>Start</from>
      <to>Record independent review</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>Y</unconditional>
    </hop>
    <hop>
      <from>Record independent review</from>
      <to>Abort</to>
      <enabled>Y</enabled>
      <evaluation>N</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Record independent review</from>
      <to>Success</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
  </hops>
  <notepads />
  <attributes />
</workflow>