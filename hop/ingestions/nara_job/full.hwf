<?xml version='1.0' encoding='UTF-8'?>
<workflow>
  <name>나라일터 postings</name>
  <name_sync_with_filename>N</name_sync_with_filename>
  <description>Fetch a bounded recent index and all detail, position and file metadata for postings open at the snapshot date.</description>
  <extended_description>Use nara-job-local and Basic logging. FULL fetches every posting; SMOKE fetches page one and its details, and remains REVIEW_REQUIRED. Every invocation creates a new snapshot.</extended_description>
  <created_user>-</created_user>
  <modified_user>-</modified_user>
  <created_date>2026/09/11 06:30:11.460</created_date>
  <modified_date>2026/09/11 06:30:11.460</modified_date>
  <workflow_version>1</workflow_version>
  <parameters>
    <parameter>
      <name>MAX_PAGES</name>
      <description>Maximum recent-window list pages.</description>
      <default_value>20</default_value>
    </parameter>
    <parameter>
      <name>BEGIN_DATE</name>
      <description>YYYY-MM-DD; blank means 120 days before the KST run date.</description>
      <default_value />
    </parameter>
    <parameter>
      <name>END_DATE</name>
      <description>YYYY-MM-DD; blank means the KST run date.</description>
      <default_value />
    </parameter>
    <parameter>
      <name>RAW_ROOT</name>
      <description>Persistent raw response directory.</description>
      <default_value>${PROJECT_HOME}/data/nara-job-raw</default_value>
    </parameter>
    <parameter>
      <name>MAX_REQUESTS</name>
      <description>List plus three companion requests per active posting; maximum 10000.</description>
      <default_value>5000</default_value>
    </parameter>
    <parameter>
      <name>MODE</name>
      <description>FULL makes a READY snapshot; SMOKE remains REVIEW_REQUIRED.</description>
      <default_value>FULL</default_value>
    </parameter>
    <parameter>
      <name>API_KEY_FILE</name>
      <description>CSV with service_key header and one decoded key.</description>
      <default_value>${HOP_CONFIG_FOLDER}/secrets/data-go-kr.csv</default_value>
    </parameter>
  </parameters>
