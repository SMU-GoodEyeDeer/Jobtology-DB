<?xml version='1.0' encoding='UTF-8'?>
<pipeline>
  <info>
    <name>start_run</name>
    <description>Create a 나라일터 snapshot and pin exactly one accepted ALIO employer snapshot.</description>
    <pipeline_type>Normal</pipeline_type>
    <size_rowset>1000</size_rowset>
    <parameters />
  </info>
  <notepads />
  <order>
    <hop>
      <from>Run options</from>
      <to>Resolve date window</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Resolve date window</from>
      <to>Valid options</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Valid options</from>
      <to>Date window resolved</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Remember run ID</from>
      <to>Create run and index</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Create run and index</from>
      <to>Run started</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Date window resolved</from>
      <to>Remember run ID</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Valid options</from>
      <to>Invalid options</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Date window resolved</from>
      <to>Invalid options</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <type>GetVariable</type>
    <name>Run options</name>
    <fields>
      <field>
        <name>mode</name>
        <variable>${MODE}</variable>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
      </field>
      <field>
        <name>raw_root</name>
        <variable>${RAW_ROOT}</variable>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
      </field>
      <field>
        <name>begin_choice</name>
        <variable>${BEGIN_DATE}</variable>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
      </field>
      <field>
        <name>end_choice</name>
        <variable>${END_DATE}</variable>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
      </field>
      <field>
        <name>max_pages</name>
        <variable>${MAX_PAGES}</variable>
        <type>Integer</type>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
      </field>
      <field>
        <name>max_requests</name>
        <variable>${MAX_REQUESTS}</variable>
        <type>Integer</type>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
      </field>
    </fields>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>100</xloc>
      <yloc>100</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
  </transform>
  <transform>
    <type>DBJoin</type>
    <name>Resolve date window</name>
    <cache>N</cache>
    <cache_size>0</cache_size>
    <sql>WITH raw AS (SELECT ?::text mode,?::text raw_root,?::text begin_choice,?::text end_choice,?::integer max_pages,?::integer max_requests),
dates AS (SELECT *,CASE WHEN coalesce(begin_choice,'')='' THEN ((clock_timestamp() AT TIME ZONE 'Asia/Seoul')::date-120) WHEN begin_choice~'^[0-9]{4}-[0-9]{2}-[0-9]{2}$' THEN begin_choice::date END begin_date,
 CASE WHEN coalesce(end_choice,'')='' THEN (clock_timestamp() AT TIME ZONE 'Asia/Seoul')::date WHEN end_choice~'^[0-9]{4}-[0-9]{2}-[0-9]{2}$' THEN end_choice::date END end_date FROM raw)
SELECT gen_random_uuid()::text run_id,'nara_job'::text upstream_run_id,begin_date,end_date,
 mode IN('FULL','SMOKE') AND nullif(raw_root,'') IS NOT NULL AND begin_date IS NOT NULL AND end_date IS NOT NULL
 AND begin_date&lt;=end_date AND max_pages BETWEEN 1 AND 100 AND max_requests BETWEEN 1 AND 10000 AS options_ok FROM dates</sql>
    <rowlimit>0</rowlimit>
    <outer_join>N</outer_join>
    <parameter>
      <field>
        <name>mode</name>
        <type>String</type>
      </field>
      <field>
        <name>raw_root</name>
        <type>String</type>
      </field>
      <field>
        <name>begin_choice</name>
        <type>String</type>
      </field>
      <field>
        <name>end_choice</name>
        <type>String</type>
      </field>
      <field>
        <name>max_pages</name>
        <type>Integer</type>
      </field>
      <field>
        <name>max_requests</name>
        <type>Integer</type>
      </field>
    </parameter>
    <replace_vars>N</replace_vars>
    <connection>jobtology-postgres</connection>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>330</xloc>
      <yloc>100</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
  </transform>
  <transform>
    <type>FilterRows</type>
    <name>Valid options</name>
    <compare>
      <condition>
        <negated>N</negated>
        <operator>-</operator>
        <leftvalue>options_ok</leftvalue>
        <function>=</function>
        <value>
          <name>constant</name>
          <type>Boolean</type>
          <text>Y</text>
          <length>-1</length>
          <precision>-1</precision>
          <isnull>N</isnull>
        </value>
      </condition>
    </compare>
    <send_true_to>Date window resolved</send_true_to>
    <send_false_to>Invalid options</send_false_to>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>560</xloc>
      <yloc>100</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
  </transform>
  <transform>
    <type>FilterRows</type>
    <name>Date window resolved</name>
    <compare>
      <condition>
        <negated>N</negated>
        <operator>-</operator>
        <leftvalue>upstream_run_id</leftvalue>
        <function>IS NULL</function>
      </condition>
    </compare>
    <send_true_to>Invalid options</send_true_to>
    <send_false_to>Remember run ID</send_false_to>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>790</xloc>
      <yloc>100</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
  </transform>
  <transform>
    <type>SetVariable</type>
    <name>Remember run ID</name>
    <fields>
      <field>
        <field_name>run_id</field_name>
        <variable_name>NARA_JOB_RUN_ID</variable_name>
        <variable_type>PARENT_WORKFLOW</variable_type>
        <default_value />
      </field>
    </fields>
    <use_formatting>Y</use_formatting>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>1020</xloc>
      <yloc>100</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
  </transform>
  <transform>
    <type>ExecSql</type>
    <name>Create run and index</name>
    <sql>WITH new_run AS (
 INSERT INTO ingestion.run(run_id,source_id,mode,parser_version,policy_revision)
 VALUES(?,'nara_job',?,'hop-nara-job-v1','2026-09-16.1') RETURNING run_id)
INSERT INTO ingestion.partition(run_id,partition_id,kind,request_context,page_size)
SELECT run_id,'index','PAGED',jsonb_build_object('resource','list','begin_date',to_char(?::date,'YYYYMMDD'),
 'end_date',to_char(?::date,'YYYYMMDD'),'as_of',to_char(?::date,'YYYYMMDD')),1000 FROM new_run</sql>
    <execute_each_row>Y</execute_each_row>
    <single_statement>Y</single_statement>
    <replace_variables>N</replace_variables>
    <quoteString>N</quoteString>
    <set_params>Y</set_params>
    <arguments>
      <argument>
        <name>run_id</name>
      </argument>
      <argument>
        <name>mode</name>
      </argument>
      <argument>
        <name>begin_date</name>
      </argument>
      <argument>
        <name>end_date</name>
      </argument>
      <argument>
        <name>end_date</name>
      </argument>
    </arguments>
    <connection>jobtology-postgres</connection>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>100</xloc>
      <yloc>270</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
  </transform>
  <transform>
    <type>WriteToLog</type>
    <name>Run started</name>
    <displayHeader>Y</displayHeader>
    <limitRows>N</limitRows>
    <limitRowsNumber>0</limitRowsNumber>
    <logmessage>나라일터 run created; employer snapshot pinned</logmessage>
    <loglevel>Basic</loglevel>
    <fields>
      <field>
        <name>run_id</name>
      </field>
      <field>
        <name>mode</name>
      </field>
      <field>
        <name>upstream_run_id</name>
      </field>
    </fields>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>330</xloc>
      <yloc>270</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
  </transform>
  <transform>
    <type>Abort</type>
    <name>Invalid options</name>
    <row_threshold>0</row_threshold>
    <message>Require FULL/SMOKE, a raw directory, valid YYYY-MM-DD bounds, and request limits within provider quota.</message>
    <always_log_rows>N</always_log_rows>
    <abort_option>ABORT_WITH_ERROR</abort_option>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>560</xloc>
      <yloc>270</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
  </transform>
  <transform_error_handling />
  <attributes />
</pipeline>