    <cache>N</cache>
    <cache_size>0</cache_size>
    <sql>SELECT * FROM ingestion.reserve_request(?,?,?::integer,?::integer,?::integer)</sql>
    <rowlimit>0</rowlimit>
    <outer_join>N</outer_join>
    <parameter>
      <field>
        <name>run_id</name>
        <type>String</type>
      </field>
      <field>
        <name>partition_id</name>
        <type>String</type>
      </field>
      <field>
        <name>page_no</name>
        <type>Integer</type>
      </field>
      <field>
        <name>confirmation_no</name>
        <type>Integer</type>
      </field>
      <field>
        <name>max_requests</name>
        <type>Integer</type>
      </field>
    </parameter>
    <replace_vars>N</replace_vars>
    <connection>jobtology-postgres</connection>
    <copies>1</copies>
    <distribute>Y</distribute>
    <GUI>
      <xloc>100</xloc>
      <yloc>1200</yloc>
    </GUI>
  </transform>
  <transform>
    <type>FilterRows</type>
    <name>Request allowed</name>
    <compare>
      <condition>
        <negated>N</negated>
        <operator>-</operator>
        <leftvalue>request_allowed</leftvalue>
        <function>=</function>
        <value>
          <name>constant</name>
          <type>Boolean</type>
          <text>Y</text>
          <length>-1</length>
          <precision>-1</precision>
          <isnull>N</isnull>
        </value>
      </condition>
    </compare>
    <send_true_to>Fetch 나라일터 files</send_true_to>
    <send_false_to>Remove denied request key</send_false_to>
    <copies>1</copies>
    <distribute>Y</distribute>
    <GUI>
      <xloc>350</xloc>
      <yloc>1200</yloc>
    </GUI>
  </transform>
  <transform>
    <type>SelectValues</type>
    <name>Remove denied request key</name>
    <fields>
      <select_unspecified>Y</select_unspecified>
      <remove>
        <name>service_key</name>
      </remove>
    </fields>
    <copies>1</copies>
    <distribute>Y</distribute>
    <GUI>
      <xloc>600</xloc>
      <yloc>1200</yloc>
    </GUI>
  </transform>
  <transform>
    <type>Abort</type>
    <name>Request denied</name>
    <row_threshold>0</row_threshold>
    <message>Request quota exhausted, duplicate reservation, or run no longer LOADING. No HTTP request was sent.</message>
    <always_log_rows>N</always_log_rows>
    <abort_option>ABORT_WITH_ERROR</abort_option>
    <copies>1</copies>
    <distribute>Y</distribute>
    <GUI>
      <xloc>850</xloc>
      <yloc>1200</yloc>
    </GUI>
  </transform>
  <transform>
    <type>ExecSql</type>
    <name>Finish request accounting</name>
    <sql>UPDATE ingestion.request_attempt SET outcome='RESPONSE_ARCHIVED',completed_at=clock_timestamp() WHERE run_id=? AND partition_id=? AND page_no=? AND confirmation_no=?</sql>
    <execute_each_row>Y</execute_each_row>
    <single_statement>Y</single_statement>
    <replace_variables>N</replace_variables>
    <quoteString>N</quoteString>
    <set_params>Y</set_params>
    <arguments>
      <argument>
        <name>run_id</name>
      </argument>
      <argument>
        <name>partition_id</name>
      </argument>
      <argument>
        <name>page_no</name>
      </argument>
      <argument>
        <name>confirmation_no</name>
      </argument>
    </arguments>
    <connection>jobtology-postgres</connection>
    <copies>1</copies>
    <distribute>Y</distribute>
    <GUI>
      <xloc>1100</xloc>
      <yloc>1200</yloc>
    </GUI>
  </transform>
</pipeline>