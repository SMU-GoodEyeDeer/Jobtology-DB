<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <name>graph_start</name>
    <description>Acquire the shared writer and freeze exact current and retired O*NET inventory in PostgreSQL.</description>
    <pipeline_type>Normal</pipeline_type>
    <size_rowset>1000</size_rowset>
    <parameters />
  </info>
  <notepads />
  <order>
    <hop>
      <from>Exact catalogue options</from>
      <to>Read destination identity</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Read destination identity</from>
      <to>Create unique graph token</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Create unique graph token</from>
      <to>Remember exact catalogue token</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Remember exact catalogue token</from>
      <to>Freeze planned catalogue writer</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <type>GetVariable</type>
    <name>Exact catalogue options</name>
    <fields>
      <field>
        <name>release_id</name>
        <variable>${RELEASE_ID}</variable>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
      </field>
    </fields>
    <GUI>
      <xloc>80</xloc>
      <yloc>100</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
    <copies>1</copies>
    <distribute>Y</distribute>
  </transform>
  <transform>
    <type>Neo4jCypherOutput</type>
    <name>Read destination identity</name>
    <connection>${NEO4J_CONNECTION}</connection>
    <cypher>CALL db.info() YIELD id RETURN id AS database_id</cypher>
    <batch_size>1</batch_size>
    <read_only>Y</read_only>
    <retry>N</retry>
    <nr_retries_on_error>0</nr_retries_on_error>
    <cypher_from_field>N</cypher_from_field>
    <unwind>N</unwind>
    <returning_graph>N</returning_graph>
    <mappings />
    <returns>
      <return>
        <name>database_id</name>
        <type>String</type>
        <source_type>String</source_type>
      </return>
    </returns>
    <GUI>
      <xloc>310</xloc>
      <yloc>100</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
    <copies>1</copies>
    <distribute>Y</distribute>
  </transform>
  <transform>
    <type>DBJoin</type>
    <name>Create unique graph token</name>
    <connection>jobtology-postgres</connection>
    <sql>SELECT gen_random_uuid()::text AS load_id</sql>
    <cache>N</cache>
    <cache_size>0</cache_size>
    <rowlimit>0</rowlimit>
    <outer_join>N</outer_join>
    <replace_vars>N</replace_vars>
    <parameter />
    <GUI>
      <xloc>540</xloc>
      <yloc>100</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
    <copies>1</copies>
    <distribute>Y</distribute>
  </transform>
  <transform>
    <type>SetVariable</type>
    <name>Remember exact catalogue token</name>
    <use_formatting>Y</use_formatting>
    <fields>
      <field>
        <field_name>load_id</field_name>
        <variable_name>ONET_LOAD_ID</variable_name>
        <variable_type>PARENT_WORKFLOW</variable_type>
        <default_value />
      </field>
    </fields>
    <GUI>
      <xloc>770</xloc>
      <yloc>100</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
    <copies>1</copies>
    <distribute>Y</distribute>
  </transform>
  <transform>
    <type>ExecSql</type>
    <name>Freeze planned catalogue writer</name>
    <connection>jobtology-postgres</connection>
    <sql>SELECT onet_detail.begin_graph_load(?,?,?)</sql>
    <execute_each_row>Y</execute_each_row>
    <single_statement>Y</single_statement>
    <set_params>Y</set_params>
    <replace_variables>N</replace_variables>
    <quoteString>N</quoteString>
    <arguments>
      <argument>
        <name>release_id</name>
      </argument>
      <argument>
        <name>database_id</name>
      </argument>
      <argument>
        <name>load_id</name>
      </argument>
    </arguments>
    <GUI>
      <xloc>1000</xloc>
      <yloc>100</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
    <copies>1</copies>
    <distribute>Y</distribute>
  </transform>
  <transform_error_handling />
  <attributes />
</pipeline>