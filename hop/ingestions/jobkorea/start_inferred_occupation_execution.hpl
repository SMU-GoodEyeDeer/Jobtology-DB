<?xml version='1.0' encoding='UTF-8'?>
<pipeline>
  <info>
    <name>start_inferred_occupation_execution</name>
    <description>Start one owned dispatcher for an immutable fresh batch; reject stale holds.</description>
    <pipeline_type>Normal</pipeline_type>
    <size_rowset>100</size_rowset>
    <parameters />
  </info>
  <notepads />
  <order>
    <hop>
      <from>Pilot options</from>
      <to>Own bounded inference dispatch</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Own bounded inference dispatch</from>
      <to>Remember exact pilot pins</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Remember exact pilot pins</from>
      <to>Owned inference dispatcher</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <type>GetVariable</type>
    <name>Pilot options</name>
    <fields>
      <field>
        <name>batch_id</name>
        <variable>${METADATA_OCCUPATION_BATCH_ID}</variable>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
      </field>
      <field>
        <name>workers</name>
        <variable>${REQUEST_WORKERS}</variable>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
      </field>
    </fields>
    <GUI>
      <xloc>80</xloc>
      <yloc>100</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
    <copies>1</copies>
    <distribute>Y</distribute>
  </transform>
  <transform>
    <type>DBJoin</type>
    <name>Own bounded inference dispatch</name>
    <connection>jobtology-postgres</connection>
    <sql>SELECT started-&gt;&gt;'execution_token' AS execution_token,started::text AS dispatch_json FROM (SELECT enrichment.start_metadata_occupation_execution(?,?::integer) AS started) s</sql>
    <cache>N</cache>
    <cache_size>0</cache_size>
    <rowlimit>0</rowlimit>
    <outer_join>N</outer_join>
    <replace_vars>N</replace_vars>
    <parameter>
      <field>
        <name>batch_id</name>
        <type>String</type>
      </field>
      <field>
        <name>workers</name>
        <type>String</type>
      </field>
    </parameter>
    <GUI>
      <xloc>340</xloc>
      <yloc>100</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
    <copies>1</copies>
    <distribute>Y</distribute>
  </transform>
  <transform>
    <type>SetVariable</type>
    <name>Remember exact pilot pins</name>
    <use_formatting>Y</use_formatting>
    <fields>
      <field>
        <field_name>execution_token</field_name>
        <variable_name>METADATA_OCCUPATION_EXECUTION_TOKEN</variable_name>
        <variable_type>PARENT_WORKFLOW</variable_type>
        <default_value />
      </field>
    </fields>
    <GUI>
      <xloc>600</xloc>
      <yloc>100</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
    <copies>1</copies>
    <distribute>Y</distribute>
  </transform>
  <transform>
    <type>WriteToLog</type>
    <name>Owned inference dispatcher</name>
    <displayHeader>Y</displayHeader>
    <limitRows>N</limitRows>
    <limitRowsNumber>0</limitRowsNumber>
    <logmessage>Bounded dispatcher prepared; paid admission remains atomic in the shared ledger.</logmessage>
    <loglevel>Basic</loglevel>
    <fields>
      <field>
        <name>dispatch_json</name>
      </field>
    </fields>
    <GUI>
      <xloc>860</xloc>
      <yloc>100</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
    <copies>1</copies>
    <distribute>Y</distribute>
  </transform>
  <transform_error_handling />
  <attributes />
</pipeline>