<?xml version='1.0' encoding='UTF-8'?>
<workflow>
  <name>Install optional inferred worker admission</name>
  <description>Requires source SQL001-005 and existing LLM/retention modules. Native SQL only; no source or model requests.</description>
  <workflow_version>1</workflow_version>
  <workflow_status>0</workflow_status>
  <parameters />
  <actions>
    <action>
      <name>Start</name>
      <type>SPECIAL</type>
      <xloc>80</xloc>
      <yloc>100</yloc>
      <draw>Y</draw>
      <parallel>N</parallel>
      <attributes />
      <start>Y</start>
      <repeat>N</repeat>
      <schedulerType>0</schedulerType>
      <intervalSeconds>0</intervalSeconds>
      <intervalMinutes>60</intervalMinutes>
      <DayOfMonth>1</DayOfMonth>
      <weekDay>1</weekDay>
      <minutes>0</minutes>
      <hour>12</hour>
    </action>
    <action>
      <name>Success</name>
      <type>SUCCESS</type>
      <xloc>1700</xloc>
      <yloc>100</yloc>
      <draw>Y</draw>
      <parallel>N</parallel>
      <attributes />
    </action>
    <action>
      <name>Abort</name>
      <type>ABORT</type>
      <xloc>860</xloc>
      <yloc>300</yloc>
      <draw>Y</draw>
      <parallel>N</parallel>
      <attributes />
      <message>JobKorea adapter installation failed. Inspect the failed SQL action before replaying the installer.</message>
    </action>
    <action>
      <name>031_metadata_occupation_workers</name>
      <type>SQL</type>
      <connection>jobtology-postgres</connection>
      <sqlfromfile>Y</sqlfromfile>
      <sqlfilename>${PROJECT_HOME}/llm/sql/031_metadata_occupation_workers.sql</sqlfilename>
      <sqlfilename_encoding>UTF-8</sqlfilename_encoding>
      <useVariableSubstitution>N</useVariableSubstitution>
      <sendOneStatement>Y</sendOneStatement>
      <xloc>260</xloc>
      <yloc>100</yloc>
      <draw>Y</draw>
      <parallel>N</parallel>
    </action>
  </actions>
  <hops>
    <hop>
      <from>Start</from>
      <to>031_metadata_occupation_workers</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>031_metadata_occupation_workers</from>
      <to>Success</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>031_metadata_occupation_workers</from>
      <to>Abort</to>
      <enabled>Y</enabled>
      <evaluation>N</evaluation>
      <unconditional>N</unconditional>
    </hop>
  </hops>
  <notepads />
  <attributes />
</workflow>