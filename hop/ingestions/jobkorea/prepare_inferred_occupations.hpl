<?xml version='1.0' encoding='UTF-8'?>
<pipeline>
  <info>
    <name>prepare_inferred_occupations</name>
    <description>Freeze supplied metadata, exact NCS occupations and separate inference requests; no keys or HTTP.</description>
    <pipeline_type>Normal</pipeline_type>
    <size_rowset>100</size_rowset>
    <parameters />
  </info>
  <notepads />
  <order>
    <hop>
      <from>Pilot options</from>
      <to>Freeze inference requests</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Freeze inference requests</from>
      <to>Remember exact pilot pins</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Remember exact pilot pins</from>
      <to>Prepared inferred occupation requests</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <type>GetVariable</type>
    <name>Pilot options</name>
    <fields>
      <field>
        <name>batch_id</name>
        <variable>${BATCH_ID}</variable>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
      </field>
      <field>
        <name>job_run_id</name>
        <variable>${JOB_RUN_ID}</variable>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
      </field>
      <field>
        <name>ncs_run_id</name>
        <variable>${NCS_RUN_ID}</variable>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
      </field>
      <field>
        <name>posting_limit</name>
        <variable>${POSTING_LIMIT}</variable>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
      </field>
      <field>
        <name>posting_ids</name>
        <variable>${POSTING_IDS}</variable>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
      </field>
      <field>
        <name>categorize_model</name>
        <variable>${CATEGORIZE_MODEL}</variable>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
      </field>
      <field>
        <name>prompt_version</name>
        <variable>${PROMPT_VERSION}</variable>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
      </field>
      <field>
        <name>retrieval_revision</name>
        <variable>${RETRIEVAL_REVISION}</variable>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
      </field>
      <field>
        <name>endpoint</name>
        <variable>${ENDPOINT}</variable>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
      </field>
      <field>
        <name>execute_requests</name>
        <variable>${EXECUTE_REQUESTS}</variable>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
      </field>
      <field>
        <name>max_cost_usd</name>
        <variable>${MAX_COST_USD}</variable>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
      </field>
      <field>
        <name>daily_budget_usd</name>
        <variable>${DAILY_BUDGET_USD}</variable>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
      </field>
      <field>
        <name>request_reserve_usd</name>
        <variable>${REQUEST_RESERVE_USD}</variable>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
      </field>
      <field>
        <name>max_requests</name>
        <variable>${MAX_REQUESTS}</variable>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
      </field>
      <field>
        <name>max_input_chars</name>
        <variable>${MAX_INPUT_CHARS}</variable>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
      </field>
      <field>
        <name>max_output_tokens</name>
        <variable>${MAX_OUTPUT_TOKENS}</variable>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
      </field>
      <field>
        <name>candidate_limit</name>
        <variable>${CANDIDATE_LIMIT}</variable>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
      </field>
      <field>
        <name>max_matches</name>
        <variable>${MAX_MATCHES}</variable>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
      </field>
      <field>
        <name>temperature</name>
        <variable>${TEMPERATURE}</variable>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
      </field>
      <field>
        <name>reasoning_effort</name>
        <variable>${REASONING_EFFORT}</variable>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
      </field>
      <field>
        <name>provider_only</name>
        <variable>${PROVIDER_ONLY}</variable>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
      </field>
      <field>
        <name>extra_params_json</name>
        <variable>${EXTRA_PARAMS_JSON}</variable>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
      </field>
      <field>
        <name>reuse_cache</name>
        <variable>${REUSE_CACHE}</variable>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
      </field>
      <field>
        <name>request_delay_ms</name>
        <variable>${REQUEST_DELAY_MS}</variable>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
      </field>
      <field>
        <name>read_timeout_ms</name>
        <variable>${READ_TIMEOUT_MS}</variable>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
      </field>
    </fields>
    <GUI>
      <xloc>80</xloc>
      <yloc>100</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
    <copies>1</copies>
    <distribute>Y</distribute>
  </transform>
  <transform>
    <type>DBJoin</type>
    <name>Freeze inference requests</name>
    <connection>jobtology-postgres</connection>
    <sql>WITH opts AS(SELECT jsonb_strip_nulls(jsonb_build_object(
     'limit',?::integer,'posting_ids',nullif(?,''),'categorize_model',?::text,'prompt_version',?::text,'retrieval_revision',nullif(?,''),'endpoint',?::text,'execute_requests',?::text,
     'max_cost_usd',?::numeric,'daily_budget_usd',?::numeric,'request_reserve_usd',?::numeric,'max_requests',?::integer,
     'max_input_chars',?::integer,'max_output_tokens',?::integer,'candidate_limit',?::integer,'max_matches',?::integer,
     'temperature',nullif(?,''),'reasoning_effort',nullif(?,''),'provider_only',nullif(?,''),'extra_params',?::jsonb,
     'reuse_cache',?::text,'request_delay_ms',?::integer,'read_timeout_ms',?::integer)) AS settings),
     prepared AS(SELECT enrichment.plan_metadata_occupation_batch(coalesce(nullif(?,''),gen_random_uuid()::text),?,?,settings) AS result FROM opts)
     SELECT result-&gt;&gt;'batch_id' AS planned_batch_id,result::text AS preparation_json FROM prepared</sql>
    <cache>N</cache>
    <cache_size>0</cache_size>
    <rowlimit>0</rowlimit>
    <outer_join>N</outer_join>
    <replace_vars>N</replace_vars>
    <parameter>
      <field>
        <name>posting_limit</name>
        <type>String</type>
      </field>
      <field>
        <name>posting_ids</name>
        <type>String</type>
      </field>
      <field>
        <name>categorize_model</name>
        <type>String</type>
      </field>
      <field>
        <name>prompt_version</name>
        <type>String</type>
      </field>
      <field>
        <name>retrieval_revision</name>
        <type>String</type>
      </field>
      <field>
        <name>endpoint</name>
        <type>String</type>
      </field>
      <field>
        <name>execute_requests</name>
        <type>String</type>
      </field>
      <field>
        <name>max_cost_usd</name>
        <type>String</type>
      </field>
      <field>
        <name>daily_budget_usd</name>
        <type>String</type>
      </field>
      <field>
        <name>request_reserve_usd</name>
        <type>String</type>
      </field>
      <field>
        <name>max_requests</name>
        <type>String</type>
      </field>
      <field>
        <name>max_input_chars</name>
        <type>String</type>
      </field>
      <field>
        <name>max_output_tokens</name>
        <type>String</type>
      </field>
      <field>
        <name>candidate_limit</name>
        <type>String</type>
      </field>
      <field>
        <name>max_matches</name>
        <type>String</type>
      </field>
      <field>
        <name>temperature</name>
        <type>String</type>
      </field>
      <field>
        <name>reasoning_effort</name>
        <type>String</type>
      </field>
      <field>
        <name>provider_only</name>
        <type>String</type>
      </field>
      <field>
        <name>extra_params_json</name>
        <type>String</type>
      </field>
      <field>
        <name>reuse_cache</name>
        <type>String</type>
      </field>
      <field>
        <name>request_delay_ms</name>
        <type>String</type>
      </field>
      <field>
        <name>read_timeout_ms</name>
        <type>String</type>
      </field>
      <field>
        <name>batch_id</name>
        <type>String</type>
      </field>
      <field>
        <name>job_run_id</name>
        <type>String</type>
      </field>
      <field>
        <name>ncs_run_id</name>
        <type>String</type>
      </field>
    </parameter>
    <GUI>
      <xloc>340</xloc>
      <yloc>100</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
    <copies>1</copies>
    <distribute>Y</distribute>
  </transform>
  <transform>
    <type>SetVariable</type>
    <name>Remember exact pilot pins</name>
    <use_formatting>Y</use_formatting>
    <fields>
      <field>
        <field_name>planned_batch_id</field_name>
        <variable_name>METADATA_OCCUPATION_BATCH_ID</variable_name>
        <variable_type>PARENT_WORKFLOW</variable_type>
        <default_value />
      </field>
    </fields>
    <GUI>
      <xloc>600</xloc>
      <yloc>100</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
    <copies>1</copies>
    <distribute>Y</distribute>
  </transform>
  <transform>
    <type>WriteToLog</type>
    <name>Prepared inferred occupation requests</name>
    <displayHeader>Y</displayHeader>
    <limitRows>N</limitRows>
    <limitRowsNumber>0</limitRowsNumber>
    <logmessage>Separate metadata inference requests prepared. Confidence remains unassessed; semantic review is separate.</logmessage>
    <loglevel>Basic</loglevel>
    <fields>
      <field>
        <name>planned_batch_id</name>
      </field>
      <field>
        <name>preparation_json</name>
      </field>
    </fields>
    <GUI>
      <xloc>860</xloc>
      <yloc>100</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
    <copies>1</copies>
    <distribute>Y</distribute>
  </transform>
  <transform_error_handling />
  <attributes />
</pipeline>