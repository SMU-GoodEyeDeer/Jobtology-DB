<?xml version='1.0' encoding='UTF-8'?>
<workflow>
  <name>Install separate inferred NCS occupation adapter</name>
  <description>Requires source SQL001-005 and existing LLM/retention modules. Native SQL only; no source or model requests.</description>
  <workflow_version>1</workflow_version>
  <workflow_status>0</workflow_status>
  <parameters />
  <actions>
    <action>
      <name>Start</name>
      <type>SPECIAL</type>
      <xloc>80</xloc>
      <yloc>100</yloc>
      <draw>Y</draw>
      <parallel>N</parallel>
      <attributes />
      <start>Y</start>
      <repeat>N</repeat>
      <schedulerType>0</schedulerType>
      <intervalSeconds>0</intervalSeconds>
      <intervalMinutes>60</intervalMinutes>
      <DayOfMonth>1</DayOfMonth>
      <weekDay>1</weekDay>
      <minutes>0</minutes>
      <hour>12</hour>
    </action>
    <action>
      <name>Success</name>
      <type>SUCCESS</type>
      <xloc>1700</xloc>
      <yloc>100</yloc>
      <draw>Y</draw>
      <parallel>N</parallel>
      <attributes />
