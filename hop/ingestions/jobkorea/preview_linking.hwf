<?xml version='1.0' encoding='UTF-8'?>
<workflow>
  <name>preview_linking</name>
  <description>Read source scope and a bounded pilot without preparing inputs or making requests.</description>
  <workflow_version>1</workflow_version>
  <workflow_status>0</workflow_status>
  <parameters>
    <parameter>
      <name>JOB_RUN_ID</name>
      <default_value>LATEST</default_value>
      <description>Resolve once, then pin the exact READY JobKorea supplied-file run.</description>
    </parameter>
    <parameter>
      <name>NCS_RUN_ID</name>
      <default_value>LATEST</default_value>
      <description>Resolve once, then pin the exact READY NCS competency run.</description>
    </parameter>
    <parameter>
      <name>PILOT_LIMIT</name>
      <default_value>5</default_value>
      <description>Small IT/software/data candidate pilot, 1..25. Scope remains unverified.</description>
    </parameter>
  </parameters>
  <actions>
    <action>
      <name>Start</name>
      <type>SPECIAL</type>
      <xloc>80</xloc>
      <yloc>80</yloc>
      <draw>Y</draw>
      <parallel>N</parallel>
      <attributes />
      <start>Y</start>
      <repeat>N</repeat>
      <schedulerType>0</schedulerType>
      <intervalSeconds>0</intervalSeconds>
      <intervalMinutes>60</intervalMinutes>
      <DayOfMonth>1</DayOfMonth>
      <weekDay>1</weekDay>
      <minutes>0</minutes>
      <hour>12</hour>
    </action>
    <action>
      <name>Read scope coverage</name>
      <type>PIPELINE</type>
      <xloc>320</xloc>
      <yloc>100</yloc>
      <draw>Y</draw>
      <parallel>N</parallel>
      <attributes />
      <filename>${PROJECT_HOME}/ingestions/jobkorea/preview_linking_scope.hpl</filename>
      <params_from_previous>N</params_from_previous>
      <exec_per_row>N</exec_per_row>
      <clear_rows>N</clear_rows>
      <clear_files>N</clear_files>
      <set_logfile>N</set_logfile>
      <loglevel>Basic</loglevel>
      <wait_until_finished>Y</wait_until_finished>
      <run_configuration>jobkorea-local</run_configuration>
      <parameters>
        <pass_all_parameters>Y</pass_all_parameters>
      </parameters>
    </action>
    <action>
      <name>Success</name>
      <type>SUCCESS</type>
      <xloc>560</xloc>
      <yloc>240</yloc>
      <draw>Y</draw>
      <parallel>N</parallel>
      <attributes />
    </action>
    <action>
      <name>Abort</name>
      <type>ABORT</type>
      <xloc>1040</xloc>
      <yloc>240</yloc>
      <draw>Y</draw>
      <parallel>N</parallel>
      <attributes />
      <message>JobKorea pilot preparation failed. Inspect pinned inputs and the batch report before retrying.</message>
    </action>
  </actions>
  <hops>
    <hop>
      <from>Start</from>
      <to>Read scope coverage</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>Y</unconditional>
    </hop>
    <hop>
      <from>Read scope coverage</from>
      <to>Success</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Read scope coverage</from>
      <to>Abort</to>
      <enabled>Y</enabled>
      <evaluation>N</evaluation>
      <unconditional>N</unconditional>
    </hop>
  </hops>
  <notepads />
  <attributes />
</workflow>