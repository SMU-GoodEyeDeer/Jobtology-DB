<?xml version='1.0' encoding='UTF-8'?>
<workflow>
  <name>Import supplied JobKorea local export and verify source graph</name>
  <description>Local files only. No source requests or paid enrichment. Default DRY_RUN requires isolated context.</description>
  <workflow_version>1</workflow_version>
  <workflow_status>0</workflow_status>
  <parameters>
    <parameter>
      <name>INPUT_FILE</name>
      <default_value />
      <description>Absolute supplied local JSON-array or NDJSON path; optional for archive-only resume.</description>
    </parameter>
    <parameter>
      <name>RAW_ROOT</name>
      <default_value />
      <description>Absolute private evidence directory.</description>
    </parameter>
    <parameter>
      <name>MODE</name>
      <default_value>DRY_RUN</default_value>
      <description>DRY_RUN requires JOBKOREA_ISOLATED_CONTEXT=true; IMPORT writes explicitly configured staging DB.</description>
    </parameter>
    <parameter>
      <name>INPUT_FORMAT</name>
      <default_value>AUTO</default_value>
      <description>AUTO by .ndjson/.jsonl extension, JSON_ARRAY or NDJSON.</description>
    </parameter>
    <parameter>
      <name>MAX_FILE_BYTES</name>
      <default_value />
      <description>Blank: JSON array 16 MiB or NDJSON 1 GiB; hard limits 64 MiB and 16 GiB.</description>
    </parameter>
    <parameter>
      <name>MAX_LINE_BYTES</name>
      <default_value>1048576</default_value>
      <description>NDJSON physical line bytes including newline, maximum 16 MiB.</description>
    </parameter>
    <parameter>
      <name>BATCH_ROWS</name>
      <default_value>500</default_value>
      <description>NDJSON committed batch rows, maximum 5000.</description>
    </parameter>
    <parameter>
      <name>BATCH_BYTES</name>
      <default_value>4194304</default_value>
      <description>NDJSON committed batch bytes, maximum 32 MiB; must cover MAX_LINE_BYTES.</description>
    </parameter>
    <parameter>
      <name>RESUME_RUN_ID</name>
      <default_value />
      <description>Exact NDJSON run to resume from its verified private archive and durable checkpoint.</description>
    </parameter>
    <parameter>
      <name>NEO4J_CONNECTION</name>
      <default_value>jobtology-neo4j</default_value>
      <description>Native private Neo4j connection.</description>
    </parameter>
  </parameters>
  <actions>
    <action>
      <attributes />
      <repeat>N</repeat>
      <schedulerType>0</schedulerType>
      <intervalSeconds>0</intervalSeconds>
      <intervalMinutes>60</intervalMinutes>
      <DayOfMonth>1</DayOfMonth>
      <weekDay>1</weekDay>
      <minutes>0</minutes>
      <hour>12</hour>
      <doNotWaitOnFirstExecution>N</doNotWaitOnFirstExecution>
      <description />
      <attributes />
      <name>Start</name>
      <type>SPECIAL</type>
      <xloc>100</xloc>
      <yloc>80</yloc>
      <draw>Y</draw>
      <parallel>N</parallel>
      <start>Y</start>
    </action>
    <action>
      <attributes />
      <params_from_previous>N</params_from_previous>
      <exec_per_row>N</exec_per_row>
      <clear_rows>N</clear_rows>
      <clear_files>N</clear_files>
      <create_parent_folder>N</create_parent_folder>
      <set_logfile>N</set_logfile>
      <set_append_logfile>N</set_append_logfile>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <loglevel>Basic</loglevel>
      <wait_until_finished>Y</wait_until_finished>
      <parameters>
        <pass_all_parameters>Y</pass_all_parameters>
      </parameters>
      <attributes />
      <name>Import immutable local evidence</name>
      <type>PIPELINE</type>
      <xloc>100</xloc>
      <yloc>230</yloc>
      <draw>Y</draw>
      <parallel>N</parallel>
      <filename>${PROJECT_HOME}/ingestions/jobkorea/import_local.hpl</filename>
      <run_configuration>jobkorea-local</run_configuration>
    </action>
    <action>
      <attributes />
      <params_from_previous>N</params_from_previous>
      <exec_per_row>N</exec_per_row>
      <clear_rows>N</clear_rows>
      <clear_files>N</clear_files>
      <create_parent_folder>N</create_parent_folder>
      <set_logfile>N</set_logfile>
      <set_append_logfile>N</set_append_logfile>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <loglevel>Basic</loglevel>
      <wait_until_finished>Y</wait_until_finished>
      <parameters>
        <pass_all_parameters>Y</pass_all_parameters>
        <parameter>
          <name>RUN_ID</name>
          <value>${JOBKOREA_RUN_ID}</value>
        </parameter>
      </parameters>
      <attributes />
      <name>Load and verify source graph</name>
      <type>WORKFLOW</type>
      <xloc>360</xloc>
      <yloc>230</yloc>
      <draw>Y</draw>
      <parallel>N</parallel>
      <filename>${PROJECT_HOME}/graph/load_snapshot.hwf</filename>
      <run_configuration>graph-local</run_configuration>
    </action>
    <action>
      <attributes />
      <params_from_previous>N</params_from_previous>
      <exec_per_row>N</exec_per_row>
      <clear_rows>N</clear_rows>
      <clear_files>N</clear_files>
      <create_parent_folder>N</create_parent_folder>
      <set_logfile>N</set_logfile>
      <set_append_logfile>N</set_append_logfile>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <loglevel>Basic</loglevel>
      <wait_until_finished>Y</wait_until_finished>
      <parameters>
        <pass_all_parameters>Y</pass_all_parameters>
        <parameter>
          <name>RUN_ID</name>
          <value>${JOBKOREA_RUN_ID}</value>
        </parameter>
      </parameters>
      <attributes />
      <name>Save verified graph checkpoint</name>
      <type>PIPELINE</type>
      <xloc>620</xloc>
      <yloc>230</yloc>
      <draw>Y</draw>
      <parallel>N</parallel>
      <filename>${PROJECT_HOME}/operations/record_graph_export.hpl</filename>
      <run_configuration>jobkorea-local</run_configuration>
    </action>
    <action>
      <attributes />
      <name>Success</name>
      <description />
      <attributes />
      <type>SUCCESS</type>
      <xloc>900</xloc>
      <yloc>230</yloc>
      <draw>Y</draw>
      <parallel>N</parallel>
    </action>
    <action>
      <attributes />
      <loglevel>Error</loglevel>
      <name>Abort</name>
      <description />
      <attributes />
      <type>ABORT</type>
      <xloc>360</xloc>
      <yloc>460</yloc>
      <draw>Y</draw>
      <parallel>N</parallel>
      <message>JobKorea import or graph verification failed. Inspect the import state, graph batch and checkpoint before retrying the same file.</message>
    </action>
  </actions>
  <hops>
    <hop>
      <from>Start</from>
      <to>Import immutable local evidence</to>
      <evaluation>Y</evaluation>
      <enabled>Y</enabled>
      <unconditional>Y</unconditional>
    </hop>
    <hop>
      <from>Import immutable local evidence</from>
      <to>Load and verify source graph</to>
      <evaluation>Y</evaluation>
      <enabled>Y</enabled>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Import immutable local evidence</from>
      <to>Abort</to>
      <evaluation>N</evaluation>
      <enabled>Y</enabled>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Load and verify source graph</from>
      <to>Save verified graph checkpoint</to>
      <evaluation>Y</evaluation>
      <enabled>Y</enabled>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Load and verify source graph</from>
      <to>Abort</to>
      <evaluation>N</evaluation>
      <enabled>Y</enabled>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Save verified graph checkpoint</from>
      <to>Success</to>
      <evaluation>Y</evaluation>
      <enabled>Y</enabled>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Save verified graph checkpoint</from>
      <to>Abort</to>
      <evaluation>N</evaluation>
      <enabled>Y</enabled>
      <unconditional>N</unconditional>
    </hop>
  </hops>
  <notepads />
  <attributes />
</workflow>