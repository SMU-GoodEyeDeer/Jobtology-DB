<?xml version='1.0' encoding='UTF-8'?>
<workflow>
  <name>publish_inferred_occupations</name>
  <description>Project labeled metadata occupation inferences in STAGING</description>
  <workflow_version>1</workflow_version>
  <workflow_status>0</workflow_status>
  <parameters>
    <parameter>
      <name>JOB_RUN_ID</name>
      <default_value />
      <description>Exact accepted READY JobKorea run; latest aliases are forbidden.</description>
    </parameter>
    <parameter>
      <name>NCS_RUN_ID</name>
      <default_value />
      <description>Exact accepted READY NCS run with both source proofs verified.</description>
    </parameter>
    <parameter>
      <name>INCLUDE_UNREVIEWED</name>
      <default_value>N</default_value>
      <description>Y includes clearly marked validated unreviewed metadata inferences.</description>
    </parameter>
    <parameter>
      <name>NEO4J_CONNECTION</name>
      <default_value>jobtology-neo4j</default_value>
      <description>Existing protected native graph connection.</description>
    </parameter>
  </parameters>
  <actions>
    <action>
      <name>Start</name>
      <type>SPECIAL</type>
      <xloc>80</xloc>
      <yloc>80</yloc>
      <draw>Y</draw>
      <parallel>N</parallel>
      <attributes />
      <start>Y</start>
      <repeat>N</repeat>
      <schedulerType>0</schedulerType>
      <intervalSeconds>0</intervalSeconds>
      <intervalMinutes>60</intervalMinutes>
      <DayOfMonth>1</DayOfMonth>
      <weekDay>1</weekDay>
      <minutes>0</minutes>
      <hour>12</hour>
    </action>
    <action>
      <name>Acquire exact graph writer</name>
      <type>PIPELINE</type>
      <xloc>320</xloc>
      <yloc>100</yloc>
      <draw>Y</draw>
      <parallel>N</parallel>
      <attributes />
      <filename>${PROJECT_HOME}/ingestions/jobkorea/acquire_inferred_occupation_graph.hpl</filename>
      <params_from_previous>N</params_from_previous>
      <exec_per_row>N</exec_per_row>
      <clear_rows>N</clear_rows>
      <clear_files>N</clear_files>
      <set_logfile>N</set_logfile>
      <loglevel>Basic</loglevel>
      <wait_until_finished>Y</wait_until_finished>
      <run_configuration>jobkorea-local</run_configuration>
      <parameters>
        <pass_all_parameters>Y</pass_all_parameters>
      </parameters>
    </action>
    <action>
      <name>Check source graphs and begin staging</name>
      <type>PIPELINE</type>
      <xloc>560</xloc>
      <yloc>100</yloc>
      <draw>Y</draw>
      <parallel>N</parallel>
      <attributes />
      <filename>${PROJECT_HOME}/ingestions/jobkorea/begin_inferred_occupation_graph.hpl</filename>
      <params_from_previous>N</params_from_previous>
      <exec_per_row>N</exec_per_row>
      <clear_rows>N</clear_rows>
      <clear_files>N</clear_files>
      <set_logfile>N</set_logfile>
      <loglevel>Basic</loglevel>
      <wait_until_finished>Y</wait_until_finished>
      <run_configuration>jobkorea-local</run_configuration>
      <parameters>
        <pass_all_parameters>Y</pass_all_parameters>
      </parameters>
    </action>
    <action>
      <name>Load separate inferred occupations</name>
      <type>PIPELINE</type>
      <xloc>800</xloc>
      <yloc>100</yloc>
      <draw>Y</draw>
      <parallel>N</parallel>
      <attributes />
      <filename>${PROJECT_HOME}/ingestions/jobkorea/load_inferred_occupation_graph.hpl</filename>
      <params_from_previous>N</params_from_previous>
      <exec_per_row>N</exec_per_row>
      <clear_rows>N</clear_rows>
      <clear_files>N</clear_files>
      <set_logfile>N</set_logfile>
      <loglevel>Basic</loglevel>
      <wait_until_finished>Y</wait_until_finished>
      <run_configuration>jobkorea-local</run_configuration>
      <parameters>
        <pass_all_parameters>Y</pass_all_parameters>
      </parameters>
    </action>
    <action>
      <name>Read back exact inference evidence</name>
      <type>PIPELINE</type>
      <xloc>1040</xloc>
      <yloc>100</yloc>
      <draw>Y</draw>
      <parallel>N</parallel>
      <attributes />
      <filename>${PROJECT_HOME}/ingestions/jobkorea/verify_inferred_occupation_graph.hpl</filename>
      <params_from_previous>N</params_from_previous>
      <exec_per_row>N</exec_per_row>
      <clear_rows>N</clear_rows>
      <clear_files>N</clear_files>
      <set_logfile>N</set_logfile>
      <loglevel>Basic</loglevel>
      <wait_until_finished>Y</wait_until_finished>
      <run_configuration>jobkorea-local</run_configuration>
      <parameters>
        <pass_all_parameters>Y</pass_all_parameters>
      </parameters>
    </action>
    <action>
      <name>Verify totals and release writer</name>
      <type>PIPELINE</type>
      <xloc>80</xloc>
      <yloc>280</yloc>
      <draw>Y</draw>
      <parallel>N</parallel>
      <attributes />
      <filename>${PROJECT_HOME}/ingestions/jobkorea/finish_inferred_occupation_graph.hpl</filename>
      <params_from_previous>N</params_from_previous>
      <exec_per_row>N</exec_per_row>
      <clear_rows>N</clear_rows>
      <clear_files>N</clear_files>
      <set_logfile>N</set_logfile>
      <loglevel>Basic</loglevel>
      <wait_until_finished>Y</wait_until_finished>
      <run_configuration>jobkorea-local</run_configuration>
      <parameters>
        <pass_all_parameters>Y</pass_all_parameters>
      </parameters>
    </action>
    <action>
      <name>Success</name>
      <type>SUCCESS</type>
      <xloc>560</xloc>
      <yloc>240</yloc>
      <draw>Y</draw>
      <parallel>N</parallel>
      <attributes />
    </action>
    <action>
      <name>Abort</name>
      <type>ABORT</type>
      <xloc>1040</xloc>
      <yloc>240</yloc>
      <draw>Y</draw>
      <parallel>N</parallel>
      <attributes />
      <message>JobKorea pilot preparation failed. Inspect pinned inputs and the batch report before retrying.</message>
    </action>
    <action>
      <name>Fail own inference projection</name>
      <type>PIPELINE</type>
      <xloc>320</xloc>
      <yloc>100</yloc>
      <draw>Y</draw>
      <parallel>N</parallel>
      <attributes />
      <filename>${PROJECT_HOME}/ingestions/jobkorea/fail_inferred_occupation_graph.hpl</filename>
      <params_from_previous>N</params_from_previous>
      <exec_per_row>N</exec_per_row>
      <clear_rows>N</clear_rows>
      <clear_files>N</clear_files>
      <set_logfile>N</set_logfile>
      <loglevel>Basic</loglevel>
      <wait_until_finished>Y</wait_until_finished>
      <run_configuration>jobkorea-local</run_configuration>
      <parameters>
        <pass_all_parameters>Y</pass_all_parameters>
      </parameters>
    </action>
  </actions>
  <hops>
    <hop>
      <from>Start</from>
      <to>Acquire exact graph writer</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>Y</unconditional>
    </hop>
    <hop>
      <from>Acquire exact graph writer</from>
      <to>Check source graphs and begin staging</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Acquire exact graph writer</from>
      <to>Abort</to>
      <enabled>Y</enabled>
      <evaluation>N</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Check source graphs and begin staging</from>
      <to>Load separate inferred occupations</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Check source graphs and begin staging</from>
      <to>Fail own inference projection</to>
      <enabled>Y</enabled>
      <evaluation>N</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Load separate inferred occupations</from>
      <to>Read back exact inference evidence</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Load separate inferred occupations</from>
      <to>Fail own inference projection</to>
      <enabled>Y</enabled>
      <evaluation>N</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Read back exact inference evidence</from>
      <to>Verify totals and release writer</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Read back exact inference evidence</from>
      <to>Fail own inference projection</to>
      <enabled>Y</enabled>
      <evaluation>N</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Verify totals and release writer</from>
      <to>Success</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Verify totals and release writer</from>
      <to>Fail own inference projection</to>
      <enabled>Y</enabled>
      <evaluation>N</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Fail own inference projection</from>
      <to>Abort</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Fail own inference projection</from>
      <to>Abort</to>
      <enabled>Y</enabled>
      <evaluation>N</evaluation>
      <unconditional>N</unconditional>
    </hop>
  </hops>
  <notepads />
  <attributes />
</workflow>