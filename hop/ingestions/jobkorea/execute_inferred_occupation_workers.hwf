<?xml version='1.0' encoding='UTF-8'?>
<workflow>
  <name>execute_inferred_occupation_workers</name>
  <description>Optional bounded native occupation workers; default one and execution off, same prompt and cache identity.</description>
  <workflow_version>1</workflow_version>
  <workflow_status>0</workflow_status>
  <parameters>
    <parameter>
      <name>BATCH_ID</name>
      <default_value />
      <description>Optional immutable batch identity; blank creates one.</description>
    </parameter>
    <parameter>
      <name>JOB_RUN_ID</name>
      <default_value>LATEST</default_value>
      <description>Exact current READY supplied JobKorea snapshot.</description>
    </parameter>
    <parameter>
      <name>NCS_RUN_ID</name>
      <default_value>LATEST</default_value>
      <description>Exact current READY NCS snapshot.</description>
    </parameter>
    <parameter>
      <name>POSTING_LIMIT</name>
      <default_value>5</default_value>
      <description>Listing count 1..10000; includes unknown lexical scope and closed listings.</description>
    </parameter>
    <parameter>
      <name>POSTING_IDS</name>
      <default_value />
      <description>Optional exact pipe-separated posting identities.</description>
    </parameter>
    <parameter>
      <name>CATEGORIZE_MODEL</name>
      <default_value>openai/gpt-5.6-luna</default_value>
      <description>Existing OpenRouter model.</description>
    </parameter>
    <parameter>
      <name>PROMPT_VERSION</name>
      <default_value>ko-metadata-occupation-v1</default_value>
      <description>Immutable inference prompt version: ko-metadata-occupation-v1 or ko-metadata-occupation-v2; v1 is the default.</description>
    </parameter>
    <parameter>
      <name>RETRIEVAL_REVISION</name>
      <default_value />
      <description>Blank preserves legacy retrieval/replay; metadata-occupation-lexical-v3 selects corrected new-batch retrieval.</description>
    </parameter>
    <parameter>
      <name>ENDPOINT</name>
      <default_value>https://openrouter.ai/api/v1/chat/completions</default_value>
      <description>Exact OpenRouter HTTPS endpoint; isolated internal mocks only in tests.</description>
    </parameter>
    <parameter>
      <name>API_KEY_FILE</name>
      <default_value>${HOP_CONFIG_FOLDER}/secrets/openrouter.csv</default_value>
      <description>Protected CSV read only after execute=Y eligibility.</description>
    </parameter>
    <parameter>
      <name>EXECUTE_REQUESTS</name>
      <default_value>N</default_value>
      <description>Y enables bounded native requests; N has no key read or HTTP.</description>
    </parameter>
    <parameter>
      <name>MAX_COST_USD</name>
      <default_value>0.05</default_value>
      <description>This immutable batch accounting cap; maximum $50. Choose full-run budget after the pilot.</description>
    </parameter>
    <parameter>
      <name>DAILY_BUDGET_USD</name>
      <default_value>4.75</default_value>
      <description>Shared rolling 24-hour accounting cap; default $4.75, maximum $50.</description>
    </parameter>
    <parameter>
      <name>REQUEST_RESERVE_USD</name>
      <default_value>0.005</default_value>
      <description>Unknown costs retain this hold; admission verifies conservative byte/token cost bound.</description>
    </parameter>
    <parameter>
      <name>MAX_REQUESTS</name>
      <default_value>5</default_value>
      <description>Maximum charged or uncertain requests in this batch.</description>
    </parameter>
    <parameter>
      <name>MAX_INPUT_CHARS</name>
      <default_value>16000</default_value>
      <description>Complete request bound; inputs are rejected instead of truncated.</description>
    </parameter>
    <parameter>
      <name>MAX_OUTPUT_TOKENS</name>
      <default_value>768</default_value>
      <description>Maximum output including reasoning per request.</description>
    </parameter>
    <parameter>
      <name>CANDIDATE_LIMIT</name>
      <default_value>12</default_value>
      <description>Exact bounded occupation shortlist, 1..30.</description>
    </parameter>
    <parameter>
      <name>MAX_MATCHES</name>
      <default_value>1</default_value>
      <description>Maximum inferred occupations: 1..2 for v1/v2, 1..3 for explicit v3.</description>
    </parameter>
    <parameter>
      <name>TEMPERATURE</name>
      <default_value />
      <description>Optional compatible temperature.</description>
    </parameter>
    <parameter>
      <name>REASONING_EFFORT</name>
      <default_value>none</default_value>
      <description>Optional reasoning effort; compact classification defaults none.</description>
    </parameter>
    <parameter>
      <name>PROVIDER_ONLY</name>
      <default_value>openai</default_value>
      <description>Standard OpenAI routing; fallback and service tier alternatives disabled.</description>
    </parameter>
    <parameter>
      <name>EXTRA_PARAMS_JSON</name>
      <default_value>{}</default_value>
      <description>Allowlisted numeric options only.</description>
    </parameter>
    <parameter>
      <name>REUSE_CACHE</name>
      <default_value>Y</default_value>
      <description>Reuse exact metadata/candidate/NCS/prompt/model-option outputs; revalidate per posting.</description>
    </parameter>
    <parameter>
      <name>REQUEST_DELAY_MS</name>
      <default_value>250</default_value>
      <description>Per-worker delay before a single reserved POST; the worker bound limits concurrent attempts.</description>
    </parameter>
    <parameter>
      <name>READ_TIMEOUT_MS</name>
      <default_value>180000</default_value>
      <description>Finite request timeout; uncertain outcomes stop further sends in this batch.</description>
    </parameter>
    <parameter>
      <name>REQUEST_WORKERS</name>
      <default_value>1</default_value>
      <description>Bounded in-flight workers 1..8; default one, no automatic retries.</description>
    </parameter>
  </parameters>
  <actions>
    <action>
      <name>Start</name>
      <type>SPECIAL</type>
      <xloc>80</xloc>
      <yloc>80</yloc>
      <draw>Y</draw>
      <parallel>N</parallel>
      <attributes />
      <start>Y</start>
      <repeat>N</repeat>
      <schedulerType>0</schedulerType>
      <intervalSeconds>0</intervalSeconds>
      <intervalMinutes>60</intervalMinutes>
      <DayOfMonth>1</DayOfMonth>
      <weekDay>1</weekDay>
      <minutes>0</minutes>
      <hour>12</hour>
    </action>
    <action>
      <name>Freeze inferred occupation inputs</name>
      <type>PIPELINE</type>
      <xloc>320</xloc>
      <yloc>100</yloc>
      <draw>Y</draw>
      <parallel>N</parallel>
      <attributes />
      <filename>${PROJECT_HOME}/ingestions/jobkorea/prepare_inferred_occupations.hpl</filename>
      <params_from_previous>N</params_from_previous>
      <exec_per_row>N</exec_per_row>
      <clear_rows>N</clear_rows>
      <clear_files>N</clear_files>
      <set_logfile>N</set_logfile>
      <loglevel>Basic</loglevel>
      <wait_until_finished>Y</wait_until_finished>
      <run_configuration>jobkorea-local</run_configuration>
      <parameters>
        <pass_all_parameters>Y</pass_all_parameters>
      </parameters>
    </action>
    <action>
      <name>Own bounded inference dispatch</name>
      <type>PIPELINE</type>
      <xloc>560</xloc>
      <yloc>100</yloc>
      <draw>Y</draw>
      <parallel>N</parallel>
      <attributes />
      <filename>${PROJECT_HOME}/ingestions/jobkorea/start_inferred_occupation_execution.hpl</filename>
      <params_from_previous>N</params_from_previous>
      <exec_per_row>N</exec_per_row>
      <clear_rows>N</clear_rows>
      <clear_files>N</clear_files>
      <set_logfile>N</set_logfile>
      <loglevel>Basic</loglevel>
      <wait_until_finished>Y</wait_until_finished>
      <run_configuration>jobkorea-local</run_configuration>
      <parameters>
        <pass_all_parameters>Y</pass_all_parameters>
      </parameters>
    </action>
    <action>
      <name>Send bounded inferred occupation requests</name>
      <type>PIPELINE</type>
      <xloc>800</xloc>
      <yloc>100</yloc>
      <draw>Y</draw>
      <parallel>N</parallel>
      <attributes />
      <filename>${PROJECT_HOME}/ingestions/jobkorea/run_inferred_occupation_workers.hpl</filename>
      <params_from_previous>N</params_from_previous>
      <exec_per_row>N</exec_per_row>
      <clear_rows>N</clear_rows>
      <clear_files>N</clear_files>
      <set_logfile>N</set_logfile>
      <loglevel>Basic</loglevel>
      <wait_until_finished>Y</wait_until_finished>
      <run_configuration>jobkorea-local</run_configuration>
      <parameters>
        <pass_all_parameters>Y</pass_all_parameters>
      </parameters>
    </action>
    <action>
      <name>End bounded inference dispatch</name>
      <type>PIPELINE</type>
      <xloc>1040</xloc>
      <yloc>100</yloc>
      <draw>Y</draw>
      <parallel>N</parallel>
      <attributes />
      <filename>${PROJECT_HOME}/ingestions/jobkorea/end_inferred_occupation_execution.hpl</filename>
      <params_from_previous>N</params_from_previous>
      <exec_per_row>N</exec_per_row>
      <clear_rows>N</clear_rows>
      <clear_files>N</clear_files>
      <set_logfile>N</set_logfile>
      <loglevel>Basic</loglevel>
      <wait_until_finished>Y</wait_until_finished>
      <run_configuration>jobkorea-local</run_configuration>
      <parameters>
        <pass_all_parameters>Y</pass_all_parameters>
      </parameters>
    </action>
    <action>
      <name>Record inferred outcomes and costs</name>
      <type>PIPELINE</type>
      <xloc>80</xloc>
      <yloc>280</yloc>
      <draw>Y</draw>
      <parallel>N</parallel>
      <attributes />
      <filename>${PROJECT_HOME}/ingestions/jobkorea/finish_inferred_occupations.hpl</filename>
      <params_from_previous>N</params_from_previous>
      <exec_per_row>N</exec_per_row>
      <clear_rows>N</clear_rows>
      <clear_files>N</clear_files>
      <set_logfile>N</set_logfile>
      <loglevel>Basic</loglevel>
      <wait_until_finished>Y</wait_until_finished>
      <run_configuration>jobkorea-local</run_configuration>
      <parameters>
        <pass_all_parameters>Y</pass_all_parameters>
      </parameters>
    </action>
    <action>
      <name>Success</name>
      <type>SUCCESS</type>
      <xloc>560</xloc>
      <yloc>240</yloc>
      <draw>Y</draw>
      <parallel>N</parallel>
      <attributes />
    </action>
    <action>
      <name>Abort</name>
      <type>ABORT</type>
      <xloc>1040</xloc>
      <yloc>240</yloc>
      <draw>Y</draw>
      <parallel>N</parallel>
      <attributes />
      <message>JobKorea pilot preparation failed. Inspect pinned inputs and the batch report before retrying.</message>
    </action>
  </actions>
  <hops>
    <hop>
      <from>Start</from>
      <to>Freeze inferred occupation inputs</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>Y</unconditional>
    </hop>
    <hop>
      <from>Freeze inferred occupation inputs</from>
      <to>Own bounded inference dispatch</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Freeze inferred occupation inputs</from>
      <to>Abort</to>
      <enabled>Y</enabled>
      <evaluation>N</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Own bounded inference dispatch</from>
      <to>Send bounded inferred occupation requests</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Own bounded inference dispatch</from>
      <to>Abort</to>
      <enabled>Y</enabled>
      <evaluation>N</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Send bounded inferred occupation requests</from>
      <to>End bounded inference dispatch</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Send bounded inferred occupation requests</from>
      <to>Abort</to>
      <enabled>Y</enabled>
      <evaluation>N</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>End bounded inference dispatch</from>
      <to>Record inferred outcomes and costs</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>End bounded inference dispatch</from>
      <to>Abort</to>
      <enabled>Y</enabled>
      <evaluation>N</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Record inferred outcomes and costs</from>
      <to>Success</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Record inferred outcomes and costs</from>
      <to>Abort</to>
      <enabled>Y</enabled>
      <evaluation>N</evaluation>
      <unconditional>N</unconditional>
    </hop>
  </hops>
  <notepads />
  <attributes />
</workflow>