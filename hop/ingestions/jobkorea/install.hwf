    </hop>
    <hop>
      <from>JobKorea 002_operations</from>
      <to>Abort</to>
      <evaluation>N</evaluation>
      <enabled>Y</enabled>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>JobKorea 003_checks</from>
      <to>JobKorea 004_integration</to>
      <evaluation>Y</evaluation>
      <enabled>Y</enabled>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>JobKorea 003_checks</from>
      <to>Abort</to>
      <evaluation>N</evaluation>
      <enabled>Y</enabled>
      <unconditional>N</unconditional>
    </hop>
    <hop>
