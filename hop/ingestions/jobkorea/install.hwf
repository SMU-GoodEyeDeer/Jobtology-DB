      <to>Abort</to>
      <evaluation>N</evaluation>
      <enabled>Y</enabled>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>JobKorea 005_shared_checks</from>
      <to>JobKorea 006_ndjson</to>
      <evaluation>Y</evaluation>
      <enabled>Y</enabled>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>JobKorea 005_shared_checks</from>
      <to>Abort</to>
      <evaluation>N</evaluation>
      <enabled>Y</enabled>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>JobKorea 006_ndjson</from>
      <to>JobKorea 007_dataset_provenance</to>
      <evaluation>Y</evaluation>
      <enabled>Y</enabled>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>JobKorea 006_ndjson</from>
      <to>Abort</to>
