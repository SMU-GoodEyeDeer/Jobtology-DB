<?xml version='1.0' encoding='UTF-8'?>
<pipeline>
  <info>
    <name>graph_fail</name>
    <description>Mark only this O*NET graph attempt failed and release its own shared writer.</description>
    <pipeline_type>Normal</pipeline_type>
    <size_rowset>1000</size_rowset>
    <parameters />
  </info>
  <notepads />
  <order>
    <hop>
      <from>Exact catalogue options</from>
      <to>Fail only own catalogue writer</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <type>GetVariable</type>
    <name>Exact catalogue options</name>
    <fields>
      <field>
        <name>load_id</name>
        <variable>${ONET_LOAD_ID}</variable>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
      </field>
    </fields>
    <GUI>
      <xloc>80</xloc>
      <yloc>100</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
    <copies>1</copies>
    <distribute>Y</distribute>
  </transform>
  <transform>
    <type>ExecSql</type>
    <name>Fail only own catalogue writer</name>
    <connection>jobtology-postgres</connection>
    <sql>SELECT classification.fail_graph_load(?)</sql>
    <execute_each_row>Y</execute_each_row>
    <single_statement>Y</single_statement>
    <set_params>Y</set_params>
    <replace_variables>N</replace_variables>
    <quoteString>N</quoteString>
    <arguments>
      <argument>
        <name>load_id</name>
      </argument>
    </arguments>
    <GUI>
      <xloc>310</xloc>
      <yloc>100</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
    <copies>1</copies>
    <distribute>Y</distribute>
  </transform>
  <transform_error_handling />
  <attributes />
</pipeline>