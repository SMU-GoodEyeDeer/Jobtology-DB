<?xml version='1.0' encoding='UTF-8'?>
<pipeline>
  <info>
    <name>graph_activate</name>
    <description>Select only the exact independently verified O*NET release for catalogue reads.</description>
    <pipeline_type>Normal</pipeline_type>
    <size_rowset>1000</size_rowset>
    <parameters />
  </info>
  <notepads />
  <order>
    <hop>
      <from>Exact catalogue options</from>
      <to>Require verified current graph target</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Require verified current graph target</from>
      <to>Read verified load context</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Read verified load context</from>
      <to>Activate verified catalogue</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <type>GetVariable</type>
    <name>Exact catalogue options</name>
    <fields>
      <field>
        <name>load_id</name>
        <variable>${ONET_LOAD_ID}</variable>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
      </field>
    </fields>
    <GUI>
      <xloc>80</xloc>
      <yloc>100</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
    <copies>1</copies>
    <distribute>Y</distribute>
  </transform>
  <transform>
    <type>DBJoin</type>
    <name>Require verified current graph target</name>
    <connection>jobtology-postgres</connection>
    <sql>SELECT classification.assert_verified_graph_load(?) AS checked_token</sql>
    <cache>N</cache>
    <cache_size>0</cache_size>
    <rowlimit>0</rowlimit>
    <outer_join>N</outer_join>
    <replace_vars>N</replace_vars>
    <parameter>
      <field>
        <name>load_id</name>
        <type>String</type>
      </field>
    </parameter>
    <GUI>
      <xloc>310</xloc>
      <yloc>100</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
    <copies>1</copies>
    <distribute>Y</distribute>
  </transform>
  <transform>
    <type>DBJoin</type>
    <name>Read verified load context</name>
    <connection>jobtology-postgres</connection>
    <sql>SELECT * FROM classification.graph_load_context(?)</sql>
    <cache>N</cache>
    <cache_size>0</cache_size>
    <rowlimit>0</rowlimit>
    <outer_join>N</outer_join>
    <replace_vars>N</replace_vars>
    <parameter>
      <field>
        <name>load_id</name>
        <type>String</type>
      </field>
    </parameter>
    <GUI>
      <xloc>540</xloc>
      <yloc>100</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
    <copies>1</copies>
    <distribute>Y</distribute>
  </transform>
  <transform>
    <type>ExecSql</type>
    <name>Activate verified catalogue</name>
    <connection>jobtology-postgres</connection>
    <sql>SELECT classification.activate_catalog(?,?,?)</sql>
    <execute_each_row>Y</execute_each_row>
    <single_statement>Y</single_statement>
    <set_params>Y</set_params>
    <replace_variables>N</replace_variables>
    <quoteString>N</quoteString>
    <arguments>
      <argument>
        <name>release_id</name>
      </argument>
      <argument>
        <name>database_id</name>
      </argument>
      <argument>
        <name>load_id</name>
      </argument>
    </arguments>
    <GUI>
      <xloc>770</xloc>
      <yloc>100</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
    <copies>1</copies>
    <distribute>Y</distribute>
  </transform>
  <transform_error_handling />
  <attributes />
</pipeline>