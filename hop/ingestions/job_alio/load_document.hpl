 SELECT *,CASE WHEN posted_digits ~ '^[0-9]{8}$' THEN substr(posted_digits,1,4)||'-'||substr(posted_digits,5,2)||'-'||substr(posted_digits,7,2) END AS date_posted_iso,
 CASE WHEN closing_digits ~ '^[0-9]{8}$' THEN substr(closing_digits,1,4)||'-'||substr(closing_digits,5,2)||'-'||substr(closing_digits,7,2) END AS closing_date_iso FROM digits), checked AS (
 SELECT *,CASE WHEN jsonb_typeof(b)&lt;&gt;'object' THEN 'EXPECTED_OBJECT'
 WHEN (coalesce(jsonb_typeof(b-&gt;'recrutPblntSn'),'null') NOT IN ('null','string','number') OR (jsonb_typeof(b-&gt;'recrutPblntSn')='number' AND j-&gt;&gt;'recrutPblntSn' !~ '^-?[0-9]+$')) OR (coalesce(jsonb_typeof(b-&gt;'recrutPbancTtl'),'null') NOT IN ('null','string','number') OR (jsonb_typeof(b-&gt;'recrutPbancTtl')='number' AND j-&gt;&gt;'recrutPbancTtl' !~ '^-?[0-9]+$')) OR (coalesce(jsonb_typeof(b-&gt;'pblntInstCd'),'null') NOT IN ('null','string','number') OR (jsonb_typeof(b-&gt;'pblntInstCd')='number' AND j-&gt;&gt;'pblntInstCd' !~ '^-?[0-9]+$')) OR (coalesce(jsonb_typeof(b-&gt;'instNm'),'null') NOT IN ('null','string','number') OR (jsonb_typeof(b-&gt;'instNm')='number' AND j-&gt;&gt;'instNm' !~ '^-?[0-9]+$')) OR (coalesce(jsonb_typeof(b-&gt;'pbancBgngYmd'),'null') NOT IN ('null','string','number') OR (jsonb_typeof(b-&gt;'pbancBgngYmd')='number' AND j-&gt;&gt;'pbancBgngYmd' !~ '^-?[0-9]+$')) OR (coalesce(jsonb_typeof(b-&gt;'pbancEndYmd'),'null') NOT IN ('null','string','number') OR (jsonb_typeof(b-&gt;'pbancEndYmd')='number' AND j-&gt;&gt;'pbancEndYmd' !~ '^-?[0-9]+$')) OR (coalesce(jsonb_typeof(b-&gt;'srcUrl'),'null') NOT IN ('null','string','number') OR (jsonb_typeof(b-&gt;'srcUrl')='number' AND j-&gt;&gt;'srcUrl' !~ '^-?[0-9]+$')) OR (coalesce(jsonb_typeof(b-&gt;'recrutSeNm'),'null') NOT IN ('null','string','number') OR (jsonb_typeof(b-&gt;'recrutSeNm')='number' AND j-&gt;&gt;'recrutSeNm' !~ '^-?[0-9]+$')) OR (coalesce(jsonb_typeof(b-&gt;'acbgCondNmLst'),'null') NOT IN ('null','string','number') OR (jsonb_typeof(b-&gt;'acbgCondNmLst')='number' AND j-&gt;&gt;'acbgCondNmLst' !~ '^-?[0-9]+$')) OR (coalesce(jsonb_typeof(b-&gt;'hireTypeNmLst'),'null') NOT IN ('null','string','number') OR (jsonb_typeof(b-&gt;'hireTypeNmLst')='number' AND j-&gt;&gt;'hireTypeNmLst' !~ '^-?[0-9]+$')) OR (coalesce(jsonb_typeof(b-&gt;'workRgnNmLst'),'null') NOT IN ('null','string','number') OR (jsonb_typeof(b-&gt;'workRgnNmLst')='number' AND j-&gt;&gt;'workRgnNmLst' !~ '^-?[0-9]+$')) OR (coalesce(jsonb_typeof(b-&gt;'ncsCdLst'),'null') NOT IN ('null','string','number') OR (jsonb_typeof(b-&gt;'ncsCdLst')='number' AND j-&gt;&gt;'ncsCdLst' !~ '^-?[0-9]+$')) OR (coalesce(jsonb_typeof(b-&gt;'ncsCdNmLst'),'null') NOT IN ('null','string','number') OR (jsonb_typeof(b-&gt;'ncsCdNmLst')='number' AND j-&gt;&gt;'ncsCdNmLst' !~ '^-?[0-9]+$')) OR (coalesce(jsonb_typeof(b-&gt;'aplyQlfcCn'),'null') NOT IN ('null','string','number') OR (jsonb_typeof(b-&gt;'aplyQlfcCn')='number' AND j-&gt;&gt;'aplyQlfcCn' !~ '^-?[0-9]+$')) OR (coalesce(jsonb_typeof(b-&gt;'disqlfcRsn'),'null') NOT IN ('null','string','number') OR (jsonb_typeof(b-&gt;'disqlfcRsn')='number' AND j-&gt;&gt;'disqlfcRsn' !~ '^-?[0-9]+$')) OR (coalesce(jsonb_typeof(b-&gt;'prefCn'),'null') NOT IN ('null','string','number') OR (jsonb_typeof(b-&gt;'prefCn')='number' AND j-&gt;&gt;'prefCn' !~ '^-?[0-9]+$')) OR (coalesce(jsonb_typeof(b-&gt;'scrnprcdrMthdExpln'),'null') NOT IN ('null','string','number') OR (jsonb_typeof(b-&gt;'scrnprcdrMthdExpln')='number' AND j-&gt;&gt;'scrnprcdrMthdExpln' !~ '^-?[0-9]+$')) THEN 'INVALID_STRING'
 WHEN posting_id IS NULL OR title IS NULL OR organization_code IS NULL OR organization_name IS NULL THEN 'MISSING_REQUIRED_FIELD'
 WHEN partition_id&lt;&gt;'index' AND partition_id&lt;&gt;'detail-'||posting_id THEN 'PARTITION_IDENTITY_MISMATCH'
 WHEN b-&gt;&gt;'ongoingYn' IS NOT NULL AND b-&gt;&gt;'ongoingYn' NOT IN ('','Y','N') THEN 'INVALID_ONGOING_STATUS'
 WHEN date_posted IS NULL OR closing_date IS NULL THEN 'INVALID_POSTING_DATE_RANGE'
 WHEN date_posted_iso IS NULL OR closing_date_iso IS NULL OR NOT pg_input_is_valid(date_posted_iso,'date') OR NOT pg_input_is_valid(closing_date_iso,'date') THEN 'INVALID_DATE'
 WHEN closing_date_iso&lt;date_posted_iso THEN 'INVALID_POSTING_DATE_RANGE'
 WHEN headcount_text IS NOT NULL AND (headcount_text !~ '^[0-9]+$' OR jsonb_typeof(b-&gt;'recrutNope') NOT IN ('string','number')) THEN 'INVALID_NONNEGATIVE_INTEGER'
 WHEN headcount_text IS NOT NULL AND NOT pg_input_is_valid(headcount_text,'integer') THEN 'HEADCOUNT_OUT_OF_RANGE'
 ELSE NULL END AS record_error FROM dated)
SELECT jsonb_build_object('row',jsonb_build_array(jsonb_build_object('kind','JobPosting','representation',CASE WHEN partition_id='index' THEN 'list' ELSE 'detail' END,'posting_id',posting_id,'title',title,'organization_code',organization_code,'organization_name',organization_name,'date_posted',date_posted_iso,'closing_date',closing_date_iso,'source_url',source_url,'recruitment_type',recruitment_type,'education',education,'employment_type',employment_type,'regions',regions,'ncs_category_codes',ncs_category_codes,'ncs_category_names',ncs_category_names,'eligibility_text',eligibility_text,'disqualification_text',disqualification_text,'preference_text',preference_text,'selection_text',selection_text,'ongoing',CASE WHEN b-&gt;&gt;'ongoingYn' IN ('Y','N') THEN b-&gt;&gt;'ongoingYn'='Y' ELSE NULL END,'headcount',CASE WHEN record_error IS NULL THEN headcount_text::integer ELSE NULL END)))::text AS normalized_block_json,
 '{"posting_id":["/recrutPblntSn"],"title":["/recrutPbancTtl"],"organization_code":["/pblntInstCd"],"organization_name":["/instNm"],"date_posted":["/pbancBgngYmd"],"closing_date":["/pbancEndYmd"],"source_url":["/srcUrl"],"recruitment_type":["/recrutSeNm"],"education":["/acbgCondNmLst"],"employment_type":["/hireTypeNmLst"],"regions":["/workRgnNmLst"],"ncs_category_codes":["/ncsCdLst"],"ncs_category_names":["/ncsCdNmLst"],"eligibility_text":["/aplyQlfcCn"],"disqualification_text":["/disqlfcRsn"],"preference_text":["/prefCn"],"selection_text":["/scrnprcdrMthdExpln"],"representation":["request:partition_id"],"ongoing":["/ongoingYn"],"headcount":["/recrutNope"]}'::text AS field_lineage_json,'[]'::text AS quality_flags_json,record_error,record_error IS NULL AS record_valid FROM checked</sql>
    <rowlimit>0</rowlimit>
    <outer_join>N</outer_join>
    <parameter>
      <field>
        <name>source_payload_json</name>
        <type>String</type>
      </field>
      <field>
        <name>partition_id</name>
        <type>String</type>
      </field>
    </parameter>
    <replace_vars>N</replace_vars>
    <connection>jobtology-postgres</connection>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>100</xloc>
      <yloc>440</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
  </transform>
  <transform>
    <type>FilterRows</type>
    <name>Valid posting</name>
    <compare>
      <condition>
        <negated>N</negated>
        <operator>-</operator>
        <leftvalue>record_valid</leftvalue>
        <function>=</function>
        <value>
          <name>constant</name>
          <type>Boolean</type>
          <text>Y</text>
          <length>-1</length>
          <precision>-1</precision>
          <isnull>N</isnull>
        </value>
      </condition>
    </compare>
    <send_true_to>Load posting</send_true_to>
    <send_false_to>Retain rejected posting</send_false_to>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>330</xloc>
      <yloc>440</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
  </transform>
  <transform>
    <type>ExecSql</type>
    <name>Load posting</name>
    <sql>-- Execute SQL script: execute for each row, bind parameters, single statement.
-- Bind in order: run_id, document_id, locator, source_payload_json,
-- normalized_block_json, field_lineage_json, quality_flags_json.
-- JSON Output must emit {"row":[{...}]} with exactly one row per block.
-- This statement writes only LOADING runs. Treat zero affected rows as an error.
WITH input AS (
    SELECT CAST(? AS text) AS run_id, CAST(? AS text) AS document_id,
           CAST(? AS text) AS locator, CAST(? AS jsonb) AS source_payload,
           CAST(? AS jsonb)-&gt;'row'-&gt;0 AS flat,
           CAST(? AS jsonb) AS field_lineage, CAST(? AS jsonb) AS quality_flags
), shaped AS (
    SELECT i.*, u.source_id,
      CASE u.source_id
        WHEN 'ncs_competency' THEN
          (flat - ARRAY['classification_1', 'classification_2', 'classification_3'])
          || jsonb_build_object('classification_names', jsonb_build_array(
               COALESCE(flat-&gt;&gt;'classification_1', ''),
               COALESCE(flat-&gt;&gt;'classification_2', ''),
               COALESCE(flat-&gt;&gt;'classification_3', '')))
        WHEN 'qnet_schedule' THEN
          (flat - ARRAY['docRegStartDt', 'docRegEndDt', 'docExamStartDt', 'docExamEndDt',
                       'docPassDt', 'pracRegStartDt', 'pracRegEndDt', 'pracExamStartDt',
                       'pracExamEndDt', 'pracPassDt'])
          || jsonb_build_object('dates', jsonb_build_object(
               'docRegStartDt', flat-&gt;'docRegStartDt', 'docRegEndDt', flat-&gt;'docRegEndDt',
               'docExamStartDt', flat-&gt;'docExamStartDt', 'docExamEndDt', flat-&gt;'docExamEndDt',
               'docPassDt', flat-&gt;'docPassDt', 'pracRegStartDt', flat-&gt;'pracRegStartDt',
               'pracRegEndDt', flat-&gt;'pracRegEndDt', 'pracExamStartDt', flat-&gt;'pracExamStartDt',
               'pracExamEndDt', flat-&gt;'pracExamEndDt', 'pracPassDt', flat-&gt;'pracPassDt'))
        ELSE flat END AS normalized
    FROM input i JOIN ingestion.run u USING (run_id)
    WHERE u.state = 'LOADING'
), keyed AS (
    SELECT s.*,
      CASE source_id
        WHEN 'alio_organization' THEN normalized-&gt;&gt;'code'
        WHEN 'ncs_competency' THEN normalized-&gt;&gt;'code'
        WHEN 'job_alio' THEN (normalized-&gt;&gt;'posting_id') || ':' || (normalized-&gt;&gt;'representation')
        WHEN 'ncs_qualification' THEN (normalized-&gt;&gt;'competency_code') || ':'
            || (normalized-&gt;&gt;'qualification_code') || ':' || (normalized-&gt;&gt;'standard_version')
        WHEN 'qnet_schedule' THEN (normalized-&gt;&gt;'qualification_code') || ':'
            || (normalized-&gt;&gt;'year') || ':' || (normalized-&gt;&gt;'category_code') || ':'
            || (normalized-&gt;&gt;'round')
        -- New, versioned migration identity: NOT the Python JSON serialization/hash.
        WHEN 'ncs_career_path' THEN 'hop-career-v1:' || encode(
            sha256(convert_to(normalized::text, 'UTF8')), 'hex') END AS source_record_id
    FROM shaped s
)
INSERT INTO ingestion.record
    (run_id, document_id, locator, source_record_id, source_payload,
     normalized, field_lineage, quality_flags)
SELECT run_id, document_id, locator, source_record_id, source_payload,
       normalized, field_lineage, quality_flags FROM keyed
ON CONFLICT (run_id, document_id, locator) DO UPDATE SET
    source_record_id = EXCLUDED.source_record_id, source_payload = EXCLUDED.source_payload,
    normalized = EXCLUDED.normalized, field_lineage = EXCLUDED.field_lineage,
    quality_flags = EXCLUDED.quality_flags;
</sql>
    <execute_each_row>Y</execute_each_row>
    <single_statement>Y</single_statement>
    <replace_variables>N</replace_variables>
    <quoteString>N</quoteString>
    <set_params>Y</set_params>
    <arguments>
      <argument>
        <name>run_id</name>
      </argument>
      <argument>
        <name>document_id</name>
      </argument>
      <argument>
        <name>locator</name>
      </argument>
      <argument>
        <name>source_payload_json</name>
      </argument>
      <argument>
        <name>normalized_block_json</name>
      </argument>
      <argument>
        <name>field_lineage_json</name>
      </argument>
      <argument>
        <name>quality_flags_json</name>
      </argument>
    </arguments>
    <connection>jobtology-postgres</connection>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>560</xloc>
      <yloc>440</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
  </transform>
  <transform>
    <type>DBJoin</type>
    <name>Confirm record write</name>
    <cache>N</cache>
    <cache_size>0</cache_size>
    <sql>SELECT EXISTS(SELECT 1 FROM ingestion.record r JOIN ingestion.run u USING(run_id)
WHERE r.run_id=? AND r.document_id=? AND r.locator=? AND r.normalized=?::jsonb-&gt;'row'-&gt;0 AND u.state='LOADING') AS record_written</sql>
    <rowlimit>0</rowlimit>
    <outer_join>N</outer_join>
    <parameter>
      <field>
        <name>run_id</name>
        <type>String</type>
      </field>
      <field>
        <name>document_id</name>
        <type>String</type>
      </field>
      <field>
        <name>locator</name>
        <type>String</type>
      </field>
      <field>
        <name>normalized_block_json</name>
        <type>String</type>
      </field>
    </parameter>
    <replace_vars>N</replace_vars>
    <connection>jobtology-postgres</connection>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>790</xloc>
      <yloc>440</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
  </transform>
  <transform>
    <type>FilterRows</type>
    <name>Record written</name>
    <compare>
      <condition>
        <negated>N</negated>
        <operator>-</operator>
        <leftvalue>record_written</leftvalue>
        <function>=</function>
        <value>
          <name>constant</name>
          <type>Boolean</type>
          <text>Y</text>
          <length>-1</length>
          <precision>-1</precision>
          <isnull>N</isnull>
        </value>
      </condition>
    </compare>
    <send_true_to>Record complete</send_true_to>
    <send_false_to>Record write failed</send_false_to>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>1020</xloc>
      <yloc>440</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
  </transform>
  <transform>
    <type>Dummy</type>
    <name>Record complete</name>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>100</xloc>
      <yloc>610</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
  </transform>
  <transform>
    <type>ExecSql</type>
    <name>Retain rejected posting</name>
    <sql>INSERT INTO ingestion.rejected_row(run_id,document_id,locator,error_code,source_payload)
SELECT ?,?,?,?,?::jsonb;</sql>
    <execute_each_row>Y</execute_each_row>
    <single_statement>Y</single_statement>
    <replace_variables>N</replace_variables>
    <quoteString>N</quoteString>
    <set_params>Y</set_params>
    <arguments>
      <argument>
        <name>run_id</name>
      </argument>
      <argument>
        <name>document_id</name>
      </argument>
      <argument>
        <name>locator</name>
      </argument>
      <argument>
        <name>record_error</name>
      </argument>
      <argument>
        <name>source_payload_json</name>
      </argument>
    </arguments>
    <connection>jobtology-postgres</connection>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>330</xloc>
      <yloc>610</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
  </transform>
  <transform>
    <type>Abort</type>
    <name>Record write failed</name>
    <row_threshold>0</row_threshold>
    <message>The run was not LOADING or the normalized record was not stored.</message>
    <always_log_rows>N</always_log_rows>
    <abort_option>ABORT_WITH_ERROR</abort_option>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>560</xloc>
      <yloc>610</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
  </transform>
  <transform_error_handling />
  <attributes />
</pipeline>