<?xml version='1.0' encoding='UTF-8'?>
<pipeline>
  <info>
    <name>load_document</name>
    <description>Read the archived JSON, validate its envelope, normalize every source object and retain rejected rows.</description>
    <pipeline_type>Normal</pipeline_type>
    <size_rowset>1000</size_rowset>
    <parameters>
      <parameter>
        <name>DOCUMENT_ID</name>
        <default_value />
        <description>DOCUMENT_ID</description>
      </parameter>
    </parameters>
  </info>
  <notepads />
  <order>
    <hop>
      <from>Document identity</from>
      <to>Read document manifest</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Read document manifest</from>
      <to>HTTP success</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Read saved JSON</from>
      <to>Validate envelope</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Validate envelope</from>
      <to>Save envelope metadata</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Save envelope metadata</from>
      <to>Envelope accepted</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Envelope accepted</from>
      <to>Split source objects</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>HTTP success</from>
      <to>Read saved JSON</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>HTTP success</from>
      <to>HTTP failure</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Envelope accepted</from>
      <to>Envelope failure</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Split source objects</from>
      <to>Normalize posting fields</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Normalize posting fields</from>
      <to>Valid posting</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Valid posting</from>
      <to>Load posting</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Load posting</from>
      <to>Confirm record write</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Confirm record write</from>
      <to>Record written</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Record written</from>
      <to>Record complete</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Valid posting</from>
      <to>Retain rejected posting</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Record written</from>
      <to>Record write failed</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <type>GetVariable</type>
    <name>Document identity</name>
    <fields>
      <field>
        <name>run_id</name>
        <variable>${JOB_ALIO_RUN_ID}</variable>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
      </field>
      <field>
        <name>document_id</name>
        <variable>${DOCUMENT_ID}</variable>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
      </field>
      <field>
        <name>raw_root</name>
        <variable>${RAW_ROOT}</variable>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
      </field>
      <field>
        <name>max_pages</name>
        <variable>${MAX_PAGES}</variable>
        <type>Integer</type>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
      </field>
      <field>
        <name>max_requests</name>
        <variable>${MAX_REQUESTS}</variable>
        <type>Integer</type>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
      </field>
      <field>
        <name>mode</name>
        <variable>${MODE}</variable>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
      </field>
    </fields>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>100</xloc>
      <yloc>100</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
  </transform>
  <transform>
    <type>DBJoin</type>
    <name>Read document manifest</name>
    <cache>N</cache>
    <cache_size>0</cache_size>
    <sql>SELECT ?||'/'||d.raw_path AS raw_filename,d.page_no,d.confirmation_no,d.http_status,d.byte_length,p.page_size,p.expected_total,p.partition_id,p.kind
FROM ingestion.document d JOIN ingestion.partition p USING(run_id,partition_id) JOIN ingestion.run u USING(run_id)
WHERE d.run_id=? AND d.document_id=? AND u.state='LOADING' AND u.source_id='job_alio'</sql>
    <rowlimit>0</rowlimit>
    <outer_join>N</outer_join>
    <parameter>
      <field>
        <name>raw_root</name>
        <type>String</type>
      </field>
      <field>
        <name>run_id</name>
        <type>String</type>
      </field>
      <field>
        <name>document_id</name>
        <type>String</type>
      </field>
    </parameter>
    <replace_vars>N</replace_vars>
    <connection>jobtology-postgres</connection>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>330</xloc>
      <yloc>100</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
  </transform>
  <transform>
    <type>FilterRows</type>
    <name>HTTP success</name>
    <compare>
      <condition>
        <negated>N</negated>
        <operator>-</operator>
        <leftvalue>http_status</leftvalue>
        <function>=</function>
        <value>
          <name>constant</name>
          <type>Integer</type>
          <text>200</text>
          <length>-1</length>
          <precision>-1</precision>
          <isnull>N</isnull>
        </value>
      </condition>
    </compare>
    <send_true_to>Read saved JSON</send_true_to>
    <send_false_to>HTTP failure</send_false_to>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>560</xloc>
      <yloc>100</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
  </transform>
  <transform>
    <type>JsonInput</type>
    <name>Read saved JSON</name>
    <include>N</include>
    <include_field />
    <rownum>N</rownum>
    <rownum_field />
    <limit>0</limit>
    <valueField>raw_filename</valueField>
    <IsInFields>Y</IsInFields>
    <IsAFile>Y</IsAFile>
    <addresultfile>N</addresultfile>
    <IsIgnoreEmptyFile>N</IsIgnoreEmptyFile>
    <doNotFailIfNoFile>N</doNotFailIfNoFile>
    <ignoreMissingPath>N</ignoreMissingPath>
    <readurl>N</readurl>
    <removeSourceField>N</removeSourceField>
    <defaultPathLeafToNull>Y</defaultPathLeafToNull>
    <files />
    <fields>
      <field>
        <name>envelope_json</name>
        <path>$</path>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
        <repeat>N</repeat>
      </field>
    </fields>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>790</xloc>
      <yloc>100</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
  </transform>
  <transform>
    <type>DBJoin</type>
    <name>Validate envelope</name>
    <cache>N</cache>
    <cache_size>0</cache_size>
    <sql>WITH input AS (SELECT ?::jsonb AS b,?::integer AS requested_page,?::integer AS requested_size,
 ?::integer AS previous_total,?::bigint AS byte_length,?::integer AS max_pages,?::integer AS max_requests,?::text AS mode,?::text AS kind), parsed AS (
 SELECT *, CASE WHEN kind='DETAIL' THEN 1 WHEN b-&gt;&gt;'totalCount' ~ '^[0-9]+$' AND length(b-&gt;&gt;'totalCount')&lt;=10 AND (b-&gt;&gt;'totalCount')::numeric&lt;=2147483647 THEN (b-&gt;&gt;'totalCount')::integer END AS declared_total,
 CASE WHEN kind='DETAIL' AND jsonb_typeof(b-&gt;'result')='object' THEN 1 WHEN kind='PAGED' AND jsonb_typeof(b-&gt;'result')='array' THEN jsonb_array_length(b-&gt;'result') END AS item_count,b-&gt;&gt;'resultCode' AS provider_result FROM input), checked AS (
 SELECT *,CASE WHEN jsonb_typeof(b)&lt;&gt;'object' OR provider_result IS DISTINCT FROM '200' THEN 'INVALID_PROVIDER_RESULT'
 WHEN byte_length&lt;=0 OR byte_length&gt;67108864 THEN 'INVALID_RESPONSE_SIZE'
 WHEN declared_total IS NULL OR item_count IS NULL THEN 'INVALID_ENVELOPE'
 WHEN kind='PAGED' AND (max_pages&lt;1 OR (CASE WHEN declared_total=0 AND mode='FULL' THEN 2 WHEN mode='SMOKE' THEN 1 ELSE ceil(declared_total::numeric/requested_size) END)&gt;max_pages) THEN 'PAGE_BUDGET_EXCEEDED'
 WHEN kind='PAGED' AND (CASE WHEN mode='SMOKE' THEN 1+least(declared_total,requested_size) WHEN declared_total=0 THEN 2 ELSE declared_total+ceil(declared_total::numeric/requested_size) END)&gt;max_requests THEN 'REQUEST_BUDGET_EXCEEDED'
 WHEN previous_total IS NOT NULL AND previous_total&lt;&gt;declared_total THEN 'TOTAL_CHANGED'
 WHEN kind='PAGED' AND b-&gt;'pageNo' IS NOT NULL AND b-&gt;'pageNo'&lt;&gt;'null'::jsonb AND b-&gt;&gt;'pageNo'&lt;&gt;requested_page::text THEN 'PAGE_MISMATCH'
 WHEN kind='PAGED' AND b-&gt;'numOfRows' IS NOT NULL AND b-&gt;'numOfRows'&lt;&gt;'null'::jsonb AND b-&gt;&gt;'numOfRows'&lt;&gt;requested_size::text THEN 'PAGE_SIZE_MISMATCH'
 WHEN kind='PAGED' AND item_count&lt;&gt;greatest(0,least(requested_size,declared_total-(requested_page-1)*requested_size)) THEN 'PAGE_ROW_COUNT_MISMATCH'
 ELSE NULL END AS envelope_error FROM parsed)
SELECT declared_total,item_count,provider_result,envelope_error,envelope_error IS NULL AS envelope_valid FROM checked</sql>
    <rowlimit>0</rowlimit>
    <outer_join>N</outer_join>
    <parameter>
      <field>
        <name>envelope_json</name>
        <type>String</type>
      </field>
      <field>
        <name>page_no</name>
        <type>Integer</type>
      </field>
      <field>
        <name>page_size</name>
        <type>Integer</type>
      </field>
      <field>
        <name>expected_total</name>
        <type>Integer</type>
      </field>
      <field>
        <name>byte_length</name>
        <type>Integer</type>
      </field>
      <field>
        <name>max_pages</name>
        <type>Integer</type>
      </field>
      <field>
        <name>max_requests</name>
        <type>Integer</type>
      </field>
      <field>
        <name>mode</name>
        <type>String</type>
      </field>
      <field>
        <name>kind</name>
        <type>String</type>
      </field>
    </parameter>
    <replace_vars>N</replace_vars>
    <connection>jobtology-postgres</connection>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>1020</xloc>
      <yloc>100</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
  </transform>
  <transform>
    <type>ExecSql</type>
    <name>Save envelope metadata</name>
    <sql>WITH updated AS (
 UPDATE ingestion.document SET declared_total=?,item_count=?,provider_result=?,effective_page=page_no,effective_page_size=?,selected=CAST(? AS boolean)
 WHERE run_id=? AND document_id=? RETURNING run_id,partition_id,declared_total,selected,page_no,confirmation_no
) UPDATE ingestion.partition p SET expected_total=d.declared_total FROM updated d
WHERE p.run_id=d.run_id AND p.partition_id=d.partition_id AND p.expected_total IS NULL
AND d.selected AND d.page_no=1 AND d.confirmation_no=0;</sql>
    <execute_each_row>Y</execute_each_row>
    <single_statement>Y</single_statement>
    <replace_variables>N</replace_variables>
    <quoteString>N</quoteString>
    <set_params>Y</set_params>
    <arguments>
      <argument>
        <name>declared_total</name>
      </argument>
      <argument>
        <name>item_count</name>
      </argument>
      <argument>
        <name>provider_result</name>
      </argument>
      <argument>
        <name>page_size</name>
      </argument>
      <argument>
        <name>envelope_valid</name>
      </argument>
      <argument>
        <name>run_id</name>
      </argument>
      <argument>
        <name>document_id</name>
      </argument>
    </arguments>
    <connection>jobtology-postgres</connection>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>100</xloc>
      <yloc>270</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
  </transform>
  <transform>
    <type>FilterRows</type>
    <name>Envelope accepted</name>
    <compare>
      <condition>
        <negated>N</negated>
        <operator>-</operator>
        <leftvalue>envelope_valid</leftvalue>
        <function>=</function>
        <value>
          <name>constant</name>
          <type>Boolean</type>
          <text>Y</text>
          <length>-1</length>
          <precision>-1</precision>
          <isnull>N</isnull>
        </value>
      </condition>
    </compare>
    <send_true_to>Split source objects</send_true_to>
    <send_false_to>Envelope failure</send_false_to>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>330</xloc>
      <yloc>270</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
  </transform>
  <transform>
    <type>DBJoin</type>
    <name>Split source objects</name>
    <cache>N</cache>
    <cache_size>0</cache_size>
    <sql>WITH input AS (SELECT ?::json AS b,?::text AS kind)
SELECT value::text AS source_payload_json,'/result/'||(ordinality-1)::text AS locator FROM input
CROSS JOIN LATERAL json_array_elements(CASE WHEN kind='PAGED' THEN b-&gt;'result' ELSE '[]'::json END) WITH ORDINALITY
UNION ALL SELECT (b-&gt;'result')::text,'/result' FROM input WHERE kind='DETAIL'</sql>
    <rowlimit>0</rowlimit>
    <outer_join>N</outer_join>
    <parameter>
      <field>
        <name>envelope_json</name>
        <type>String</type>
      </field>
      <field>
        <name>kind</name>
        <type>String</type>
      </field>
    </parameter>
    <replace_vars>N</replace_vars>
    <connection>jobtology-postgres</connection>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>560</xloc>
      <yloc>270</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
  </transform>
  <transform>
    <type>Abort</type>
    <name>HTTP failure</name>
    <row_threshold>0</row_threshold>
    <message>JOB-ALIO returned a non-200 HTTP response. The body remains archived.</message>
    <always_log_rows>N</always_log_rows>
    <abort_option>ABORT_WITH_ERROR</abort_option>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>790</xloc>
      <yloc>270</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
  </transform>
  <transform>
    <type>Abort</type>
    <name>Envelope failure</name>
    <row_threshold>0</row_threshold>
    <message>JOB-ALIO envelope or page coverage is invalid. Inspect the archived document.</message>
    <always_log_rows>N</always_log_rows>
    <abort_option>ABORT_WITH_ERROR</abort_option>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>1020</xloc>
      <yloc>270</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
  </transform>
  <transform>
    <type>DBJoin</type>
    <name>Normalize posting fields</name>
    <cache>N</cache>
    <cache_size>0</cache_size>
    <sql>WITH source AS (SELECT ?::json AS j,?::text AS partition_id), cleaned AS (
 SELECT j,j::jsonb AS b,partition_id,NULLIF(btrim(normalize(replace(replace(b-&gt;&gt;'recrutPblntSn', E'\r\n', E'\n'), E'\r', E'\n'), NFC), chr(9) || chr(10) || chr(11) || chr(12) || chr(13) || chr(28) || chr(29) || chr(30) || chr(31) || chr(32) || chr(133) || chr(160) || chr(5760) || chr(8192) || chr(8193) || chr(8194) || chr(8195) || chr(8196) || chr(8197) || chr(8198) || chr(8199) || chr(8200) || chr(8201) || chr(8202) || chr(8232) || chr(8233) || chr(8239) || chr(8287) || chr(12288)),'') AS posting_id,
NULLIF(btrim(normalize(replace(replace(b-&gt;&gt;'recrutPbancTtl', E'\r\n', E'\n'), E'\r', E'\n'), NFC), chr(9) || chr(10) || chr(11) || chr(12) || chr(13) || chr(28) || chr(29) || chr(30) || chr(31) || chr(32) || chr(133) || chr(160) || chr(5760) || chr(8192) || chr(8193) || chr(8194) || chr(8195) || chr(8196) || chr(8197) || chr(8198) || chr(8199) || chr(8200) || chr(8201) || chr(8202) || chr(8232) || chr(8233) || chr(8239) || chr(8287) || chr(12288)),'') AS title,
NULLIF(btrim(normalize(replace(replace(b-&gt;&gt;'pblntInstCd', E'\r\n', E'\n'), E'\r', E'\n'), NFC), chr(9) || chr(10) || chr(11) || chr(12) || chr(13) || chr(28) || chr(29) || chr(30) || chr(31) || chr(32) || chr(133) || chr(160) || chr(5760) || chr(8192) || chr(8193) || chr(8194) || chr(8195) || chr(8196) || chr(8197) || chr(8198) || chr(8199) || chr(8200) || chr(8201) || chr(8202) || chr(8232) || chr(8233) || chr(8239) || chr(8287) || chr(12288)),'') AS organization_code,
NULLIF(btrim(normalize(replace(replace(b-&gt;&gt;'instNm', E'\r\n', E'\n'), E'\r', E'\n'), NFC), chr(9) || chr(10) || chr(11) || chr(12) || chr(13) || chr(28) || chr(29) || chr(30) || chr(31) || chr(32) || chr(133) || chr(160) || chr(5760) || chr(8192) || chr(8193) || chr(8194) || chr(8195) || chr(8196) || chr(8197) || chr(8198) || chr(8199) || chr(8200) || chr(8201) || chr(8202) || chr(8232) || chr(8233) || chr(8239) || chr(8287) || chr(12288)),'') AS organization_name,
NULLIF(btrim(normalize(replace(replace(b-&gt;&gt;'pbancBgngYmd', E'\r\n', E'\n'), E'\r', E'\n'), NFC), chr(9) || chr(10) || chr(11) || chr(12) || chr(13) || chr(28) || chr(29) || chr(30) || chr(31) || chr(32) || chr(133) || chr(160) || chr(5760) || chr(8192) || chr(8193) || chr(8194) || chr(8195) || chr(8196) || chr(8197) || chr(8198) || chr(8199) || chr(8200) || chr(8201) || chr(8202) || chr(8232) || chr(8233) || chr(8239) || chr(8287) || chr(12288)),'') AS date_posted,
NULLIF(btrim(normalize(replace(replace(b-&gt;&gt;'pbancEndYmd', E'\r\n', E'\n'), E'\r', E'\n'), NFC), chr(9) || chr(10) || chr(11) || chr(12) || chr(13) || chr(28) || chr(29) || chr(30) || chr(31) || chr(32) || chr(133) || chr(160) || chr(5760) || chr(8192) || chr(8193) || chr(8194) || chr(8195) || chr(8196) || chr(8197) || chr(8198) || chr(8199) || chr(8200) || chr(8201) || chr(8202) || chr(8232) || chr(8233) || chr(8239) || chr(8287) || chr(12288)),'') AS closing_date,
NULLIF(btrim(normalize(replace(replace(b-&gt;&gt;'srcUrl', E'\r\n', E'\n'), E'\r', E'\n'), NFC), chr(9) || chr(10) || chr(11) || chr(12) || chr(13) || chr(28) || chr(29) || chr(30) || chr(31) || chr(32) || chr(133) || chr(160) || chr(5760) || chr(8192) || chr(8193) || chr(8194) || chr(8195) || chr(8196) || chr(8197) || chr(8198) || chr(8199) || chr(8200) || chr(8201) || chr(8202) || chr(8232) || chr(8233) || chr(8239) || chr(8287) || chr(12288)),'') AS source_url,
NULLIF(btrim(normalize(replace(replace(b-&gt;&gt;'recrutSeNm', E'\r\n', E'\n'), E'\r', E'\n'), NFC), chr(9) || chr(10) || chr(11) || chr(12) || chr(13) || chr(28) || chr(29) || chr(30) || chr(31) || chr(32) || chr(133) || chr(160) || chr(5760) || chr(8192) || chr(8193) || chr(8194) || chr(8195) || chr(8196) || chr(8197) || chr(8198) || chr(8199) || chr(8200) || chr(8201) || chr(8202) || chr(8232) || chr(8233) || chr(8239) || chr(8287) || chr(12288)),'') AS recruitment_type,
NULLIF(btrim(normalize(replace(replace(b-&gt;&gt;'acbgCondNmLst', E'\r\n', E'\n'), E'\r', E'\n'), NFC), chr(9) || chr(10) || chr(11) || chr(12) || chr(13) || chr(28) || chr(29) || chr(30) || chr(31) || chr(32) || chr(133) || chr(160) || chr(5760) || chr(8192) || chr(8193) || chr(8194) || chr(8195) || chr(8196) || chr(8197) || chr(8198) || chr(8199) || chr(8200) || chr(8201) || chr(8202) || chr(8232) || chr(8233) || chr(8239) || chr(8287) || chr(12288)),'') AS education,
NULLIF(btrim(normalize(replace(replace(b-&gt;&gt;'hireTypeNmLst', E'\r\n', E'\n'), E'\r', E'\n'), NFC), chr(9) || chr(10) || chr(11) || chr(12) || chr(13) || chr(28) || chr(29) || chr(30) || chr(31) || chr(32) || chr(133) || chr(160) || chr(5760) || chr(8192) || chr(8193) || chr(8194) || chr(8195) || chr(8196) || chr(8197) || chr(8198) || chr(8199) || chr(8200) || chr(8201) || chr(8202) || chr(8232) || chr(8233) || chr(8239) || chr(8287) || chr(12288)),'') AS employment_type,
