<?xml version='1.0' encoding='UTF-8'?>
<pipeline>
  <info>
    <name>process_file</name>
    <description>Download, archive and parse exactly one reserved attachment.</description>
    <pipeline_type>Normal</pipeline_type>
    <size_rowset>100</size_rowset>
    <parameters>
      <parameter>
        <name>ATTEMPT_ID</name>
        <default_value />
        <description>ATTEMPT_ID</description>
      </parameter>
    </parameters>
  </info>
  <notepads />
  <order>
    <hop>
      <from>Reserved attempt</from>
      <to>Reserved file</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Reserved file</from>
      <to>Space document requests</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Space document requests</from>
      <to>Download official attachment</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Download official attachment</from>
      <to>Validate received body</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Validate received body</from>
      <to>Archive original response</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Archive original response</from>
      <to>Release received bytes</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Release received bytes</from>
      <to>Verify saved bytes</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Verify saved bytes</from>
      <to>Archive only identical bytes</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Archive only identical bytes</from>
      <to>Archive hash matches</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Archive hash matches</from>
      <to>Register response</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Register response</from>
      <to>Parse eligibility</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Parse eligibility</from>
      <to>Document body</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Document body</from>
      <to>Parse document with Tika</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Parse document with Tika</from>
      <to>Recheck parser input</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Recheck parser input</from>
      <to>Store document sections</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Archive hash matches</from>
      <to>Archive mismatch</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Document body</from>
      <to>Recorded download outcome</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <type>GetVariable</type>
    <name>Reserved attempt</name>
    <fields>
      <field>
        <name>attempt_id</name>
        <variable>${ATTEMPT_ID}</variable>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
      </field>
    </fields>
    <copies>1</copies>
    <distribute>Y</distribute>
    <GUI>
      <xloc>80</xloc>
      <yloc>80</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
  </transform>
  <transform>
    <type>DBJoin</type>
    <name>Reserved file</name>
    <connection>jobtology-postgres</connection>
    <sql>SELECT a.raw_path AS raw_filename,d.request_url,d.extension FROM attachment.attempt a JOIN attachment.document d USING(document_id) WHERE a.attempt_id=? AND a.state='RESERVED'</sql>
    <cache>N</cache>
    <cache_size>0</cache_size>
    <rowlimit>0</rowlimit>
    <outer_join>N</outer_join>
    <replace_vars>N</replace_vars>
    <parameter>
      <field>
        <name>attempt_id</name>
        <type>String</type>
      </field>
    </parameter>
    <copies>1</copies>
    <distribute>Y</distribute>
    <GUI>
      <xloc>320</xloc>
      <yloc>80</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
  </transform>
  <transform>
    <type>Delay</type>
    <name>Space document requests</name>
    <timeout>200</timeout>
    <scaletime>milliseconds</scaletime>
    <scaletime_from_field>N</scaletime_from_field>
    <copies>1</copies>
    <distribute>Y</distribute>
    <GUI>
      <xloc>560</xloc>
      <yloc>80</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
  </transform>
  <transform>
    <type>Rest</type>
    <name>Download official attachment</name>
    <applicationType>JSON</applicationType>
    <connection_name />
    <url />
    <urlInField>Y</urlInField>
    <httpLogin />
    <httpPassword>Encrypted </httpPassword>
    <non_preemptive_basic_auth>N</non_preemptive_basic_auth>
    <method>GET</method>
    <dynamicMethod>N</dynamicMethod>
    <connectionTimeout>10000</connectionTimeout>
    <readTimeout>60000</readTimeout>
    <ignoreSsl>N</ignoreSsl>
    <headers />
    <parameters />
    <matrixParameters />
    <result>
      <name>response_bytes</name>
      <code>http_status</code>
      <binary>Y</binary>
      <response_header>response_headers</response_header>
    </result>
    <retryTimes>0</retryTimes>
    <retryDelayMs>200</retryDelayMs>
    <retryStatusCodes>
      <retryStatusCode>503</retryStatusCode>
      <retryStatusCode>504</retryStatusCode>
      <retryStatusCode>429</retryStatusCode>
      <retryStatusCode>500</retryStatusCode>
      <retryStatusCode>502</retryStatusCode>
    </retryStatusCodes>
    <retryMethods>
      <retryMethod>GET</retryMethod>
      <retryMethod>DELETE</retryMethod>
      <retryMethod>PUT</retryMethod>
    </retryMethods>
    <paginationEnabled>N</paginationEnabled>
    <maxPagesLoops>256</maxPagesLoops>
    <streamingEnabled>N</streamingEnabled>
    <streamingFormat>NDJSON</streamingFormat>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>624</xloc>
      <yloc>48</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
    <attributes />
    <urlField>request_url</urlField>
    <GUI>
      <xloc>800</xloc>
      <yloc>80</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
  </transform>
  <transform>
    <type>DBJoin</type>
    <name>Validate received body</name>
    <connection>jobtology-postgres</connection>
    <sql>SELECT encode(sha256(?::bytea),'hex') AS received_hash,octet_length(?::bytea)::bigint AS received_size,attachment.body_issue(?::integer,?::bytea,?) AS body_issue</sql>
    <cache>N</cache>
    <cache_size>0</cache_size>
    <rowlimit>0</rowlimit>
    <outer_join>N</outer_join>
    <replace_vars>N</replace_vars>
    <parameter>
      <field>
        <name>response_bytes</name>
        <type>Binary</type>
      </field>
      <field>
        <name>response_bytes</name>
        <type>Binary</type>
      </field>
      <field>
        <name>http_status</name>
        <type>Integer</type>
      </field>
      <field>
        <name>response_bytes</name>
        <type>Binary</type>
      </field>
      <field>
        <name>extension</name>
        <type>String</type>
      </field>
    </parameter>
    <copies>1</copies>
    <distribute>Y</distribute>
    <GUI>
      <xloc>1040</xloc>
      <yloc>80</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
  </transform>
  <transform>
    <type>BinaryFileOutput</type>
    <name>Archive original response</name>
    <binaryfield>response_bytes</binaryfield>
    <filenamefield>raw_filename</filenamefield>
    <createparentfolder>Y</createparentfolder>
    <overwritefile>N</overwritefile>
    <addresultfilenames>N</addresultfilenames>
    <copies>1</copies>
    <distribute>Y</distribute>
    <GUI>
      <xloc>80</xloc>
      <yloc>240</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
  </transform>
  <transform>
    <type>SelectValues</type>
    <name>Release received bytes</name>
    <fields>
      <select_unspecified>Y</select_unspecified>
      <remove>
        <name>response_bytes</name>
      </remove>
    </fields>
    <copies>1</copies>
    <distribute>Y</distribute>
    <GUI>
      <xloc>320</xloc>
      <yloc>240</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
  </transform>
  <transform>
    <type>Calculator</type>
    <name>Verify saved bytes</name>
    <failIfNoFile>Y</failIfNoFile>
    <calculation>
      <field_name>saved_hash</field_name>
      <calc_type>SHA256</calc_type>
      <field_a>raw_filename</field_a>
      <value_type>String</value_type>
      <value_length>-1</value_length>
      <value_precision>-1</value_precision>
      <remove>N</remove>
    </calculation>
    <copies>1</copies>
    <distribute>Y</distribute>
    <GUI>
      <xloc>560</xloc>
      <yloc>240</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
  </transform>
  <transform>
    <type>DBJoin</type>
    <name>Archive only identical bytes</name>
    <connection>jobtology-postgres</connection>
    <sql>SELECT CASE WHEN lower(?)=? THEN 'Y' ELSE 'N' END AS hash_matches</sql>
    <cache>N</cache>
    <cache_size>0</cache_size>
    <rowlimit>0</rowlimit>
    <outer_join>N</outer_join>
    <replace_vars>N</replace_vars>
    <parameter>
      <field>
        <name>saved_hash</name>
        <type>String</type>
      </field>
      <field>
        <name>received_hash</name>
        <type>String</type>
      </field>
    </parameter>
    <copies>1</copies>
    <distribute>Y</distribute>
    <GUI>
      <xloc>800</xloc>
      <yloc>240</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
  </transform>
  <transform>
    <type>FilterRows</type>
    <name>Archive hash matches</name>
    <send_true_to>Register response</send_true_to>
    <send_false_to>Archive mismatch</send_false_to>
    <compare>
      <condition>
        <negated>N</negated>
        <operator>-</operator>
        <leftvalue>hash_matches</leftvalue>
        <function>=</function>
        <value>
          <name>constant</name>
          <type>String</type>
          <text>Y</text>
          <length>-1</length>
          <precision>-1</precision>
          <isnull>N</isnull>
        </value>
      </condition>
    </compare>
    <copies>1</copies>
    <distribute>Y</distribute>
    <GUI>
      <xloc>1040</xloc>
      <yloc>240</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
  </transform>
  <transform>
    <type>ExecSql</type>
    <name>Register response</name>
    <connection>jobtology-postgres</connection>
    <sql>SELECT attachment.archive(?,?::integer,?,?,?::bigint,?)</sql>
    <execute_each_row>Y</execute_each_row>
    <single_statement>Y</single_statement>
    <set_params>Y</set_params>
    <replace_variables>N</replace_variables>
    <quoteString>N</quoteString>
    <arguments>
      <argument>
        <name>attempt_id</name>
      </argument>
      <argument>
        <name>http_status</name>
      </argument>
      <argument>
        <name>response_headers</name>
      </argument>
      <argument>
        <name>received_hash</name>
      </argument>
      <argument>
        <name>received_size</name>
      </argument>
      <argument>
        <name>body_issue</name>
      </argument>
    </arguments>
    <copies>1</copies>
    <distribute>Y</distribute>
    <GUI>
      <xloc>80</xloc>
      <yloc>400</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
  </transform>
  <transform>
    <type>DBJoin</type>
    <name>Parse eligibility</name>
    <connection>jobtology-postgres</connection>
    <sql>SELECT state='ARCHIVED' AS can_parse FROM attachment.attempt WHERE attempt_id=?</sql>
    <cache>N</cache>
    <cache_size>0</cache_size>
    <rowlimit>0</rowlimit>
    <outer_join>N</outer_join>
    <replace_vars>N</replace_vars>
    <parameter>
      <field>
        <name>attempt_id</name>
        <type>String</type>
      </field>
    </parameter>
    <copies>1</copies>
    <distribute>Y</distribute>
    <GUI>
      <xloc>320</xloc>
      <yloc>400</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
  </transform>
  <transform>
    <type>FilterRows</type>
    <name>Document body</name>
    <send_true_to>Parse document with Tika</send_true_to>
    <send_false_to>Recorded download outcome</send_false_to>
    <compare>
      <condition>
        <negated>N</negated>
        <operator>-</operator>
        <leftvalue>can_parse</leftvalue>
        <function>=</function>
        <value>
          <name>constant</name>
          <type>Boolean</type>
          <text>Y</text>
          <length>-1</length>
          <precision>-1</precision>
          <isnull>N</isnull>
        </value>
      </condition>
    </compare>
    <copies>1</copies>
    <distribute>Y</distribute>
    <GUI>
      <xloc>560</xloc>
      <yloc>400</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
  </transform>
  <transform>
    <type>Tika</type>
    <name>Parse document with Tika</name>
    <file-in-field>Y</file-in-field>
    <dynamic-filename-field>raw_filename</dynamic-filename-field>
    <output-format>Xml</output-format>
    <encoding>UTF-8</encoding>
    <content-field>document_xml</content-field>
    <metadata-field>document_metadata</metadata-field>
    <row-limit>0</row-limit>
    <ignore-empty-file>N</ignore-empty-file>
    <add-result-file>N</add-result-file>
    <copies>1</copies>
    <distribute>Y</distribute>
    <GUI>
      <xloc>800</xloc>
      <yloc>400</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
  </transform>
  <transform>
    <type>Calculator</type>
    <name>Recheck parser input</name>
    <failIfNoFile>Y</failIfNoFile>
    <calculation>
      <field_name>parsed_input_hash</field_name>
      <calc_type>SHA256</calc_type>
      <field_a>raw_filename</field_a>
      <value_type>String</value_type>
      <value_length>-1</value_length>
      <value_precision>-1</value_precision>
      <remove>N</remove>
    </calculation>
    <copies>1</copies>
    <distribute>Y</distribute>
    <GUI>
      <xloc>1040</xloc>
      <yloc>400</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
  </transform>
  <transform>
    <type>ExecSql</type>
    <name>Store document sections</name>
    <connection>jobtology-postgres</connection>
    <sql>SELECT attachment.save_parse(?,?,?,?)</sql>
    <execute_each_row>Y</execute_each_row>
    <single_statement>Y</single_statement>
    <set_params>Y</set_params>
    <replace_variables>N</replace_variables>
    <quoteString>N</quoteString>
    <arguments>
      <argument>
        <name>attempt_id</name>
      </argument>
      <argument>
        <name>document_xml</name>
      </argument>
      <argument>
        <name>document_metadata</name>
      </argument>
      <argument>
        <name>parsed_input_hash</name>
      </argument>
    </arguments>
    <copies>1</copies>
    <distribute>Y</distribute>
    <GUI>
      <xloc>80</xloc>
      <yloc>560</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
  </transform>
  <transform>
    <type>Abort</type>
    <name>Archive mismatch</name>
    <message>Received bytes do not match the saved attachment.</message>
    <always_log_rows>N</always_log_rows>
    <abort_option>ABORT_WITH_ERROR</abort_option>
    <row_threshold>0</row_threshold>
    <copies>1</copies>
    <distribute>Y</distribute>
    <GUI>
      <xloc>320</xloc>
      <yloc>560</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
  </transform>
  <transform>
    <type>Dummy</type>
    <name>Recorded download outcome</name>
    <copies>1</copies>
    <distribute>Y</distribute>
    <GUI>
      <xloc>560</xloc>
      <yloc>560</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
  </transform>
  <transform_error_handling />
  <attributes />
</pipeline>