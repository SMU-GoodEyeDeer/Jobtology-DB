<?xml version='1.0' encoding='UTF-8'?>
<pipeline>
  <info>
    <name>download_batch</name>
    <description>Process pending attachments sequentially; pair each child result with its input ordinal.</description>
    <pipeline_type>Normal</pipeline_type>
    <size_rowset>100</size_rowset>
    <parameters />
  </info>
  <notepads />
  <order>
    <hop>
      <from>Execution choice</from>
      <to>Downloads enabled</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Downloads enabled</from>
      <to>Pending documents</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Pending documents</from>
      <to>Reserve one attempt</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Reserve one attempt</from>
      <to>Fetch and parse one file</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Fetch and parse one file</from>
      <to>Number child results</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Fetch and parse one file</from>
      <to>Original request rows</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Original request rows</from>
      <to>Pair child with request</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Pair child with request</from>
      <to>Record child outcome</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Number child results</from>
      <to>Pair child with request</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Downloads enabled</from>
      <to>Plan only</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <type>GetVariable</type>
    <name>Execution choice</name>
    <fields>
      <field>
        <name>batch_id</name>
        <variable>${ATTACHMENT_BATCH_ID}</variable>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
      </field>
      <field>
        <name>execute_downloads</name>
        <variable>${EXECUTE_DOWNLOADS}</variable>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
      </field>
    </fields>
    <copies>1</copies>
    <distribute>Y</distribute>
    <GUI>
      <xloc>80</xloc>
      <yloc>80</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
  </transform>
  <transform>
    <type>FilterRows</type>
    <name>Downloads enabled</name>
    <send_true_to>Pending documents</send_true_to>
    <send_false_to>Plan only</send_false_to>
    <compare>
      <condition>
        <negated>N</negated>
        <operator>-</operator>
        <leftvalue>execute_downloads</leftvalue>
        <function>=</function>
        <value>
          <name>constant</name>
          <type>String</type>
          <text>Y</text>
          <length>-1</length>
          <precision>-1</precision>
          <isnull>N</isnull>
        </value>
      </condition>
    </compare>
    <copies>1</copies>
    <distribute>Y</distribute>
    <GUI>
      <xloc>320</xloc>
      <yloc>80</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
  </transform>
  <transform>
    <type>DBJoin</type>
    <name>Pending documents</name>
    <connection>jobtology-postgres</connection>
    <sql>SELECT d.document_id,row_number() OVER(ORDER BY d.posting_id,d.file_ordinal) AS request_no FROM attachment.document d WHERE d.batch_id=? AND d.disposition='PLANNED' AND NOT EXISTS(SELECT 1 FROM attachment.attempt a WHERE a.document_id=d.document_id) ORDER BY d.posting_id,d.file_ordinal</sql>
    <cache>N</cache>
    <cache_size>0</cache_size>
    <rowlimit>0</rowlimit>
    <outer_join>N</outer_join>
    <replace_vars>N</replace_vars>
    <parameter>
      <field>
        <name>batch_id</name>
        <type>String</type>
      </field>
    </parameter>
    <copies>1</copies>
    <distribute>Y</distribute>
    <GUI>
      <xloc>560</xloc>
      <yloc>80</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
  </transform>
  <transform>
    <type>DBJoin</type>
    <name>Reserve one attempt</name>
    <connection>jobtology-postgres</connection>
    <sql>SELECT attachment.reserve(?) AS attempt_id</sql>
    <cache>N</cache>
    <cache_size>0</cache_size>
    <rowlimit>0</rowlimit>
    <outer_join>N</outer_join>
    <replace_vars>N</replace_vars>
    <parameter>
      <field>
        <name>document_id</name>
        <type>String</type>
      </field>
    </parameter>
    <copies>1</copies>
    <distribute>Y</distribute>
    <GUI>
      <xloc>800</xloc>
      <yloc>80</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
  </transform>
  <transform>
    <type>PipelineExecutor</type>
    <name>Fetch and parse one file</name>
    <run_configuration>attachment-local</run_configuration>
    <filenameInField>N</filenameInField>
    <group_size>1</group_size>
    <group_field />
    <group_time />
    <parameters>
      <variable_mapping>
        <variable>ATTEMPT_ID</variable>
        <field>attempt_id</field>
        <input />
      </variable_mapping>
    </parameters>
    <inherit_all_vars>Y</inherit_all_vars>
    <execution_result_target_transform>Number child results</execution_result_target_transform>
    <execution_time_field>ExecutionTime</execution_time_field>
    <execution_result_field>ExecutionResult</execution_result_field>
    <execution_errors_field>ExecutionNrErrors</execution_errors_field>
    <execution_lines_read_field>ExecutionLinesRead</execution_lines_read_field>
    <execution_lines_written_field>ExecutionLinesWritten</execution_lines_written_field>
    <execution_lines_input_field>ExecutionLinesInput</execution_lines_input_field>
    <execution_lines_output_field>ExecutionLinesOutput</execution_lines_output_field>
    <execution_lines_rejected_field>ExecutionLinesRejected</execution_lines_rejected_field>
    <execution_lines_updated_field>ExecutionLinesUpdated</execution_lines_updated_field>
    <execution_lines_deleted_field>ExecutionLinesDeleted</execution_lines_deleted_field>
    <execution_files_retrieved_field>ExecutionFilesRetrieved</execution_files_retrieved_field>
    <execution_exit_status_field>ExecutionExitStatus</execution_exit_status_field>
    <execution_log_text_field />
    <execution_log_channelid_field>ExecutionLogChannelId</execution_log_channelid_field>
    <result_files_file_name_field>FileName</result_files_file_name_field>
    <filename>${PROJECT_HOME}/attachments/download_file.hpl</filename>
    <distribute>Y</distribute>
    <copies>1</copies>
    <attributes />
    <executors_output_transform>Original request rows</executors_output_transform>
    <GUI>
      <xloc>1040</xloc>
      <yloc>80</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
  </transform>
  <transform>
    <type>Sequence</type>
    <name>Number child results</name>
    <valuename>result_no</valuename>
    <use_database>N</use_database>
    <use_counter>Y</use_counter>
    <counter_name />
    <start_at>1</start_at>
    <increment_by>1</increment_by>
    <max_value>9223372036854775807</max_value>
    <copies>1</copies>
    <distribute>Y</distribute>
    <GUI>
      <xloc>80</xloc>
      <yloc>240</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
  </transform>
  <transform>
    <type>Dummy</type>
    <name>Original request rows</name>
    <copies>1</copies>
    <distribute>Y</distribute>
    <GUI>
      <xloc>320</xloc>
      <yloc>240</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
  </transform>
  <transform>
    <type>MergeJoin</type>
    <name>Pair child with request</name>
    <join_type>INNER</join_type>
    <transform1>Original request rows</transform1>
    <transform2>Number child results</transform2>
    <keys_1>
      <key>request_no</key>
    </keys_1>
    <keys_2>
      <key>result_no</key>
    </keys_2>
    <copies>1</copies>
    <distribute>Y</distribute>
    <GUI>
      <xloc>560</xloc>
      <yloc>240</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
  </transform>
  <transform>
    <type>ExecSql</type>
    <name>Record child outcome</name>
    <connection>jobtology-postgres</connection>
    <sql>SELECT attachment.finish_download(?,?,?::bigint)</sql>
    <execute_each_row>Y</execute_each_row>
    <single_statement>Y</single_statement>
    <set_params>Y</set_params>
    <replace_variables>N</replace_variables>
    <quoteString>N</quoteString>
    <arguments>
      <argument>
        <name>attempt_id</name>
      </argument>
      <argument>
        <name>ExecutionResult</name>
      </argument>
      <argument>
        <name>ExecutionNrErrors</name>
      </argument>
    </arguments>
    <copies>1</copies>
    <distribute>Y</distribute>
    <GUI>
      <xloc>800</xloc>
      <yloc>240</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
  </transform>
  <transform>
    <type>Dummy</type>
    <name>Plan only</name>
    <copies>1</copies>
    <distribute>Y</distribute>
    <GUI>
      <xloc>1040</xloc>
      <yloc>240</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
  </transform>
  <transform_error_handling />
  <attributes />
</pipeline>