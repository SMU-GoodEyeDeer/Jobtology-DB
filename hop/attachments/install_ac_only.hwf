<?xml version='1.0' encoding='UTF-8'?>
<workflow>
  <name>Install A/C-only document selector</name>
  <description>Install document-processor input integration</description>
  <workflow_version>1</workflow_version>
  <workflow_status>0</workflow_status>
  <parameters />
  <actions>
    <action>
      <name>Start</name>
      <type>SPECIAL</type>
      <xloc>80</xloc>
      <yloc>80</yloc>
      <draw>Y</draw>
      <parallel>N</parallel>
      <attributes />
      <start>Y</start>
      <repeat>N</repeat>
      <schedulerType>0</schedulerType>
      <intervalSeconds>0</intervalSeconds>
      <intervalMinutes>60</intervalMinutes>
      <DayOfMonth>1</DayOfMonth>
      <weekDay>1</weekDay>
      <minutes>0</minutes>
      <hour>12</hour>
    </action>
    <action>
      <name>Success</name>
      <type>SUCCESS</type>
      <xloc>320</xloc>
      <yloc>80</yloc>
      <draw>Y</draw>
      <parallel>N</parallel>
      <attributes />
    </action>
    <action>
      <name>Abort</name>
      <type>ABORT</type>
      <xloc>800</xloc>
      <yloc>80</yloc>
      <draw>Y</draw>
      <parallel>N</parallel>
      <attributes />
      <message>LLM workflow failed. Inspect enrichment.batch_report and enrichment.attempt.</message>
    </action>
    <action>
      <name>Install A/C-only selector</name>
      <type>SQL</type>
      <connection>jobtology-postgres</connection>
      <sqlfromfile>Y</sqlfromfile>
      <sqlfilename>${PROJECT_HOME}/attachments/sql/010_ac_only_selector.sql</sqlfilename>
      <sqlfilename_encoding>UTF-8</sqlfilename_encoding>
      <useVariableSubstitution>N</useVariableSubstitution>
      <sendOneStatement>Y</sendOneStatement>
      <xloc>320</xloc>
      <yloc>80</yloc>
      <draw>Y</draw>
      <parallel>N</parallel>
    </action>
  </actions>
  <hops>
    <hop>
      <from>Start</from>
      <to>Install A/C-only selector</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>Y</unconditional>
    </hop>
    <hop>
      <from>Install A/C-only selector</from>
      <to>Success</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Install A/C-only selector</from>
      <to>Abort</to>
      <enabled>Y</enabled>
      <evaluation>N</evaluation>
      <unconditional>N</unconditional>
    </hop>
  </hops>
  <notepads />
  <attributes />
</workflow>