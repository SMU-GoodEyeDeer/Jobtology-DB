<?xml version='1.0' encoding='UTF-8'?>
<pipeline>
  <info>
    <name>finish_hwpx</name>
    <description>Verify complete structure accounting and report outcomes.</description>
    <pipeline_type>Normal</pipeline_type>
    <size_rowset>100</size_rowset>
    <parameters />
  </info>
  <notepads />
  <order>
    <hop>
      <from>HWPX completion</from>
      <to>Verify HWPX terminal states</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Verify HWPX terminal states</from>
      <to>HWPX outcomes</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>HWPX outcomes</from>
      <to>HWPX structures</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <type>GetVariable</type>
    <name>HWPX completion</name>
    <fields>
      <field>
        <name>batch_id</name>
        <variable>${HWPX_BATCH_ID}</variable>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
      </field>
    </fields>
    <copies>1</copies>
    <distribute>Y</distribute>
    <GUI>
      <xloc>80</xloc>
      <yloc>80</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
  </transform>
  <transform>
    <type>ExecSql</type>
    <name>Verify HWPX terminal states</name>
    <connection>jobtology-postgres</connection>
    <sql>SELECT attachment.verify_hwpx_batch(?)</sql>
    <execute_each_row>Y</execute_each_row>
    <single_statement>Y</single_statement>
    <set_params>Y</set_params>
    <replace_variables>N</replace_variables>
    <quoteString>N</quoteString>
    <arguments>
      <argument>
        <name>batch_id</name>
      </argument>
    </arguments>
    <copies>1</copies>
    <distribute>Y</distribute>
    <GUI>
      <xloc>320</xloc>
      <yloc>80</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
  </transform>
  <transform>
    <type>DBJoin</type>
    <name>HWPX outcomes</name>
    <connection>jobtology-postgres</connection>
    <sql>SELECT state,count(*) AS documents FROM attachment.hwpx_structure WHERE batch_id=? GROUP BY state ORDER BY state</sql>
    <cache>N</cache>
    <cache_size>0</cache_size>
    <rowlimit>0</rowlimit>
    <outer_join>N</outer_join>
    <replace_vars>N</replace_vars>
    <parameter>
      <field>
        <name>batch_id</name>
        <type>String</type>
      </field>
    </parameter>
    <copies>1</copies>
    <distribute>Y</distribute>
    <GUI>
      <xloc>560</xloc>
      <yloc>80</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
  </transform>
  <transform>
    <type>WriteToLog</type>
    <name>HWPX structures</name>
    <loglevel>Basic</loglevel>
    <displayHeader>Y</displayHeader>
    <logmessage>Verified structure retains original text order and table relationships; semantic review remains separate.</logmessage>
    <fields>
      <field>
        <name>state</name>
      </field>
      <field>
        <name>documents</name>
      </field>
    </fields>
    <copies>1</copies>
    <distribute>Y</distribute>
    <GUI>
      <xloc>800</xloc>
      <yloc>80</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
  </transform>
  <transform_error_handling />
  <attributes />
</pipeline>