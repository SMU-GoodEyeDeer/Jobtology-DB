<?xml version='1.0' encoding='UTF-8'?>
<workflow>
  <name>Prepare structured document LLM inputs</name>
  <description>Prepare structured document LLM inputs</description>
  <workflow_version>1</workflow_version>
  <workflow_status>0</workflow_status>
  <parameters>
    <parameter>
      <name>JOB_RUN_ID</name>
      <default_value />
      <description>Exact READY JOB snapshot.</description>
    </parameter>
    <parameter>
      <name>ATTACHMENT_BATCH_IDS</name>
      <default_value />
      <description>Completed batches separated by |, later entries take precedence per file.</description>
    </parameter>
    <parameter>
      <name>HWPX_BATCH_IDS</name>
      <default_value />
      <description>Completed HWPX structure batches separated by |, with identical attachment parent selection.</description>
    </parameter>
    <parameter>
      <name>POSTING_IDS</name>
      <default_value />
      <description>Numeric IDs separated by |; blank selects the complete job snapshot.</description>
    </parameter>
    <parameter>
      <name>POSTING_LIMIT</name>
      <default_value>20</default_value>
      <description>Fail if selection exceeds this cap; no silent LIMIT.</description>
    </parameter>
    <parameter>
      <name>DATASET_ID</name>
      <default_value />
      <description>Optional new frozen EVAL dataset ID. Blank prepares ENRICH inputs only.</description>
    </parameter>
    <parameter>
      <name>NCS_RUN_ID</name>
      <default_value>LATEST</default_value>
      <description>NCS snapshot for an optional EVAL dataset.</description>
    </parameter>
  </parameters>
  <actions>
    <action>
      <name>Start</name>
      <type>SPECIAL</type>
      <xloc>80</xloc>
      <yloc>80</yloc>
      <draw>Y</draw>
      <parallel>N</parallel>
      <attributes />
      <start>Y</start>
      <repeat>N</repeat>
      <schedulerType>0</schedulerType>
      <intervalSeconds>0</intervalSeconds>
      <intervalMinutes>60</intervalMinutes>
      <DayOfMonth>1</DayOfMonth>
      <weekDay>1</weekDay>
      <minutes>0</minutes>
      <hour>12</hour>
    </action>
    <action>
      <name>Freeze structured input bundles</name>
      <type>PIPELINE</type>
      <xloc>320</xloc>
      <yloc>80</yloc>
      <draw>Y</draw>
      <parallel>N</parallel>
      <attributes />
      <filename>${PROJECT_HOME}/attachments/prepare_structured_inputs.hpl</filename>
      <params_from_previous>N</params_from_previous>
      <exec_per_row>N</exec_per_row>
      <clear_rows>N</clear_rows>
      <clear_files>N</clear_files>
      <set_logfile>N</set_logfile>
      <loglevel>Basic</loglevel>
      <wait_until_finished>Y</wait_until_finished>
      <run_configuration>attachment-local</run_configuration>
      <parameters>
        <pass_all_parameters>Y</pass_all_parameters>
      </parameters>
    </action>
    <action>
      <name>Success</name>
      <type>SUCCESS</type>
      <xloc>560</xloc>
      <yloc>80</yloc>
      <draw>Y</draw>
      <parallel>N</parallel>
      <attributes />
    </action>
    <action>
      <name>Abort</name>
      <type>ABORT</type>
      <xloc>1040</xloc>
      <yloc>80</yloc>
      <draw>Y</draw>
      <parallel>N</parallel>
      <attributes />
      <message>Attachment workflow failed. Inspect attachment.report and attachment.attempt.</message>
    </action>
  </actions>
  <hops>
    <hop>
      <from>Start</from>
      <to>Freeze structured input bundles</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>Y</unconditional>
    </hop>
    <hop>
      <from>Freeze structured input bundles</from>
      <to>Abort</to>
      <enabled>Y</enabled>
      <evaluation>N</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Freeze structured input bundles</from>
      <to>Success</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
  </hops>
  <notepads />
  <attributes />
</workflow>