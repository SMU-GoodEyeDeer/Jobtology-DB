<?xml version='1.0' encoding='UTF-8'?>
<pipeline>
  <info>
    <name>finish_processor</name>
    <description>Verify terminal parser outcomes and report failures explicitly.</description>
    <pipeline_type>Normal</pipeline_type>
    <size_rowset>100</size_rowset>
    <parameters />
  </info>
  <notepads />
  <order>
    <hop>
      <from>Batch</from>
      <to>Verify terminal state</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Verify terminal state</from>
      <to>Parser outcomes</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Parser outcomes</from>
      <to>Parser summary</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <type>GetVariable</type>
    <name>Batch</name>
    <fields>
      <field>
        <name>batch_id</name>
        <variable>${PROCESSOR_BATCH_ID}</variable>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
      </field>
      <field>
        <name>execute_parsing</name>
        <variable>${EXECUTE_PARSING}</variable>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
      </field>
    </fields>
    <copies>1</copies>
    <distribute>Y</distribute>
    <GUI>
      <xloc>80</xloc>
      <yloc>80</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
  </transform>
  <transform>
    <type>ExecSql</type>
    <name>Verify terminal state</name>
    <connection>jobtology-postgres</connection>
    <sql>SELECT CASE WHEN ?='Y' THEN attachment.verify_processor(?) END</sql>
    <execute_each_row>Y</execute_each_row>
    <single_statement>Y</single_statement>
    <set_params>Y</set_params>
    <replace_variables>N</replace_variables>
    <quoteString>N</quoteString>
    <arguments>
      <argument>
        <name>execute_parsing</name>
      </argument>
      <argument>
        <name>batch_id</name>
      </argument>
    </arguments>
    <copies>1</copies>
    <distribute>Y</distribute>
    <GUI>
      <xloc>320</xloc>
      <yloc>80</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
  </transform>
  <transform>
    <type>DBJoin</type>
    <name>Parser outcomes</name>
    <connection>jobtology-postgres</connection>
    <sql>SELECT state,issue,count(*) AS documents FROM attachment.processor_document WHERE batch_id=? GROUP BY state,issue ORDER BY state,issue</sql>
    <cache>N</cache>
    <cache_size>0</cache_size>
    <rowlimit>0</rowlimit>
    <outer_join>N</outer_join>
    <replace_vars>N</replace_vars>
    <parameter>
      <field>
        <name>batch_id</name>
        <type>String</type>
      </field>
    </parameter>
    <copies>1</copies>
    <distribute>Y</distribute>
    <GUI>
      <xloc>560</xloc>
      <yloc>80</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
  </transform>
  <transform>
    <type>WriteToLog</type>
    <name>Parser summary</name>
    <loglevel>Basic</loglevel>
    <displayHeader>Y</displayHeader>
    <logmessage>Original files and earlier parser outputs remain available.</logmessage>
    <fields>
      <field>
        <name>state</name>
      </field>
      <field>
        <name>issue</name>
      </field>
      <field>
        <name>documents</name>
      </field>
    </fields>
    <copies>1</copies>
    <distribute>Y</distribute>
    <GUI>
      <xloc>800</xloc>
      <yloc>80</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
  </transform>
  <transform_error_handling />
  <attributes />
</pipeline>