<?xml version='1.0' encoding='UTF-8'?>
<pipeline>
  <info>
    <name>pin_catalogue</name>
    <description>Freeze the current reviewed editorial revision in an unsealed ontology draft.</description>
    <pipeline_type>Normal</pipeline_type>
    <size_rowset>100</size_rowset>
    <parameters />
  </info>
  <notepads />
  <order>
    <hop>
      <from>Release and catalogue</from>
      <to>Pin reviewed source</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Pin reviewed source</from>
      <to>Source pinned</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <type>GetVariable</type>
    <name>Release and catalogue</name>
    <fields>
      <field>
        <name>release_id</name>
        <variable>${RELEASE_ID}</variable>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
      </field>
      <field>
        <name>snapshot_id</name>
        <variable>${SNAPSHOT_ID}</variable>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
      </field>
    </fields>
    <copies>1</copies>
    <distribute>Y</distribute>
    <GUI>
      <xloc>80</xloc>
      <yloc>80</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
  </transform>
  <transform>
    <type>ExecSql</type>
    <name>Pin reviewed source</name>
    <connection>jobtology-postgres</connection>
    <sql>SELECT editorial.pin_v1(?,?)</sql>
    <execute_each_row>Y</execute_each_row>
    <single_statement>Y</single_statement>
    <set_params>Y</set_params>
    <replace_variables>N</replace_variables>
    <quoteString>N</quoteString>
    <arguments>
      <argument>
        <name>release_id</name>
      </argument>
      <argument>
        <name>snapshot_id</name>
      </argument>
    </arguments>
    <copies>1</copies>
    <distribute>Y</distribute>
    <GUI>
      <xloc>320</xloc>
      <yloc>80</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
  </transform>
  <transform>
    <type>WriteToLog</type>
    <name>Source pinned</name>
    <loglevel>Basic</loglevel>
    <displayHeader>Y</displayHeader>
    <logmessage>Editorial membership frozen. Assemble remaining reviewed claims before loading this draft graph.</logmessage>
    <fields>
      <field>
        <name>release_id</name>
      </field>
      <field>
        <name>snapshot_id</name>
      </field>
    </fields>
    <copies>1</copies>
    <distribute>Y</distribute>
    <GUI>
      <xloc>560</xloc>
      <yloc>80</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
  </transform>
  <transform_error_handling />
  <attributes />
</pipeline>