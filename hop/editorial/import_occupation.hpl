<?xml version='1.0' encoding='UTF-8'?>
<pipeline>
  <info>
    <name>import_occupation</name>
    <description>Import one evidence-bound product occupation proposal; no automatic review.</description>
    <pipeline_type>Normal</pipeline_type>
    <size_rowset>100</size_rowset>
    <parameters />
  </info>
  <notepads />
  <order>
    <hop>
      <from>Proposal file</from>
      <to>Read proposal bytes</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Read proposal bytes</from>
      <to>Validate and capture proposal</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Validate and capture proposal</from>
      <to>Proposal imported</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <type>GetVariable</type>
    <name>Proposal file</name>
    <fields>
      <field>
        <name>proposal_file</name>
        <variable>${PROPOSAL_FILE}</variable>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
      </field>
    </fields>
    <copies>1</copies>
    <distribute>Y</distribute>
    <GUI>
      <xloc>80</xloc>
      <yloc>80</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
  </transform>
  <transform>
    <type>LoadFileInput</type>
    <name>Read proposal bytes</name>
    <IsInFields>Y</IsInFields>
    <DynamicFilenameField>proposal_file</DynamicFilenameField>
    <IsIgnoreEmptyFile>N</IsIgnoreEmptyFile>
    <IsIgnoreMissingPath>N</IsIgnoreMissingPath>
    <encoding>UTF-8</encoding>
    <addresultfile>N</addresultfile>
    <limit>0</limit>
    <fields>
      <field>
        <name>proposal_bytes</name>
        <element_type>content</element_type>
        <type>Binary</type>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
        <repeat>N</repeat>
      </field>
    </fields>
    <copies>1</copies>
    <distribute>Y</distribute>
    <GUI>
      <xloc>320</xloc>
      <yloc>80</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
  </transform>
  <transform>
    <type>DBJoin</type>
    <name>Validate and capture proposal</name>
    <connection>jobtology-postgres</connection>
    <sql>SELECT ontology.import_occupation_v1(?::bytea) AS proposal_id</sql>
    <cache>N</cache>
    <cache_size>0</cache_size>
    <rowlimit>0</rowlimit>
    <outer_join>N</outer_join>
    <replace_vars>N</replace_vars>
    <parameter>
      <field>
        <name>proposal_bytes</name>
        <type>Binary</type>
      </field>
    </parameter>
    <copies>1</copies>
    <distribute>Y</distribute>
    <GUI>
      <xloc>560</xloc>
      <yloc>80</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
  </transform>
  <transform>
    <type>WriteToLog</type>
    <name>Proposal imported</name>
    <loglevel>Basic</loglevel>
    <displayHeader>Y</displayHeader>
    <logmessage>Independent review and release freeze are separate steps.</logmessage>
    <fields>
      <field>
        <name>proposal_id</name>
      </field>
    </fields>
    <copies>1</copies>
    <distribute>Y</distribute>
    <GUI>
      <xloc>800</xloc>
      <yloc>80</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
  </transform>
  <transform_error_handling />
  <attributes />
</pipeline>