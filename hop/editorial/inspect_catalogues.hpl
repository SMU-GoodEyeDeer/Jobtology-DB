<?xml version='1.0' encoding='UTF-8'?>
<pipeline>
  <info>
    <name>inspect_catalogues</name>
    <description>Inspect imported catalogues, review outcomes and stable occupation IDs.</description>
    <pipeline_type>Normal</pipeline_type>
    <size_rowset>100</size_rowset>
    <parameters />
  </info>
  <notepads />
  <order>
    <hop>
      <from>Read editorial status</from>
      <to>Preview catalogue status</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <type>TableInput</type>
    <name>Read editorial status</name>
    <connection>jobtology-postgres</connection>
    <sql>SELECT * FROM editorial.catalogue_status ORDER BY catalogue_version DESC</sql>
    <limit>0</limit>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <copies>1</copies>
    <distribute>Y</distribute>
    <GUI>
      <xloc>80</xloc>
      <yloc>80</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
  </transform>
  <transform>
    <type>Dummy</type>
    <name>Preview catalogue status</name>
    <copies>1</copies>
    <distribute>Y</distribute>
    <GUI>
      <xloc>320</xloc>
      <yloc>80</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
  </transform>
  <transform_error_handling />
  <attributes />
</pipeline>