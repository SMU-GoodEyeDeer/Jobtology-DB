<?xml version='1.0' encoding='UTF-8'?>
<workflow>
  <name>Refresh alio_organization and graph</name>
  <description>Create and accept a new source snapshot, load it to Neo4j, and record the completed graph checkpoint.</description>
  <extended_description>Run MODE=SMOKE first, then MODE=FULL. Use Basic logging. Every execution creates a new run; failures preserve partial data.</extended_description>
  <workflow_version>1</workflow_version>
  <workflow_status>0</workflow_status>
  <parameters>
    <parameter>
      <name>RAW_ROOT</name>
      <default_value>${PROJECT_HOME}/data/alio-raw</default_value>
      <description>Persistent response archive directory.</description>
    </parameter>
    <parameter>
      <name>API_KEY_FILE</name>
      <default_value>${HOP_CONFIG_FOLDER}/secrets/data-go-kr.csv</default_value>
      <description>Runtime-only CSV with service_key header and exactly one decoded key.</description>
    </parameter>
    <parameter>
      <name>MAX_PAGES</name>
      <default_value>100</default_value>
      <description>Reject a snapshot exceeding this request cap; never silently truncate.</description>
    </parameter>
    <parameter>
      <name>MODE</name>
      <default_value>FULL</default_value>
      <description>Use FULL only; use the source full.hwf for SMOKE.</description>
    </parameter>
  </parameters>
  <actions>
    <action>
      <attributes />
      <repeat>N</repeat>
      <schedulerType>0</schedulerType>
      <intervalSeconds>0</intervalSeconds>
      <intervalMinutes>60</intervalMinutes>
      <DayOfMonth>1</DayOfMonth>
      <weekDay>1</weekDay>
      <minutes>0</minutes>
      <hour>12</hour>
      <doNotWaitOnFirstExecution>N</doNotWaitOnFirstExecution>
      <description />
      <attributes />
      <name>Start</name>
      <type>SPECIAL</type>
      <xloc>100</xloc>
      <yloc>100</yloc>
      <draw>Y</draw>
      <parallel>N</parallel>
      <start>Y</start>
    </action>
    <action>
      <attributes />
      <params_from_previous>N</params_from_previous>
      <exec_per_row>N</exec_per_row>
      <clear_rows>N</clear_rows>
      <clear_files>N</clear_files>
      <create_parent_folder>N</create_parent_folder>
      <set_logfile>N</set_logfile>
      <set_append_logfile>N</set_append_logfile>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <loglevel>Basic</loglevel>
      <wait_until_finished>Y</wait_until_finished>
      <parameters>
        <pass_all_parameters>Y</pass_all_parameters>
      </parameters>
      <attributes />
      <name>Create run</name>
      <type>PIPELINE</type>
      <xloc>100</xloc>
      <yloc>250</yloc>
      <draw>Y</draw>
      <parallel>N</parallel>
      <filename>${PROJECT_HOME}/ingestions/alio/start_run.hpl</filename>
      <run_configuration>alio-local</run_configuration>
    </action>
    <action>
      <attributes />
      <params_from_previous>N</params_from_previous>
      <exec_per_row>N</exec_per_row>
      <clear_rows>N</clear_rows>
      <clear_files>N</clear_files>
      <create_parent_folder>N</create_parent_folder>
      <set_logfile>N</set_logfile>
      <set_append_logfile>N</set_append_logfile>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <loglevel>Basic</loglevel>
      <wait_until_finished>Y</wait_until_finished>
      <parameters>
        <pass_all_parameters>Y</pass_all_parameters>
      </parameters>
      <attributes />
      <name>Fetch first page</name>
      <type>PIPELINE</type>
      <xloc>340</xloc>
      <yloc>250</yloc>
      <draw>Y</draw>
      <parallel>N</parallel>
      <filename>${PROJECT_HOME}/ingestions/alio/fetch_page.hpl</filename>
      <run_configuration>alio-local</run_configuration>
    </action>
    <action>
      <attributes />
      <params_from_previous>N</params_from_previous>
      <exec_per_row>N</exec_per_row>
      <clear_rows>N</clear_rows>
      <clear_files>N</clear_files>
      <create_parent_folder>N</create_parent_folder>
      <set_logfile>N</set_logfile>
      <set_append_logfile>N</set_append_logfile>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <loglevel>Basic</loglevel>
      <wait_until_finished>Y</wait_until_finished>
      <parameters>
        <pass_all_parameters>Y</pass_all_parameters>
      </parameters>
      <attributes />
      <name>Fetch remaining pages</name>
      <type>PIPELINE</type>
      <xloc>580</xloc>
      <yloc>250</yloc>
      <draw>Y</draw>
      <parallel>N</parallel>
      <filename>${PROJECT_HOME}/ingestions/alio/remaining_pages.hpl</filename>
      <run_configuration>alio-local</run_configuration>
    </action>
    <action>
      <attributes />
      <params_from_previous>N</params_from_previous>
      <exec_per_row>N</exec_per_row>
      <clear_rows>N</clear_rows>
      <clear_files>N</clear_files>
      <create_parent_folder>N</create_parent_folder>
      <set_logfile>N</set_logfile>
      <set_append_logfile>N</set_append_logfile>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <loglevel>Basic</loglevel>
      <wait_until_finished>Y</wait_until_finished>
      <parameters>
        <pass_all_parameters>Y</pass_all_parameters>
      </parameters>
      <attributes />
      <name>Verify archived files</name>
      <type>PIPELINE</type>
      <xloc>820</xloc>
      <yloc>250</yloc>
      <draw>Y</draw>
      <parallel>N</parallel>
      <filename>${PROJECT_HOME}/ingestions/alio/verify_files.hpl</filename>
      <run_configuration>alio-local</run_configuration>
    </action>
    <action>
      <attributes />
      <params_from_previous>N</params_from_previous>
      <exec_per_row>N</exec_per_row>
      <clear_rows>N</clear_rows>
      <clear_files>N</clear_files>
      <create_parent_folder>N</create_parent_folder>
      <set_logfile>N</set_logfile>
      <set_append_logfile>N</set_append_logfile>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <loglevel>Basic</loglevel>
      <wait_until_finished>Y</wait_until_finished>
      <parameters>
        <pass_all_parameters>Y</pass_all_parameters>
      </parameters>
      <attributes />
      <name>Validate and finish</name>
      <type>PIPELINE</type>
      <xloc>1060</xloc>
      <yloc>250</yloc>
      <draw>Y</draw>
      <parallel>N</parallel>
      <filename>${PROJECT_HOME}/ingestions/alio/finalize.hpl</filename>
      <run_configuration>alio-local</run_configuration>
    </action>
    <action>
      <attributes />
      <name>Success</name>
      <description />
      <attributes />
      <type>SUCCESS</type>
      <xloc>1060</xloc>
      <yloc>100</yloc>
      <draw>Y</draw>
      <parallel>N</parallel>
    </action>
    <action>
      <attributes />
      <params_from_previous>N</params_from_previous>
      <exec_per_row>N</exec_per_row>
      <clear_rows>N</clear_rows>
      <clear_files>N</clear_files>
      <create_parent_folder>N</create_parent_folder>
      <set_logfile>N</set_logfile>
      <set_append_logfile>N</set_append_logfile>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <loglevel>Basic</loglevel>
      <wait_until_finished>Y</wait_until_finished>
      <parameters>
        <pass_all_parameters>Y</pass_all_parameters>
      </parameters>
      <attributes />
      <name>Record failure</name>
      <type>PIPELINE</type>
      <xloc>580</xloc>
      <yloc>470</yloc>
      <draw>Y</draw>
      <parallel>N</parallel>
      <filename>${PROJECT_HOME}/ingestions/alio/mark_failed.hpl</filename>
      <run_configuration>alio-local</run_configuration>
    </action>
    <action>
      <attributes />
      <loglevel>Error</loglevel>
      <name>Abort</name>
      <description />
      <attributes />
      <type>ABORT</type>
      <xloc>820</xloc>
      <yloc>470</yloc>
      <draw>Y</draw>
      <parallel>N</parallel>
      <message>ALIO failed; inspect the run and archived responses before starting a fresh run.</message>
    </action>
    <action>
      <attributes />
      <params_from_previous>N</params_from_previous>
      <exec_per_row>N</exec_per_row>
      <clear_rows>N</clear_rows>
      <clear_files>N</clear_files>
      <create_parent_folder>N</create_parent_folder>
      <set_logfile>N</set_logfile>
      <set_append_logfile>N</set_append_logfile>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <loglevel>Basic</loglevel>
      <wait_until_finished>Y</wait_until_finished>
      <parameters>
        <pass_all_parameters>Y</pass_all_parameters>
        <parameter>
          <name>RUN_ID</name>
          <value>${ALIO_RUN_ID}</value>
          <stream_name />
        </parameter>
      </parameters>
      <attributes />
      <name>Load accepted snapshot to graph</name>
      <type>WORKFLOW</type>
      <filename>${PROJECT_HOME}/graph/load_snapshot.hwf</filename>
      <run_configuration>graph-local</run_configuration>
      <draw>Y</draw>
      <xloc>1100</xloc>
      <yloc>800</yloc>
      <parallel>N</parallel>
    </action>
    <action>
      <attributes />
      <params_from_previous>N</params_from_previous>
      <exec_per_row>N</exec_per_row>
      <clear_rows>N</clear_rows>
      <clear_files>N</clear_files>
      <create_parent_folder>N</create_parent_folder>
      <set_logfile>N</set_logfile>
      <set_append_logfile>N</set_append_logfile>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <loglevel>Basic</loglevel>
      <wait_until_finished>Y</wait_until_finished>
      <parameters>
        <pass_all_parameters>Y</pass_all_parameters>
        <parameter>
          <name>RUN_ID</name>
          <value>${ALIO_RUN_ID}</value>
          <stream_name />
        </parameter>
      </parameters>
      <attributes />
      <name>Save graph checkpoint</name>
      <type>PIPELINE</type>
      <filename>${PROJECT_HOME}/operations/record_graph_export.hpl</filename>
      <run_configuration>graph-local</run_configuration>
      <draw>Y</draw>
      <xloc>1400</xloc>
      <yloc>800</yloc>
      <parallel>N</parallel>
    </action>
  </actions>
  <hops>
    <hop>
      <from>Start</from>
      <to>Create run</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>Y</unconditional>
    </hop>
    <hop>
      <from>Create run</from>
      <to>Record failure</to>
      <enabled>Y</enabled>
      <evaluation>N</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Create run</from>
      <to>Fetch first page</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Fetch first page</from>
      <to>Record failure</to>
      <enabled>Y</enabled>
      <evaluation>N</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Fetch first page</from>
      <to>Fetch remaining pages</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Fetch remaining pages</from>
      <to>Record failure</to>
      <enabled>Y</enabled>
      <evaluation>N</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Fetch remaining pages</from>
      <to>Verify archived files</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Verify archived files</from>
      <to>Record failure</to>
      <enabled>Y</enabled>
      <evaluation>N</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Verify archived files</from>
      <to>Validate and finish</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Validate and finish</from>
      <to>Record failure</to>
      <enabled>Y</enabled>
      <evaluation>N</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Validate and finish</from>
      <to>Load accepted snapshot to graph</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Record failure</from>
      <to>Abort</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Record failure</from>
      <to>Abort</to>
      <enabled>Y</enabled>
      <evaluation>N</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Load accepted snapshot to graph</from>
      <to>Save graph checkpoint</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Load accepted snapshot to graph</from>
      <to>Abort</to>
      <enabled>Y</enabled>
      <evaluation>N</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Save graph checkpoint</from>
      <to>Success</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Save graph checkpoint</from>
      <to>Abort</to>
      <enabled>Y</enabled>
      <evaluation>N</evaluation>
      <unconditional>N</unconditional>
    </hop>
  </hops>
  <notepads />
  <attributes />
</workflow>