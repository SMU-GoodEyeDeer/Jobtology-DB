<?xml version='1.0' encoding='UTF-8'?>
<workflow>
  <name>Refresh job_alio and graph</name>
  <name_sync_with_filename>N</name_sync_with_filename>
  <description>Create and accept a new source snapshot, load it to Neo4j, and record the completed graph checkpoint.</description>
  <extended_description>Use job-alio-local and Basic logging. FULL fetches every posting; SMOKE fetches page one and its details, and remains REVIEW_REQUIRED. Every invocation creates a new snapshot.</extended_description>
  <created_user>-</created_user>
  <modified_user>-</modified_user>
  <created_date>2026/09/11 06:30:11.460</created_date>
  <modified_date>2026/09/11 06:30:11.460</modified_date>
  <workflow_version>1</workflow_version>
  <parameters>
    <parameter>
      <name>MAX_PAGES</name>
      <description>Maximum list requests, including a second empty confirmation.</description>
      <default_value>100</default_value>
    </parameter>
    <parameter>
      <name>UPSTREAM_RUN_ID</name>
      <description>LATEST resolves one READY ALIO snapshot at startup, or supply its exact run ID.</description>
      <default_value>LATEST</default_value>
    </parameter>
    <parameter>
      <name>RAW_ROOT</name>
      <description>Persistent raw response directory.</description>
      <default_value>${PROJECT_HOME}/data/job-alio-raw</default_value>
    </parameter>
    <parameter>
      <name>MAX_REQUESTS</name>
      <description>Total list plus detail request cap for this invocation; remaining daily provider quota may be lower.</description>
      <default_value>1000</default_value>
    </parameter>
    <parameter>
      <name>API_KEY_FILE</name>
      <description>Runtime CSV with service_key header and exactly one decoded key.</description>
      <default_value>${HOP_CONFIG_FOLDER}/secrets/data-go-kr.csv</default_value>
    </parameter>
    <parameter>
      <name>MODE</name>
      <default_value>FULL</default_value>
      <description>Use FULL only; use the source full.hwf for SMOKE.</description>
    </parameter>
  </parameters>
