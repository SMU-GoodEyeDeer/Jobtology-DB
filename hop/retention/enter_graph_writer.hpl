<?xml version='1.0' encoding='UTF-8'?>
<pipeline>
  <info>
    <name>enter_graph_writer</name>
    <description>Register an active graph writer before it reads or mutates any graph batch.</description>
    <pipeline_type>Normal</pipeline_type>
    <size_rowset>100</size_rowset>
    <parameters />
  </info>
  <notepads />
  <order>
    <hop>
      <from>Writer options</from>
      <to>Writer identity</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Writer identity</from>
      <to>Remember RETENTION_WRITER_ID</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Remember RETENTION_WRITER_ID</from>
      <to>Enter graph writer</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <type>GetVariable</type>
    <name>Writer options</name>
    <fields>
      <field>
        <name>target</name>
        <variable>${RUN_ID}</variable>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
      </field>
    </fields>
    <copies>1</copies>
    <distribute>Y</distribute>
    <GUI>
      <xloc>80</xloc>
      <yloc>80</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
  </transform>
  <transform>
    <type>DBJoin</type>
    <name>Writer identity</name>
    <connection>jobtology-postgres</connection>
    <sql>SELECT gen_random_uuid()::text AS writer_id</sql>
    <cache>N</cache>
    <cache_size>0</cache_size>
    <rowlimit>0</rowlimit>
    <outer_join>N</outer_join>
    <replace_vars>N</replace_vars>
    <parameter />
    <copies>1</copies>
    <distribute>Y</distribute>
    <GUI>
      <xloc>320</xloc>
      <yloc>80</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
  </transform>
  <transform>
    <type>SetVariable</type>
    <name>Remember RETENTION_WRITER_ID</name>
    <use_formatting>Y</use_formatting>
    <fields>
      <field>
        <field_name>writer_id</field_name>
        <variable_name>RETENTION_WRITER_ID</variable_name>
        <variable_type>PARENT_WORKFLOW</variable_type>
        <default_value />
      </field>
    </fields>
    <copies>1</copies>
    <distribute>Y</distribute>
    <GUI>
      <xloc>560</xloc>
      <yloc>80</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
  </transform>
  <transform>
    <type>ExecSql</type>
    <name>Enter graph writer</name>
    <connection>jobtology-postgres</connection>
    <sql>SELECT retention.enter_writer(?,'SOURCE_GRAPH',?)</sql>
    <execute_each_row>Y</execute_each_row>
    <single_statement>Y</single_statement>
    <set_params>Y</set_params>
    <replace_variables>N</replace_variables>
    <quoteString>N</quoteString>
    <arguments>
      <argument>
        <name>writer_id</name>
      </argument>
      <argument>
        <name>target</name>
      </argument>
    </arguments>
    <copies>1</copies>
    <distribute>Y</distribute>
    <GUI>
      <xloc>800</xloc>
      <yloc>80</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
  </transform>
  <transform_error_handling />
  <attributes />
</pipeline>