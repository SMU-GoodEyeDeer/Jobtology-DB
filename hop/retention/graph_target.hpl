<?xml version='1.0' encoding='UTF-8'?>
<pipeline>
  <info>
    <name>graph_target</name>
    <description>Verify a retained source batch in the configured graph and pin the physical database identity.</description>
    <pipeline_type>Normal</pipeline_type>
    <size_rowset>100</size_rowset>
    <parameters />
  </info>
  <notepads />
  <order>
    <hop>
      <from>Options</from>
      <to>Expected retained graph batch</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Expected retained graph batch</from>
      <to>Verify graph database</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Verify graph database</from>
      <to>Expected graph only</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Expected graph only</from>
      <to>Pin graph database</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Expected graph only</from>
      <to>Abort</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <type>GetVariable</type>
    <name>Options</name>
    <fields>
      <field>
        <name>plan_id</name>
        <variable>${PLAN_ID}</variable>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
      </field>
      <field>
        <name>retention_owner_id</name>
        <variable>${RETENTION_OWNER_ID}</variable>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
      </field>
    </fields>
    <copies>1</copies>
    <distribute>Y</distribute>
    <GUI>
      <xloc>80</xloc>
      <yloc>80</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
  </transform>
  <transform>
    <type>DBJoin</type>
    <name>Expected retained graph batch</name>
    <connection>jobtology-postgres</connection>
    <sql>SELECT graph_anchor_run_id,source_id FROM retention.plan WHERE plan_id=? AND owner_id=? AND state='ACTIVE'</sql>
    <cache>N</cache>
    <cache_size>0</cache_size>
    <rowlimit>0</rowlimit>
    <outer_join>N</outer_join>
    <replace_vars>N</replace_vars>
    <parameter>
      <field>
        <name>plan_id</name>
        <type>String</type>
      </field>
      <field>
        <name>retention_owner_id</name>
        <type>String</type>
      </field>
    </parameter>
    <copies>1</copies>
    <distribute>Y</distribute>
    <GUI>
      <xloc>320</xloc>
      <yloc>80</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
  </transform>
  <transform>
    <type>Neo4jCypherOutput</type>
    <name>Verify graph database</name>
    <connection>${NEO4J_CONNECTION}</connection>
    <cypher>OPTIONAL MATCH (b:ingestionBatch {id:$graph_anchor_run_id})
WITH count(CASE WHEN b.source_id=$source_id AND b.state='READY' AND b.serving_scope='STAGING' THEN 1 END)=1 AS anchor_valid
CALL db.info() YIELD id RETURN anchor_valid,id AS graph_database_id</cypher>
    <batch_size>1</batch_size>
    <read_only>Y</read_only>
    <retry>N</retry>
    <nr_retries_on_error>0</nr_retries_on_error>
    <cypher_from_field>N</cypher_from_field>
    <unwind>N</unwind>
    <returning_graph>N</returning_graph>
    <mappings>
      <mapping>
        <parameter>graph_anchor_run_id</parameter>
        <field>graph_anchor_run_id</field>
        <type>String</type>
      </mapping>
      <mapping>
        <parameter>source_id</parameter>
        <field>source_id</field>
        <type>String</type>
      </mapping>
    </mappings>
    <returns>
      <return>
        <name>anchor_valid</name>
        <type>Boolean</type>
        <source_type>Boolean</source_type>
      </return>
      <return>
        <name>graph_database_id</name>
        <type>String</type>
        <source_type>String</source_type>
      </return>
    </returns>
    <copies>1</copies>
    <distribute>Y</distribute>
    <GUI>
      <xloc>560</xloc>
      <yloc>80</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
  </transform>
  <transform>
    <type>FilterRows</type>
    <name>Expected graph only</name>
    <send_true_to>Pin graph database</send_true_to>
    <send_false_to>Abort</send_false_to>
    <compare>
      <condition>
        <negated>N</negated>
        <operator>-</operator>
        <leftvalue>anchor_valid</leftvalue>
        <function>=</function>
        <value>
          <name>constant</name>
          <type>Boolean</type>
          <text>Y</text>
          <length>-1</length>
          <precision>-1</precision>
          <isnull>N</isnull>
        </value>
      </condition>
    </compare>
    <copies>1</copies>
    <distribute>Y</distribute>
    <GUI>
      <xloc>800</xloc>
      <yloc>80</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
  </transform>
  <transform>
    <type>ExecSql</type>
    <name>Pin graph database</name>
    <connection>jobtology-postgres</connection>
    <sql>SELECT retention.bind_graph(?,?,?)</sql>
    <execute_each_row>Y</execute_each_row>
    <single_statement>Y</single_statement>
    <set_params>Y</set_params>
    <replace_variables>N</replace_variables>
    <quoteString>N</quoteString>
    <arguments>
      <argument>
        <name>plan_id</name>
      </argument>
      <argument>
        <name>retention_owner_id</name>
      </argument>
      <argument>
        <name>graph_database_id</name>
      </argument>
    </arguments>
    <copies>1</copies>
    <distribute>Y</distribute>
    <GUI>
      <xloc>1040</xloc>
      <yloc>80</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
  </transform>
  <transform>
    <type>Abort</type>
    <name>Abort</name>
    <message>The configured Neo4j database does not contain the retained source batch. No snapshots may be deleted.</message>
    <always_log_rows>N</always_log_rows>
    <abort_option>ABORT_WITH_ERROR</abort_option>
    <row_threshold>0</row_threshold>
    <copies>1</copies>
    <distribute>Y</distribute>
    <GUI>
      <xloc>80</xloc>
      <yloc>240</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
  </transform>
  <transform_error_handling />
  <attributes />
</pipeline>