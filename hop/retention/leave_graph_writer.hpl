<?xml version='1.0' encoding='UTF-8'?>
<pipeline>
  <info>
    <name>leave_graph_writer</name>
    <description>Release only this workflow writer lease on success or handled failure.</description>
    <pipeline_type>Normal</pipeline_type>
    <size_rowset>100</size_rowset>
    <parameters />
  </info>
  <notepads />
  <order>
    <hop>
      <from>Options</from>
      <to>Leave graph writer</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <type>GetVariable</type>
    <name>Options</name>
    <fields>
      <field>
        <name>retention_writer_id</name>
        <variable>${RETENTION_WRITER_ID}</variable>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
      </field>
    </fields>
    <copies>1</copies>
    <distribute>Y</distribute>
    <GUI>
      <xloc>80</xloc>
      <yloc>80</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
  </transform>
  <transform>
    <type>ExecSql</type>
    <name>Leave graph writer</name>
    <connection>jobtology-postgres</connection>
    <sql>SELECT retention.leave_writer(?)</sql>
    <execute_each_row>Y</execute_each_row>
    <single_statement>Y</single_statement>
    <set_params>Y</set_params>
    <replace_variables>N</replace_variables>
    <quoteString>N</quoteString>
    <arguments>
      <argument>
        <name>retention_writer_id</name>
      </argument>
    </arguments>
    <copies>1</copies>
    <distribute>Y</distribute>
    <GUI>
      <xloc>320</xloc>
      <yloc>80</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
  </transform>
  <transform_error_handling />
  <attributes />
</pipeline>