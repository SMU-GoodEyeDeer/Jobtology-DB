<?xml version='1.0' encoding='UTF-8'?>
<workflow>
  <name>Preview manual snapshot retention</name>
  <description>Preview manual snapshot retention</description>
  <workflow_version>1</workflow_version>
  <workflow_status>0</workflow_status>
  <parameters>
    <parameter>
      <name>SOURCE_ID</name>
      <default_value>job_alio</default_value>
      <description>One source ID, e.g. job_alio or qnet_schedule.</description>
    </parameter>
    <parameter>
      <name>SELECTION_MODE</name>
      <default_value>OLDEST_COUNT</default_value>
      <description>OLDEST_COUNT or OLDER_THAN_DAYS.</description>
    </parameter>
    <parameter>
      <name>AMOUNT</name>
      <default_value>1</default_value>
      <description>Number of eligible oldest snapshots, or age in whole 24-hour days.</description>
    </parameter>
    <parameter>
      <name>KEEP_LATEST</name>
      <default_value>2</default_value>
      <description>Keep at least this many newest accepted snapshots for this source; minimum 1.</description>
    </parameter>
    <parameter>
      <name>RAW_BASE</name>
      <default_value>${PROJECT_HOME}/data</default_value>
      <description>Must equal the preview root. Only standard source/run manifest files under this data folder are supported.</description>
    </parameter>
  </parameters>
  <actions>
    <action>
      <name>Start</name>
      <type>SPECIAL</type>
      <xloc>80</xloc>
      <yloc>80</yloc>
      <draw>Y</draw>
      <parallel>N</parallel>
      <attributes />
      <start>Y</start>
      <repeat>N</repeat>
      <schedulerType>0</schedulerType>
      <intervalSeconds>0</intervalSeconds>
      <intervalMinutes>60</intervalMinutes>
      <DayOfMonth>1</DayOfMonth>
      <weekDay>1</weekDay>
      <minutes>0</minutes>
      <hour>12</hour>
    </action>
    <action>
      <name>Create immutable preview</name>
      <type>PIPELINE</type>
      <xloc>320</xloc>
      <yloc>80</yloc>
      <draw>Y</draw>
      <parallel>N</parallel>
      <attributes />
      <filename>${PROJECT_HOME}/retention/preview.hpl</filename>
      <params_from_previous>N</params_from_previous>
      <exec_per_row>N</exec_per_row>
      <clear_rows>N</clear_rows>
      <clear_files>N</clear_files>
      <set_logfile>N</set_logfile>
      <loglevel>Basic</loglevel>
      <wait_until_finished>Y</wait_until_finished>
      <run_configuration>retention-local</run_configuration>
      <parameters>
        <pass_all_parameters>Y</pass_all_parameters>
      </parameters>
    </action>
    <action>
      <name>List selected and protected runs</name>
      <type>PIPELINE</type>
      <xloc>560</xloc>
      <yloc>80</yloc>
      <draw>Y</draw>
      <parallel>N</parallel>
      <attributes />
      <filename>${PROJECT_HOME}/retention/inspect_plan.hpl</filename>
      <params_from_previous>N</params_from_previous>
      <exec_per_row>N</exec_per_row>
      <clear_rows>N</clear_rows>
      <clear_files>N</clear_files>
      <set_logfile>N</set_logfile>
      <loglevel>Basic</loglevel>
      <wait_until_finished>Y</wait_until_finished>
      <run_configuration>retention-local</run_configuration>
      <parameters>
        <pass_all_parameters>Y</pass_all_parameters>
      </parameters>
    </action>
    <action>
      <name>Success</name>
      <type>SUCCESS</type>
      <xloc>800</xloc>
      <yloc>80</yloc>
      <draw>Y</draw>
      <parallel>N</parallel>
      <attributes />
    </action>
    <action>
      <name>Abort</name>
      <type>ABORT</type>
      <xloc>80</xloc>
      <yloc>240</yloc>
      <draw>Y</draw>
      <parallel>N</parallel>
      <attributes />
      <message>Retention stopped. Inspect the log and retention.plan_report; resume the same PLAN_ID after correction.</message>
    </action>
  </actions>
  <hops>
    <hop>
      <from>Start</from>
      <to>Create immutable preview</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>Y</unconditional>
    </hop>
    <hop>
      <from>Create immutable preview</from>
      <to>Abort</to>
      <enabled>Y</enabled>
      <evaluation>N</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Create immutable preview</from>
      <to>List selected and protected runs</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>List selected and protected runs</from>
      <to>Abort</to>
      <enabled>Y</enabled>
      <evaluation>N</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>List selected and protected runs</from>
      <to>Success</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
  </hops>
  <notepads />
  <attributes />
</workflow>