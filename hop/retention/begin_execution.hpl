<?xml version='1.0' encoding='UTF-8'?>
<pipeline>
  <info>
    <name>begin_execution</name>
    <description>Acquire the maintenance fence and revalidate the exact preview. Concurrent writers or stale plans stop here.</description>
    <pipeline_type>Normal</pipeline_type>
    <size_rowset>100</size_rowset>
    <parameters />
  </info>
  <notepads />
  <order>
    <hop>
      <from>Options</from>
      <to>New executor ID</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>New executor ID</from>
      <to>Remember RETENTION_OWNER_ID</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Remember RETENTION_OWNER_ID</from>
      <to>Recheck and acquire fence</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <type>GetVariable</type>
    <name>Options</name>
    <fields>
      <field>
        <name>plan_id</name>
        <variable>${PLAN_ID}</variable>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
      </field>
      <field>
        <name>raw_base</name>
        <variable>${RAW_BASE}</variable>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
      </field>
    </fields>
    <copies>1</copies>
    <distribute>Y</distribute>
    <GUI>
      <xloc>80</xloc>
      <yloc>80</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
  </transform>
  <transform>
    <type>DBJoin</type>
    <name>New executor ID</name>
    <connection>jobtology-postgres</connection>
    <sql>SELECT gen_random_uuid()::text AS owner_id</sql>
    <cache>N</cache>
    <cache_size>0</cache_size>
    <rowlimit>0</rowlimit>
    <outer_join>N</outer_join>
    <replace_vars>N</replace_vars>
    <parameter />
    <copies>1</copies>
    <distribute>Y</distribute>
    <GUI>
      <xloc>320</xloc>
      <yloc>80</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
  </transform>
  <transform>
    <type>SetVariable</type>
    <name>Remember RETENTION_OWNER_ID</name>
    <use_formatting>Y</use_formatting>
    <fields>
      <field>
        <field_name>owner_id</field_name>
        <variable_name>RETENTION_OWNER_ID</variable_name>
        <variable_type>PARENT_WORKFLOW</variable_type>
        <default_value />
      </field>
    </fields>
    <copies>1</copies>
    <distribute>Y</distribute>
    <GUI>
      <xloc>560</xloc>
      <yloc>80</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
  </transform>
  <transform>
    <type>ExecSql</type>
    <name>Recheck and acquire fence</name>
    <connection>jobtology-postgres</connection>
    <sql>SELECT retention.begin_execution(?,?,?)</sql>
    <execute_each_row>Y</execute_each_row>
    <single_statement>Y</single_statement>
    <set_params>Y</set_params>
    <replace_variables>N</replace_variables>
    <quoteString>N</quoteString>
    <arguments>
      <argument>
        <name>plan_id</name>
      </argument>
      <argument>
        <name>owner_id</name>
      </argument>
      <argument>
        <name>raw_base</name>
      </argument>
    </arguments>
    <copies>1</copies>
    <distribute>Y</distribute>
    <GUI>
      <xloc>800</xloc>
      <yloc>80</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
  </transform>
  <transform_error_handling />
  <attributes />
</pipeline>