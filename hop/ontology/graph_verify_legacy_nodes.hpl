<?xml version='1.0' encoding='UTF-8'?>
<pipeline>
  <info>
    <name>graph_verify_legacy_nodes</name>
    <description>Verify exact native node labels, typed property ownership and content proof.</description>
    <pipeline_type>Normal</pipeline_type>
    <size_rowset>100</size_rowset>
    <parameters />
  </info>
  <notepads />
  <order>
    <hop>
      <from>Load token</from>
      <to>Expected nodes</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Expected nodes</from>
      <to>Verify nodes</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Verify nodes</from>
      <to>Verify result</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Verify result</from>
      <to>Verified</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Verify result</from>
      <to>Graph mismatch</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <type>GetVariable</type>
    <name>Load token</name>
    <fields>
      <field>
        <name>load_token</name>
        <variable>${ONTOLOGY_LOAD_ID}</variable>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
      </field>
    </fields>
    <copies>1</copies>
    <distribute>Y</distribute>
    <GUI>
      <xloc>80</xloc>
      <yloc>80</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
  </transform>
  <transform>
    <type>TableInput</type>
    <name>Expected nodes</name>
    <connection>jobtology-postgres</connection>
    <sql>SELECT l.load_id,l.release_id,l.database_id,l.manifest_hash,l.source_manifest_hash,r.manifest-&gt;&gt;'data_as_of' AS data_as_of,projection.node_count AS expected_nodes,projection.edge_count AS expected_edges,(projection.manifest-&gt;&gt;'bindings')::bigint AS legacy_nodes,(projection.manifest-&gt;&gt;'legacy_edges')::bigint AS legacy_edges,n.node_id,n.content_hash,array_to_string(n.labels,'|') AS labels,(SELECT count(*) FROM jsonb_object_keys(n.properties))::bigint AS property_count,false AS managed,''::text AS flat_content_hash,''::text AS owned_keys FROM ontology.flat_graph_load l JOIN ontology.flat_graph_projection projection USING(release_id) JOIN ontology.corpus_release r USING(release_id) JOIN ontology.flat_graph_legacy_node n ON n.release_id=l.release_id WHERE l.load_id=? AND l.state IN ('RUNNING','STAGED') ORDER BY n.node_id</sql>
    <limit>0</limit>
    <lookup>Load token</lookup>
    <execute_each_row>Y</execute_each_row>
    <variables_active>N</variables_active>
    <copies>1</copies>
    <distribute>Y</distribute>
    <GUI>
      <xloc>320</xloc>
      <yloc>80</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
  </transform>
  <transform>
    <type>Neo4jCypherOutput</type>
    <name>Verify nodes</name>
    <connection>${NEO4J_CONNECTION}</connection>
    <cypher>CALL db.info() YIELD id AS actual_database_id
UNWIND $rows AS row
WITH row,actual_database_id WHERE row.database_id=actual_database_id
OPTIONAL MATCH (n:ontologyObject {id:row.node_id})
RETURN count(n)=size($rows) AND all(ok IN collect(coalesce(n.content_hash=row.content_hash AND
 size(keys(n))=row.property_count+CASE WHEN row.managed THEN 4 ELSE 2 END AND
 (NOT row.managed OR (n.flat_content_hash=row.flat_content_hash AND n.flat_owned_keys=CASE WHEN coalesce(row.owned_keys,'')='' THEN [] ELSE split(row.owned_keys,'|') END)) AND
 size(labels(n))=size(split(row.labels,'|'))+1 AND all(label IN split(row.labels,'|') WHERE label IN labels(n)),false)) WHERE ok) AS verified</cypher>
    <batch_size>500</batch_size>
    <read_only>Y</read_only>
    <retry>N</retry>
    <nr_retries_on_error>0</nr_retries_on_error>
    <cypher_from_field>N</cypher_from_field>
    <unwind>Y</unwind>
    <returning_graph>N</returning_graph>
    <mappings>
      <mapping>
        <parameter>database_id</parameter>
        <field>database_id</field>
        <type>String</type>
      </mapping>
      <mapping>
        <parameter>node_id</parameter>
        <field>node_id</field>
        <type>String</type>
      </mapping>
      <mapping>
        <parameter>content_hash</parameter>
        <field>content_hash</field>
        <type>String</type>
      </mapping>
      <mapping>
        <parameter>flat_content_hash</parameter>
        <field>flat_content_hash</field>
        <type>String</type>
      </mapping>
      <mapping>
        <parameter>labels</parameter>
        <field>labels</field>
        <type>String</type>
      </mapping>
      <mapping>
        <parameter>owned_keys</parameter>
        <field>owned_keys</field>
        <type>String</type>
      </mapping>
      <mapping>
        <parameter>property_count</parameter>
        <field>property_count</field>
        <type>Integer</type>
      </mapping>
      <mapping>
        <parameter>managed</parameter>
        <field>managed</field>
        <type>Boolean</type>
      </mapping>
    </mappings>
    <returns>
      <return>
        <name>verified</name>
        <type>Boolean</type>
        <source_type>Boolean</source_type>
      </return>
    </returns>
    <unwind_map>rows</unwind_map>
    <copies>1</copies>
    <distribute>Y</distribute>
    <GUI>
      <xloc>560</xloc>
      <yloc>80</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
  </transform>
  <transform>
    <type>FilterRows</type>
    <name>Verify result</name>
    <send_true_to>Verified</send_true_to>
    <send_false_to>Graph mismatch</send_false_to>
    <compare>
      <condition>
        <negated>N</negated>
        <operator>-</operator>
        <leftvalue>verified</leftvalue>
        <function>=</function>
        <value>
          <name>constant</name>
          <type>Boolean</type>
          <text>Y</text>
          <length>-1</length>
          <precision>-1</precision>
          <isnull>N</isnull>
        </value>
      </condition>
    </compare>
    <copies>1</copies>
    <distribute>Y</distribute>
    <GUI>
      <xloc>800</xloc>
      <yloc>80</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
  </transform>
  <transform>
    <type>Dummy</type>
    <name>Verified</name>
    <copies>1</copies>
    <distribute>Y</distribute>
    <GUI>
      <xloc>1040</xloc>
      <yloc>80</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
  </transform>
  <transform>
    <type>Abort</type>
    <name>Graph mismatch</name>
    <message>Flat ontology verification failed; PostgreSQL history is unchanged.</message>
    <always_log_rows>N</always_log_rows>
    <abort_option>ABORT_WITH_ERROR</abort_option>
    <row_threshold>0</row_threshold>
    <copies>1</copies>
    <distribute>Y</distribute>
    <GUI>
      <xloc>80</xloc>
      <yloc>240</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
  </transform>
  <transform_error_handling />
  <attributes />
</pipeline>