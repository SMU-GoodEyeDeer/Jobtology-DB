-- Run with psql as a privilege administrator after installing 019; never via Hop.
\set ON_ERROR_STOP on
BEGIN;
DO $$ BEGIN
 IF NOT EXISTS(SELECT 1 FROM pg_roles WHERE rolname='jobtology_catalog_reader') THEN
  CREATE ROLE jobtology_catalog_reader LOGIN NOINHERIT;
 END IF;
 IF has_schema_privilege('jobtology_catalog_reader','ontology','USAGE') THEN
  RAISE EXCEPTION 'CATALOG_READER_HAS_ONTOLOGY_ACCESS: remove inherited/PUBLIC ontology grants first';
 END IF;
END $$;
REVOKE ALL ON SCHEMA ontology FROM jobtology_catalog_reader;
REVOKE ALL ON ALL TABLES IN SCHEMA catalog FROM jobtology_catalog_reader;
REVOKE ALL ON ALL FUNCTIONS IN SCHEMA catalog FROM jobtology_catalog_reader;
GRANT USAGE ON SCHEMA catalog TO jobtology_catalog_reader;
GRANT EXECUTE ON FUNCTION catalog.catalog_context_v1(text),
 catalog.catalog_entities_v1(text,text,integer,integer),
 catalog.catalog_entity_v1(text,text),
 catalog.catalog_relations_v1(text,text,integer,integer),
  catalog.catalog_summary_v1(text),
  catalog.live_postings_v1(text,text,text,date,integer,integer),
  catalog.live_posting_v1(text),
  catalog.live_exam_sessions_v1(text,date,date,integer,integer) TO jobtology_catalog_reader;
DO $$ BEGIN
  IF has_schema_privilege('jobtology_catalog_reader','ontology','USAGE') OR
   EXISTS(SELECT 1 FROM pg_namespace WHERE nspname IN ('ingestion','cs')
    AND has_schema_privilege('jobtology_catalog_reader',oid,'USAGE')) OR
  has_function_privilege('jobtology_catalog_reader','catalog.approve_catalog_release(text,text,text,text)','EXECUTE') OR
  has_table_privilege('jobtology_catalog_reader','catalog.catalog_active_release','SELECT') THEN
  RAISE EXCEPTION 'CATALOG_READER_PRIVILEGE_LEAK';
 END IF;
END $$;
COMMIT;
