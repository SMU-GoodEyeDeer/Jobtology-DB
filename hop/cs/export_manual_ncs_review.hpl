<?xml version='1.0' encoding='UTF-8'?>
<pipeline>
  <info>
    <name>export_manual_ncs_review</name>
    <description>Freeze current accepted role/duty and complete NCS catalog definitions.</description>
    <pipeline_type>Normal</pipeline_type>
    <size_rowset>100</size_rowset>
    <parameters />
  </info>
  <notepads />
  <order>
    <hop>
      <from>Selection file and output</from>
      <to>Read exact role/duty/NCS selections</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Read exact role/duty/NCS selections</from>
      <to>Validate and prepare manual NCS review</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Validate and prepare manual NCS review</from>
      <to>Save manual NCS packet</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Save manual NCS packet</from>
      <to>Manual NCS packet written</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <type>GetVariable</type>
    <name>Selection file and output</name>
    <fields>
      <field>
        <name>selection_filename</name>
        <variable>${SELECTION_FILE}</variable>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
      </field>
      <field>
        <name>actor</name>
        <variable>${ACTOR}</variable>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
      </field>
      <field>
        <name>review_filename</name>
        <variable>${REVIEW_FILE}</variable>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
      </field>
    </fields>
    <copies>1</copies>
    <distribute>Y</distribute>
    <GUI>
      <xloc>80</xloc>
      <yloc>80</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
  </transform>
  <transform>
    <type>JsonInput</type>
    <name>Read exact role/duty/NCS selections</name>
    <IsInFields>Y</IsInFields>
    <IsAFile>Y</IsAFile>
    <valueField>selection_filename</valueField>
    <removeSourceField>N</removeSourceField>
    <ignoreMissingPath>N</ignoreMissingPath>
    <defaultPathLeafToNull>Y</defaultPathLeafToNull>
    <doNotFailIfNoFile>N</doNotFailIfNoFile>
    <fields>
      <field>
        <name>selection_json</name>
        <path>$</path>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
        <repeat>N</repeat>
      </field>
    </fields>
    <copies>1</copies>
    <distribute>Y</distribute>
    <GUI>
      <xloc>320</xloc>
      <yloc>80</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
  </transform>
  <transform>
    <type>DBJoin</type>
    <name>Validate and prepare manual NCS review</name>
    <connection>jobtology-postgres</connection>
    <sql>SELECT convert_to(jsonb_pretty(cs.prepare_manual_ncs_link_review_v1(?::jsonb-&gt;'selections',?)),'UTF8') AS review_bytes</sql>
    <cache>N</cache>
    <cache_size>0</cache_size>
    <rowlimit>0</rowlimit>
    <outer_join>N</outer_join>
    <replace_vars>N</replace_vars>
    <parameter>
      <field>
        <name>selection_json</name>
        <type>String</type>
      </field>
      <field>
        <name>actor</name>
        <type>String</type>
      </field>
    </parameter>
    <copies>1</copies>
    <distribute>Y</distribute>
    <GUI>
      <xloc>560</xloc>
      <yloc>80</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
  </transform>
  <transform>
    <type>BinaryFileOutput</type>
    <name>Save manual NCS packet</name>
    <binaryfield>review_bytes</binaryfield>
    <filenamefield>review_filename</filenamefield>
    <createparentfolder>Y</createparentfolder>
    <overwritefile>N</overwritefile>
    <addresultfilenames>N</addresultfilenames>
    <copies>1</copies>
    <distribute>Y</distribute>
    <GUI>
      <xloc>800</xloc>
      <yloc>80</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
  </transform>
  <transform>
    <type>WriteToLog</type>
    <name>Manual NCS packet written</name>
    <loglevel>Basic</loglevel>
    <displayHeader>Y</displayHeader>
    <logmessage>Review each full NCS definition against its explicit position-bound duty; fill named decisions.</logmessage>
    <fields>
      <field>
        <name>review_filename</name>
      </field>
    </fields>
    <copies>1</copies>
    <distribute>Y</distribute>
    <GUI>
      <xloc>1040</xloc>
      <yloc>80</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
  </transform>
  <transform_error_handling />
  <attributes />
</pipeline>