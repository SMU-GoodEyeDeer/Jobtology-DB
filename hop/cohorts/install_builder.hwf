<?xml version='1.0' encoding='UTF-8'?>
<workflow>
  <name>Install persisted cohort builder</name>
  <actions>
    <action>
      <name>Start</name>
      <type>SPECIAL</type>
      <start>Y</start>
      <repeat>N</repeat>
      <xloc>80</xloc>
      <yloc>80</yloc>
      <draw>Y</draw>
    </action>
    <action>
      <name>001_inputs</name>
      <type>SQL</type>
      <connection>jobtology-postgres</connection>
      <sql />
      <sqlfromfile>Y</sqlfromfile>
      <sqlfilename>${PROJECT_HOME}/cohorts/sql/cohort/001_inputs.sql</sqlfilename>
      <sqlfilename_encoding>UTF-8</sqlfilename_encoding>
      <useVariableSubstitution>N</useVariableSubstitution>
      <sendOneStatement>Y</sendOneStatement>
      <xloc>340</xloc>
      <yloc>80</yloc>
      <draw>Y</draw>
    </action>
    <action>
      <name>002_cohorts</name>
      <type>SQL</type>
      <connection>jobtology-postgres</connection>
      <sql />
      <sqlfromfile>Y</sqlfromfile>
      <sqlfilename>${PROJECT_HOME}/cohorts/sql/cohort/002_cohorts.sql</sqlfilename>
      <sqlfilename_encoding>UTF-8</sqlfilename_encoding>
      <useVariableSubstitution>N</useVariableSubstitution>
      <sendOneStatement>Y</sendOneStatement>
      <xloc>600</xloc>
      <yloc>80</yloc>
      <draw>Y</draw>
    </action>
    <action>
      <name>003_reads</name>
      <type>SQL</type>
      <connection>jobtology-postgres</connection>
      <sql />
      <sqlfromfile>Y</sqlfromfile>
      <sqlfilename>${PROJECT_HOME}/cohorts/sql/cohort/003_reads.sql</sqlfilename>
      <sqlfilename_encoding>UTF-8</sqlfilename_encoding>
      <useVariableSubstitution>N</useVariableSubstitution>
      <sendOneStatement>Y</sendOneStatement>
      <xloc>860</xloc>
      <yloc>80</yloc>
      <draw>Y</draw>
    </action>
    <action>
      <name>Success</name>
      <type>SUCCESS</type>
      <xloc>1120</xloc>
      <yloc>80</yloc>
      <draw>Y</draw>
    </action>
    <action>
      <name>Abort</name>
      <type>ABORT</type>
      <message>Cohort builder installation failed; inspect SQL log and prerequisite installers.</message>
      <xloc>1120</xloc>
      <yloc>260</yloc>
      <draw>Y</draw>
    </action>
  </actions>
  <hops>
    <hop>
      <from>Start</from>
      <to>001_inputs</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>Y</unconditional>
    </hop>
    <hop>
      <from>001_inputs</from>
      <to>Abort</to>
      <enabled>Y</enabled>
      <evaluation>N</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>001_inputs</from>
      <to>002_cohorts</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>002_cohorts</from>
      <to>Abort</to>
      <enabled>Y</enabled>
      <evaluation>N</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>002_cohorts</from>
      <to>003_reads</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>003_reads</from>
      <to>Abort</to>
      <enabled>Y</enabled>
      <evaluation>N</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>003_reads</from>
      <to>Success</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
  </hops>
</workflow>