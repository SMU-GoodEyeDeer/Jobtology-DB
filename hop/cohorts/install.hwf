<?xml version='1.0' encoding='UTF-8'?>
<workflow>
  <name>Install cohort preparation ledger</name>
  <actions>
    <action>
      <name>Start</name>
      <type>SPECIAL</type>
      <start>Y</start>
      <repeat>N</repeat>
      <xloc>80</xloc>
      <yloc>80</yloc>
      <draw>Y</draw>
    </action>
    <action>
      <name>001_duplicate_contract</name>
      <type>SQL</type>
      <connection>jobtology-postgres</connection>
      <sql />
      <sqlfromfile>Y</sqlfromfile>
      <sqlfilename>${PROJECT_HOME}/cohorts/sql/001_duplicate_contract.sql</sqlfilename>
      <sqlfilename_encoding>UTF-8</sqlfilename_encoding>
      <useVariableSubstitution>N</useVariableSubstitution>
      <sendOneStatement>Y</sendOneStatement>
      <xloc>340</xloc>
      <yloc>80</yloc>
      <draw>Y</draw>
    </action>
    <action>
      <name>002_duplicates</name>
      <type>SQL</type>
      <connection>jobtology-postgres</connection>
      <sql />
      <sqlfromfile>Y</sqlfromfile>
      <sqlfilename>${PROJECT_HOME}/cohorts/sql/002_duplicates.sql</sqlfilename>
      <sqlfilename_encoding>UTF-8</sqlfilename_encoding>
      <useVariableSubstitution>N</useVariableSubstitution>
      <sendOneStatement>Y</sendOneStatement>
      <xloc>600</xloc>
      <yloc>80</yloc>
      <draw>Y</draw>
    </action>
    <action>
      <name>003_profile_contract</name>
      <type>SQL</type>
      <connection>jobtology-postgres</connection>
      <sql />
      <sqlfromfile>Y</sqlfromfile>
      <sqlfilename>${PROJECT_HOME}/cohorts/sql/003_profile_contract.sql</sqlfilename>
      <sqlfilename_encoding>UTF-8</sqlfilename_encoding>
      <useVariableSubstitution>N</useVariableSubstitution>
      <sendOneStatement>Y</sendOneStatement>
      <xloc>860</xloc>
      <yloc>80</yloc>
      <draw>Y</draw>
    </action>
    <action>
      <name>004_profiles</name>
      <type>SQL</type>
      <connection>jobtology-postgres</connection>
      <sql />
      <sqlfromfile>Y</sqlfromfile>
      <sqlfilename>${PROJECT_HOME}/cohorts/sql/004_profiles.sql</sqlfilename>
      <sqlfilename_encoding>UTF-8</sqlfilename_encoding>
      <useVariableSubstitution>N</useVariableSubstitution>
      <sendOneStatement>Y</sendOneStatement>
      <xloc>1120</xloc>
      <yloc>80</yloc>
      <draw>Y</draw>
    </action>
    <action>
      <name>005_profile_reads</name>
      <type>SQL</type>
      <connection>jobtology-postgres</connection>
      <sql />
      <sqlfromfile>Y</sqlfromfile>
      <sqlfilename>${PROJECT_HOME}/cohorts/sql/005_profile_reads.sql</sqlfilename>
      <sqlfilename_encoding>UTF-8</sqlfilename_encoding>
      <useVariableSubstitution>N</useVariableSubstitution>
      <sendOneStatement>Y</sendOneStatement>
      <xloc>80</xloc>
      <yloc>260</yloc>
      <draw>Y</draw>
    </action>
    <action>
      <name>Success</name>
      <type>SUCCESS</type>
      <xloc>80</xloc>
      <yloc>440</yloc>
      <draw>Y</draw>
    </action>
    <action>
      <name>Abort</name>
      <type>ABORT</type>
      <message>Cohort preparation installation failed; inspect SQL action log.</message>
      <xloc>1120</xloc>
      <yloc>440</yloc>
      <draw>Y</draw>
    </action>
  </actions>
  <hops>
    <hop>
      <from>Start</from>
      <to>001_duplicate_contract</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>Y</unconditional>
    </hop>
    <hop>
      <from>001_duplicate_contract</from>
      <to>Abort</to>
      <enabled>Y</enabled>
      <evaluation>N</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>001_duplicate_contract</from>
      <to>002_duplicates</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>002_duplicates</from>
      <to>Abort</to>
      <enabled>Y</enabled>
      <evaluation>N</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>002_duplicates</from>
      <to>003_profile_contract</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>003_profile_contract</from>
      <to>Abort</to>
      <enabled>Y</enabled>
      <evaluation>N</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>003_profile_contract</from>
      <to>004_profiles</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>004_profiles</from>
      <to>Abort</to>
      <enabled>Y</enabled>
      <evaluation>N</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>004_profiles</from>
      <to>005_profile_reads</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>005_profile_reads</from>
      <to>Abort</to>
      <enabled>Y</enabled>
      <evaluation>N</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>005_profile_reads</from>
      <to>Success</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
  </hops>
</workflow>