<?xml version='1.0' encoding='UTF-8'?>
<pipeline>
  <info>
    <name>build_cohort</name>
    <description>Persist one deterministic cohort and its normalized track/claim support.</description>
    <pipeline_type>Normal</pipeline_type>
    <size_rowset>100</size_rowset>
    <parameters>
      <parameter>
        <name>RELEASE_ID</name>
        <default_value />
        <description>RELEASE_ID</description>
      </parameter>
      <parameter>
        <name>OCCUPATION_ID</name>
        <default_value />
        <description>OCCUPATION_ID</description>
      </parameter>
      <parameter>
        <name>AS_OF</name>
        <default_value />
        <description>AS_OF</description>
      </parameter>
    </parameters>
  </info>
  <notepads />
  <order>
    <hop>
      <from>Cohort choices</from>
      <to>Build persisted cohort</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Build persisted cohort</from>
      <to>Cohort stored</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <type>GetVariable</type>
    <name>Cohort choices</name>
    <fields>
      <field>
        <name>release_id</name>
        <variable>${RELEASE_ID}</variable>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
      </field>
      <field>
        <name>occupation_id</name>
        <variable>${OCCUPATION_ID}</variable>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
      </field>
      <field>
        <name>as_of</name>
        <variable>${AS_OF}</variable>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
      </field>
    </fields>
    <copies>1</copies>
    <distribute>Y</distribute>
    <GUI>
      <xloc>80</xloc>
      <yloc>80</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
  </transform>
  <transform>
    <type>DBJoin</type>
    <name>Build persisted cohort</name>
    <connection>jobtology-postgres</connection>
    <sql>SELECT ontology.build_posting_cohort_v1(?::text,?::text,nullif(?::text,'')::date) AS cohort_id</sql>
    <cache>N</cache>
    <cache_size>0</cache_size>
    <rowlimit>0</rowlimit>
    <outer_join>N</outer_join>
    <replace_vars>N</replace_vars>
    <parameter>
      <field>
        <name>release_id</name>
        <type>String</type>
      </field>
      <field>
        <name>occupation_id</name>
        <type>String</type>
      </field>
      <field>
        <name>as_of</name>
        <type>String</type>
      </field>
    </parameter>
    <copies>1</copies>
    <distribute>Y</distribute>
    <GUI>
      <xloc>320</xloc>
      <yloc>80</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
  </transform>
  <transform>
    <type>WriteToLog</type>
    <name>Cohort stored</name>
    <loglevel>Basic</loglevel>
    <displayHeader>Y</displayHeader>
    <logmessage>Selection is persisted. Demand statistics and publication remain separate.</logmessage>
    <fields>
      <field>
        <name>cohort_id</name>
      </field>
    </fields>
    <copies>1</copies>
    <distribute>Y</distribute>
    <GUI>
      <xloc>560</xloc>
      <yloc>80</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
  </transform>
  <transform_error_handling />
  <attributes />
</pipeline>