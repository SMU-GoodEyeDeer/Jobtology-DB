# PostgreSQL metadata/ledger. For the included local container, keep the host loopback-only.
JOBTOLOGY_PIPELINE_DATABASE_URL=postgresql+psycopg://jobtology_pipeline:jobtology_dev_only@127.0.0.1:55432/jobtology_pipeline

# Use /home/maxjo/jobtology-data on the server; ./data is convenient for local development.
JOBTOLOGY_RAW_ROOT=./data
JOBTOLOGY_CONTACT_EMAIL=
JOBTOLOGY_HTTP_USER_AGENT=Jobtology/0.1 (set JOBTOLOGY_CONTACT_EMAIL)
JOBTOLOGY_HTTP_CONNECT_TIMEOUT_SECONDS=10
JOBTOLOGY_HTTP_READ_TIMEOUT_SECONDS=60
JOBTOLOGY_HTTP_MAX_ATTEMPTS=4
JOBTOLOGY_HTTP_MAX_RETRY_AFTER_SECONDS=60
JOBTOLOGY_HTTP_MAX_RESPONSE_BYTES=67108864
# Local-dev reserve. Goldship production must set 107374182400 (100 GiB).
JOBTOLOGY_RAW_MIN_FREE_BYTES=1073741824
JOBTOLOGY_RAW_MAX_USED_FRACTION=0.85
# Version-controlled, fail-closed source permission decisions.
JOBTOLOGY_SOURCE_RIGHTS_FILE=./config/source_rights.yaml

# Apply the same data.go.kr project/personal key to all five API IDs documented below.
# Paste the decoded/raw key; the client URL-encodes it once.
DATA_GO_KR_SERVICE_KEY=

SARAMIN_ACCESS_KEY=
SARAMIN_KEYWORDS=AI 엔지니어,백엔드 개발자,프론트엔드 개발자,데이터 분석가

WORK24_AUTH_KEY=
# Omit these two variables to use today through one year from today on every invocation.
# WORK24_START_DATE=YYYYMMDD
# WORK24_END_DATE=YYYYMMDD
WORK24_NCS1=20
WORK24_COURSE_TYPES=C0104,C0105,C0061

# Omit to use the current and following calendar years.
# QNET_YEARS=2026,2027
QNET_ITEM_CODES_FILE=./config/qnet_item_codes.txt
NCS_QUALIFICATION_CODES_FILE=./config/ncs_qualification_codes.txt

# Public, non-secret direct URL for the portal's current one-time 2023-11-28 artifact.
NCS_CAREER_PATH_DOWNLOAD_URL=https://www.data.go.kr/cmm/cmm/fileDownload.do?atchFileId=FILE_000000002844861&fileDetailSn=1&insertDataPrcus=N

# Fetch only currently active JOB-ALIO postings; this is the complete serving snapshot for the MVP.
JOB_ALIO_ONGOING_ONLY=true
